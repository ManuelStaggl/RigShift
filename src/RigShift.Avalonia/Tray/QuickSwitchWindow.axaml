<Window
  x:Class="RigShift.Avalonia.Tray.QuickSwitchWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:QuickSwitchViewModel"
  Title="RigShift"
  Width="460"
  SizeToContent="Height"
  WindowDecorations="None"
  ShowInTaskbar="False"
  Topmost="True"
  CanResize="False"
  WindowStartupLocation="CenterScreen"
  Opacity="0"
  Background="Transparent"
  TransparencyLevelHint="AcrylicBlur, Blur, None">
  <!-- The quick switcher on its hotkey: type to filter, arrows and Enter to run, Esc or a click elsewhere to close. -->
  <Border Padding="8" Background="{DynamicResource RsPop}" BorderBrush="{DynamicResource RsOutline}" BorderThickness="1" CornerRadius="{DynamicResource RsRadiusLg}">
    <StackPanel Spacing="8">
      <TextBox x:Name="Search" AutomationProperties.Name="{v:Tr QuickSwitch_Search}" PlaceholderText="{v:Tr QuickSwitch_Search}" Text="{Binding Query}" />
      <ListBox
        x:Name="List"
        Classes="master"
        MaxHeight="360"
        AutomationProperties.Name="{v:Tr Settings_QuickSwitchHotkey}"
        IsVisible="{Binding !IsEmpty}"
        ItemsSource="{Binding Items}"
        SelectedItem="{Binding Selected}"
        Tapped="OnTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickSwitchItem">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center" Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="caption" Text="{Binding Kind}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Margin="8,4" Classes="secondary" IsVisible="{Binding IsEmpty}" Text="{v:Tr QuickSwitch_Empty}" />
    </StackPanel>
  </Border>
</Window>

<UserControl
  x:Class="RigShift.Avalonia.Views.SwitchStepsView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fa="using:FluentAvalonia.UI.Controls"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels">
  <!-- The steps of the running switch: waiting, running, done or failed with its reason. Bound to the coordinator's list. -->
  <ItemsControl x:Name="List">
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:SwitchStepRow">
        <Grid Margin="0,2" ColumnDefinitions="16,*" ColumnSpacing="8" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Text}">
          <Panel Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
            <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource RsText3}" IsVisible="{Binding IsWaiting}" />
            <fa:FAProgressRing Width="14" Height="14" IsIndeterminate="True" Foreground="{DynamicResource RsAccentText}" IsVisible="{Binding IsRunning}" />
            <Path Classes="icon ok" Data="{x:Static v:Icons.Checkmark16}" IsVisible="{Binding IsDone}" />
            <Path Classes="icon error" Data="{x:Static v:Icons.Dismiss16}" IsVisible="{Binding IsFailed}" />
          </Panel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes.secondary="{Binding IsWaiting}" Text="{Binding Label}" TextWrapping="Wrap" />
            <TextBlock Classes="caption danger" IsVisible="{Binding HasReason}" Text="{Binding Reason}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>

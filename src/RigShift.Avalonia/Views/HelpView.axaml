<UserControl
  x:Class="RigShift.Avalonia.Views.HelpView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  xmlns:up="using:RigShift.Core.Updates"
  x:DataType="vm:AboutViewModel">
  <UserControl.Styles>
    <!-- The four help cards: the group tile and title, a line of text, the actions at the foot. -->
    <Style Selector="Border.sheet.help">
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.sheet.help TextBlock.subtitle">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="page" Spacing="24">
      <TextBlock Classes="display" Text="{v:Tr Nav_About}" />

      <!-- Head: the mark, the version, the update state and the one update action; what is new under it. -->
      <Border Classes="well">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <!-- The brand mark from the brand package, in the colours for the theme behind it. -->
            <Border Width="56" Height="56" Background="{DynamicResource RsCard}" BoxShadow="{DynamicResource RsCardShadow}" CornerRadius="{DynamicResource RsRadiusLg}">
              <Panel Width="40" Height="40">
                <Image x:Name="MarkDark" Source="/Assets/Brand/rigshift-symbol-color-dark-128w.png" />
                <Image x:Name="MarkLight" Source="/Assets/Brand/rigshift-symbol-color-light-128w.png" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="title" Text="{Binding VersionText}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse
                  Classes="status"
                  Classes.ok="{Binding UpdateStatusKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Ok}"
                  Classes.warn="{Binding UpdateStatusKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Warn}"
                  Classes.error="{Binding UpdateStatusKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Error}"
                  Classes.accent="{Binding UpdateStatusKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Accent}" />
                <TextBlock AutomationProperties.LiveSetting="Polite" Classes="caption" Text="{Binding UpdateStatusText}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <Panel Grid.Column="2" VerticalAlignment="Center">
              <Button Classes="primary" Command="{Binding InstallUpdateNowCommand}" Content="{v:Tr Settings_RestartToUpdate}" IsVisible="{Binding IsUpdateInstallable}" />
              <Button Classes="neutral" Command="{Binding CheckForUpdatesCommand}" Content="{v:Tr Settings_CheckUpdates}" IsVisible="{Binding !IsUpdateInstallable}" />
            </Panel>
          </Grid>

          <!-- Height-limited: a full changelog section would make the head huge. -->
          <StackPanel Margin="72,0,0,0" Spacing="4" IsVisible="{Binding ShowReleaseNotes}">
            <TextBlock Classes="section" Text="{v:Tr About_WhatsNew}" />
            <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ReleaseNoteLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="up:ReleaseNoteLine">
                    <TextBlock Margin="0,4,0,0" Classes="caption" Classes.heading="{Binding IsHeading}" Text="{Binding Text}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Classes="link" Command="{Binding OpenReleaseNotesCommand}" Content="{v:Tr Settings_ReleaseNotesLink}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Four cards, two columns from 1000 px, each as tall as its own content: getting going on the left, the tools on the right. -->
      <UniformGrid Classes="cols">
        <StackPanel Spacing="24">
          <!-- First steps -->
          <Border Classes="sheet help">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
                <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.Play20}" /></Border>
                <TextBlock Classes="subtitle" Text="{v:Tr About_StartTitle}" />
              </StackPanel>
              <StackPanel Margin="0,16,0,0" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="16">
                <Button Classes="neutral" Command="{Binding StartAssistantCommand}" Content="{v:Tr Overview_SetupStart}" />
                <Button VerticalAlignment="Center" Classes="link" Command="{Binding OpenGuideCommand}" Content="{v:Tr About_Guide}" />
              </StackPanel>
              <TextBlock Margin="0,12,0,0" Classes="note" Text="{v:Tr About_StartText}" />
            </DockPanel>
          </Border>

          <!-- Backup -->
          <Border Classes="sheet help">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
                <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.Archive20}" /></Border>
                <TextBlock Classes="subtitle" Text="{v:Tr About_Backup}" />
              </StackPanel>
              <StackPanel Margin="0,16,0,0" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8">
                <Button Classes="neutral" Command="{Binding SaveBackupCommand}" Content="{v:Tr About_SaveBackup}" />
                <Button Classes="neutral" Command="{Binding RestoreBackupCommand}" Content="{v:Tr About_RestoreBackup}" />
              </StackPanel>
              <StackPanel Margin="0,12,0,0" Spacing="8">
                <TextBlock Classes="note" Text="{v:Tr About_BackupHint}" />
                <TextBlock AutomationProperties.LiveSetting="Polite" Classes="caption" IsVisible="{Binding BackupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding BackupStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        <StackPanel Spacing="24">
          <!-- Hotkeys and commands: the user's own, live. -->
          <Border Classes="sheet help">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.Keyboard20}" /></Border>
                <TextBlock Classes="subtitle" Text="{v:Tr About_Shortcuts}" />
              </StackPanel>
              <TextBlock Margin="0,12,0,0" Classes="note" IsVisible="{Binding !HasShortcuts}" Text="{v:Tr About_NoShortcuts}" />
              <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Shortcuts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutRow">
                    <Grid MinHeight="32" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock VerticalAlignment="Center" Classes="secondary" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1" VerticalAlignment="Center" Classes="kbd"><TextBlock Text="{Binding Keys}" /></Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Margin="0,16,0,8" Classes="caption" Text="{v:Tr About_Commands}" />
              <Border Padding="12,0,0,0" Background="{DynamicResource RsBay}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="1" CornerRadius="{DynamicResource RsRadiusMd}">
                <ItemsControl ItemsSource="{Binding CommandExamples}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Grid MinHeight="32" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" AutomationProperties.Name="{v:Tr About_Copy}" Classes="ghost" Command="{Binding $parent[v:HelpView].ViewModel.CopyCommandCommand}" CommandParameter="{Binding}" ToolTip.Tip="{v:Tr About_Copy}">
                          <Path Classes="icon" Data="{x:Static v:Icons.Copy16}" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </Border>

          <!-- Report a problem: the support package, diagnostics, the issue, the folders. -->
          <Border Classes="sheet help">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
                <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.Flag20}" /></Border>
                <TextBlock Classes="subtitle" Text="{v:Tr About_ReportProblem}" />
              </StackPanel>
              <StackPanel Margin="0,16,0,0" DockPanel.Dock="Bottom" Spacing="12">
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <Button Classes="primary" Command="{Binding SaveSupportPackageCommand}" Content="{v:Tr About_SupportPackage}" ToolTip.Tip="{v:Tr About_SupportHint}" />
                  <Button Classes="neutral" Command="{Binding CopyDiagnosticsCommand}" Content="{v:Tr About_CopyDiagnostics}" ToolTip.Tip="{v:Tr About_CopyHint}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Button AutomationProperties.Name="{v:Tr About_ReportProblem}" Classes="link" Command="{Binding ReportProblemCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock VerticalAlignment="Center" Text="{v:Tr About_ReportProblem}" />
                      <Path Classes="icon" Data="{x:Static v:Icons.Open16}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="link" Command="{Binding OpenLogFolderCommand}" Content="{v:Tr About_Logs}" />
                  <Button Classes="link" Command="{Binding OpenProfileFolderCommand}" Content="{v:Tr About_Profiles}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,12,0,0" Spacing="8">
                <TextBlock Classes="note" Text="{v:Tr About_ProblemText}" ToolTip.Tip="{v:Tr About_ProblemTextTip}" />
                <TextBlock AutomationProperties.LiveSetting="Polite" Classes="caption" IsVisible="{Binding CopyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Text="{Binding CopyStatus}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
      </UniformGrid>

      <!-- Quiet footer: license and links. -->
      <WrapPanel Margin="4,0,0,0" ItemSpacing="16" LineSpacing="8">
        <TextBlock VerticalAlignment="Center" Classes="caption" Text="{v:Tr About_Copyright}" />
        <Button Classes="link" Command="{Binding OpenRepositoryCommand}" Content="{v:Tr About_Repository}" />
        <Button Classes="link" Command="{Binding OpenLicenseCommand}" Content="{v:Tr About_License}" />
        <Button Classes="link" Command="{Binding OpenThirdPartyNoticesCommand}" Content="{v:Tr About_ThirdParty}" />
        <Button Classes="link" Command="{Binding OpenPrivacyCommand}" Content="{v:Tr About_Privacy}" ToolTip.Tip="{v:Tr About_PrivacyHint}" />
        <Button Classes="link" Command="{Binding OpenKofiCommand}" Content="{v:Tr About_Kofi}" ToolTip.Tip="{v:Tr About_KofiHint}" />
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

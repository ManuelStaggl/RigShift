<UserControl
  x:Class="RigShift.Avalonia.Views.OverviewView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:OverviewViewModel">
  <UserControl.Styles>
    <!-- A switch position: every one the same card in the recessed housing; the active one carries the accent ring. -->
    <Style Selector="Button.position">
      <Setter Property="Background" Value="{DynamicResource RsCard}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RsDivider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RsRadiusMd}" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.position:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RsRaisedHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RsOutline}" />
    </Style>
    <Style Selector="Button.position:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RsRaisedPressed}" />
    </Style>
    <Style Selector="Button.position.active /template/ ContentPresenter#PART_ContentPresenter, Button.position.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource RsAccentText}" />
    </Style>

    <Style Selector="Border.gamerow">
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="{DynamicResource RsRadiusMd}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.gamerow:pointerover">
      <Setter Property="Background" Value="{DynamicResource RsHover}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,44">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Classes="page">
        <TextBlock Classes="display" Text="{v:Tr Nav_Overview}" />
        <TextBlock Classes="lead" Text="{v:Tr Overview_Lead}" />

        <Border Margin="0,0,0,16" Classes="notice danger" IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Stage: the layout Windows shows right now, also before the first profile -->
        <Border Margin="0,0,0,32" Classes="well">
          <Grid RowDefinitions="Auto,200">
            <Grid x:Name="NowLine" ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="status ok" />
                  <TextBlock Classes="caption" Text="{v:Tr Overview_Now}" />
                </StackPanel>
                <TextBlock x:Name="NowText" Margin="0,4,0,0" Classes="title" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NowMeta" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                <Button Classes="neutral" AutomationProperties.Name="{v:Tr Displays_Identify}" Command="{Binding IdentifyCommand}" ToolTip.Tip="{v:Tr Displays_IdentifyTip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{x:Static v:Icons.ScanDash16}" />
                    <TextBlock Text="{v:Tr Displays_Identify}" />
                  </StackPanel>
                </Button>
                <Button x:Name="ReapplyButton" Classes="neutral" AutomationProperties.Name="{v:Tr Profile_Reapply}" Click="OnReapply">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{x:Static v:Icons.ArrowCounterclockwise16}" />
                    <TextBlock Text="{v:Tr Profile_Reapply}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="SwitchingLine" Spacing="8" IsVisible="False">
              <ProgressBar IsIndeterminate="True" />
              <TextBlock x:Name="SwitchingText" Classes="strong" />
            </StackPanel>
            <v:DisplayTopology Grid.Row="1" Margin="40,16,40,0" Displays="{Binding LiveTopology}" Size="Card" />
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="secondary" IsVisible="{Binding IsEmpty}" Text="{v:Tr Overview_Empty}" />
          </Grid>
        </Border>

        <!-- No profile yet: the setup assistant, the layout on the stage as the first profile, or the profiles page. -->
        <Border
          x:Name="EmptyState"
          MaxWidth="420"
          Padding="24"
          HorizontalAlignment="Left"
          Background="{DynamicResource RsCard}"
          BorderBrush="{DynamicResource RsOutline}"
          BorderThickness="1"
          CornerRadius="{DynamicResource RsRadiusLg}"
          IsVisible="False">
          <StackPanel Spacing="12">
            <Path HorizontalAlignment="Left" Classes="icon lg" Data="{x:Static v:Icons.Desktop24}" />
            <TextBlock Classes="subtitle" Text="{v:Tr Overview_SetupTitle}" />
            <TextBlock Classes="secondary" Text="{v:Tr Overview_SetupText}" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="primary" Command="{Binding SetupAssistantCommand}" Content="{v:Tr Overview_SetupStart}" />
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="neutral" Command="{Binding SaveCurrentCommand}" Content="{v:Tr Overview_SaveCurrent}" />
            <Button HorizontalAlignment="Center" Classes="link" Command="{Binding SetupManuallyCommand}" Content="{v:Tr Overview_SetupManual}" />
          </StackPanel>
        </Border>

        <StackPanel IsVisible="{Binding HasProfiles}">
          <!-- The switch: one recessed housing, one position per profile. -->
          <Grid Margin="4,0,0,8" ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{v:Tr Overview_Positions}" />
            <Button Grid.Column="1" Classes="ghost" Padding="8,4" AutomationProperties.Name="{v:Tr Overview_SaveCurrent}" Command="{Binding SaveCurrentCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Classes="icon" Data="{x:Static v:Icons.Add16}" />
                <TextBlock FontWeight="SemiBold" Text="{v:Tr Overview_SaveCurrent}" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="well" Padding="4">
            <ItemsControl IsEnabled="{Binding Coordinator.IsIdle}" ItemsSource="{Binding Catalog.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Classes="cols3" ColumnSpacing="4" RowSpacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItem">
                  <Button
                    AutomationProperties.Name="{Binding AccessibleName}"
                    Classes="position"
                    Classes.active="{Binding IsActive}"
                    Click="OnSwitch"
                    Tag="{Binding}">
                    <Grid RowDefinitions="Auto,120,Auto" RowSpacing="12">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="subtitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsActive}">
                          <Path Classes="icon accent" Data="{x:Static v:Icons.Checkmark16}" />
                          <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{DynamicResource RsAccentText}" Text="{v:Tr Profile_Active}" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="kbd" IsVisible="{Binding ShowsHotkeyLine}">
                          <TextBlock Text="{Binding HotkeyText}" />
                        </Border>
                        <TextBlock Grid.Column="1" Classes="caption warning" IsVisible="{Binding ShowsReadiness}" Text="{Binding ReadyText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ReadyTip}" />
                      </Grid>
                      <v:DisplayTopology Grid.Row="1" Displays="{Binding Topology}" Size="Card" />
                      <TextBlock Grid.Row="2" Classes="caption" Text="{Binding AppsLine, TargetNullValue=''}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- Games: rows, Play on the right -->
        <StackPanel Margin="0,32,0,0" IsVisible="{Binding Games.HasGames}">
          <Grid Margin="4,0,0,8" ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="{v:Tr Nav_Games}" />
            <Button Grid.Column="1" Classes="ghost" Padding="8,4" AutomationProperties.Name="{v:Tr Overview_AllGames}" Click="OnAllGames">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{v:Tr Overview_AllGames}" />
                <Path Classes="icon" Data="{x:Static v:Icons.ChevronRight16}" />
              </StackPanel>
            </Button>
          </Grid>
          <ItemsControl IsEnabled="{Binding Coordinator.IsIdle}" ItemsSource="{Binding Games.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Border Classes="gamerow">
                  <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="16">
                    <Border Width="64" Height="36" Background="{DynamicResource RsRaised}" ClipToBounds="True" CornerRadius="{DynamicResource RsRadiusSm}">
                      <Panel>
                        <Path HorizontalAlignment="Center" Classes="icon md" IsVisible="{Binding !HasGameIcon}" Data="{Binding IconKey, Converter={x:Static v:Converters.ProfileSymbol}, ConverterParameter=20}" />
                        <Image Width="24" Height="24" IsVisible="{Binding HasGameIcon}" Source="{Binding GameIcon, Converter={x:Static v:Converters.IconImage}}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="caption" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                      <Border Classes="kbd" IsVisible="{Binding ShowsHotkey}">
                        <TextBlock Text="{Binding HotkeyText}" />
                      </Border>
                      <Button AutomationProperties.Name="{Binding PlayText}" Classes="neutral" Click="OnPlay" IsEnabled="{Binding CanPlay}" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Path Classes="icon" Data="{x:Static v:Icons.Play16}" />
                          <TextBlock Text="{v:Tr Game_Play}" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- Action bar: the active profile, the switch to the other one, the palette -->
    <Border Grid.Row="1" Padding="12,0,8,0" Background="{DynamicResource RsColumn}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,1,0,0" IsVisible="{Binding HasProfiles}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
          <Border Width="28" Height="28" Background="{DynamicResource RsAccentSoft}" CornerRadius="{DynamicResource RsRadiusSm}">
            <Path x:Name="BarIcon" HorizontalAlignment="Center" Classes="icon md accent" />
          </Border>
          <TextBlock x:Name="BarName" VerticalAlignment="Center" Classes="strong" />
          <TextBlock VerticalAlignment="Center" Classes="caption" Text="{v:Tr Profile_Active}" />
        </StackPanel>
        <Button x:Name="BarSwitch" Grid.Column="1" VerticalAlignment="Center" Classes="ab" Click="OnSwitch">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="BarSwitchText" VerticalAlignment="Center" />
            <Border Classes="kbd"><Path Classes="icon" Data="{x:Static v:Icons.ArrowEnter16}" /></Border>
          </StackPanel>
        </Button>
        <Border Grid.Column="2" Width="1" Height="16" Background="{DynamicResource RsOutline}" />
        <Button Grid.Column="3" VerticalAlignment="Center" Classes="ab" AutomationProperties.Name="{v:Tr Overview_ActionsName}" Click="OnActions">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" FontWeight="Regular" Foreground="{DynamicResource RsText3}" Text="{v:Tr Overview_Actions}" />
            <Border Classes="kbd"><TextBlock Text="{v:Tr Palette_Shortcut}" /></Border>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>

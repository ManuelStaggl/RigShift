<UserControl
  x:Class="RigShift.Avalonia.Views.SettingsView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <!-- Long hints wrap to two lines: keep them off the dividers. -->
    <Style Selector="Grid.row > StackPanel">
      <Setter Property="Margin" Value="0,8" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="page" Spacing="24">
      <TextBlock Classes="display" Text="{v:Tr Nav_Settings}" />

      <Border Margin="0,-12,0,0" Classes="notice danger" IsVisible="{Binding Devices.HasError}">
        <TextBlock Text="{Binding Devices.ErrorMessage}" TextWrapping="Wrap" />
      </Border>
      <Border Margin="0,-12,0,0" Classes="notice danger" IsVisible="{Binding HasError}">
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>

      <!-- Two columns from 1000 px: switching on the left, the app and the devices on the right. -->
      <UniformGrid Classes="cols">
        <StackPanel Spacing="24">
          <!-- ===== Switching ===== -->
          <StackPanel Spacing="12">
            <StackPanel Margin="4,0,0,0" Orientation="Horizontal" Spacing="12">
              <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.ArrowSwap20}" /></Border>
              <TextBlock Classes="section" Text="{v:Tr Settings_GroupSwitching}" />
            </StackPanel>
            <Border Classes="sheet">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_SignInTip}">
                  <TextBlock VerticalAlignment="Center" Classes="label" Text="{v:Tr Settings_SignIn}" />
                  <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.HelpText="{v:Tr Settings_SignInTip}" AutomationProperties.Name="{v:Tr Settings_SignIn}" IsEnabled="{Binding StartWithWindows}" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding SelectedSignInProfile, Converter={x:Static v:Converters.KeepOnNull}}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="{v:Tr Settings_ToggleHotkey}" />
                    <TextBlock Classes="caption" Text="{Binding ToggleHotkeyHint}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <v:HotkeyBox Width="200" AutomationProperties.HelpText="{v:Tr Hotkey_RecordTip}" AutomationProperties.Name="{v:Tr Settings_ToggleHotkey}" Field="{Binding}" PlaceholderText="{v:Tr Editor_HotkeyPlaceholder}" Text="{Binding ToggleHotkeyText, Mode=OneWay}" ToolTip.Tip="{v:Tr Hotkey_RecordTip}" />
                    <Button AutomationProperties.Name="{v:Tr Editor_HotkeyClear}" Classes="ghost" Command="{Binding ClearHotkeyCommand}" IsVisible="{Binding HasToggleHotkey}" ToolTip.Tip="{v:Tr Editor_HotkeyClear}">
                      <Path Classes="icon" Data="{x:Static v:Icons.Dismiss16}" />
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_QuickSwitchHotkeyTip}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="{v:Tr Settings_QuickSwitchHotkey}" />
                    <TextBlock Classes="caption" Text="{Binding QuickSwitch.Hint}" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                    <v:HotkeyBox Width="200" AutomationProperties.HelpText="{v:Tr Hotkey_RecordTip}" AutomationProperties.Name="{v:Tr Settings_QuickSwitchHotkey}" Field="{Binding QuickSwitch}" PlaceholderText="{v:Tr Editor_HotkeyPlaceholder}" Text="{Binding QuickSwitch.Text, Mode=OneWay}" ToolTip.Tip="{v:Tr Hotkey_RecordTip}" />
                    <Button AutomationProperties.Name="{v:Tr Editor_HotkeyClear}" Classes="ghost" Command="{Binding QuickSwitch.ClearHotkeyCommand}" IsVisible="{Binding QuickSwitch.HasHotkey}" ToolTip.Tip="{v:Tr Editor_HotkeyClear}">
                      <Path Classes="icon" Data="{x:Static v:Icons.Dismiss16}" />
                    </Button>
                  </StackPanel>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_AllOnHotkeyTip}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="{v:Tr Settings_AllOnHotkey}" />
                    <TextBlock Classes="caption" Text="{v:Tr Settings_AllOnHotkeyHint}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="kbd" AutomationProperties.HelpText="{v:Tr Settings_AllOnHotkeyTip}" AutomationProperties.Name="{Binding AllDisplaysOnHotkeyText}">
                    <TextBlock Classes="num" Text="{Binding AllDisplaysOnHotkeyText}" />
                  </Border>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_ConfirmSecondsHint}">
                  <TextBlock VerticalAlignment="Center" Classes="label" Text="{v:Tr Settings_ConfirmSeconds}" />
                  <NumericUpDown
                    Grid.Column="1"
                    Width="112"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{v:Tr Settings_ConfirmSecondsHint}"
                    AutomationProperties.Name="{v:Tr Settings_ConfirmSeconds}"
                    FormatString="0"
                    Increment="1"
                    Maximum="120"
                    Minimum="1"
                    Value="{Binding ConfirmTimeoutSeconds, Converter={x:Static v:Converters.Seconds}}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="24">
          <!-- ===== The app ===== -->
          <StackPanel Spacing="12">
            <StackPanel Margin="4,0,0,0" Orientation="Horizontal" Spacing="12">
              <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.Options20}" /></Border>
              <TextBlock Classes="section" Text="{v:Tr Settings_GroupApp}" />
            </StackPanel>
            <Border Classes="sheet">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <TextBlock Classes="label" Text="{v:Tr Settings_Autostart}" />
                  <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Settings_Autostart}" IsChecked="{Binding StartWithWindows}" OffContent="" OnContent="" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                  <TextBlock Classes="label" Text="{v:Tr Settings_Language}" />
                  <ComboBox Grid.Column="1" Width="220" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Settings_Language}" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Converter={x:Static v:Converters.KeepOnNull}}" />
                </Grid>
                <StackPanel IsVisible="{Binding ShowUpdateSetting}">
                  <Border Classes="divider" />
                  <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_AutoUpdateHint}">
                    <TextBlock VerticalAlignment="Center" Classes="label" Text="{v:Tr Settings_AutoUpdate}" />
                    <ToggleSwitch Grid.Column="1" AutomationProperties.HelpText="{v:Tr Settings_AutoUpdateHint}" AutomationProperties.Name="{v:Tr Settings_AutoUpdate}" IsChecked="{Binding InstallUpdatesAutomatically}" OffContent="" OnContent="" />
                  </Grid>
                </StackPanel>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_DetailedLogHint}">
                  <TextBlock VerticalAlignment="Center" Classes="label" Text="{v:Tr Settings_DetailedLog}" />
                  <ToggleSwitch Grid.Column="1" AutomationProperties.HelpText="{v:Tr Settings_DetailedLogHint}" AutomationProperties.Name="{v:Tr Settings_DetailedLog}" IsChecked="{Binding DetailedLogging}" OffContent="" OnContent="" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ===== Devices: the USB devices rules and profiles use; a name is saved on Enter or on leaving the field. ===== -->
          <StackPanel Spacing="12">
            <StackPanel Margin="4,0,0,0" Orientation="Horizontal" Spacing="12" ToolTip.Tip="{v:Tr Settings_DevicesHint}">
              <Border Classes="tile"><Path Classes="icon md" Data="{x:Static v:Icons.PlugConnected20}" /></Border>
              <TextBlock Classes="section" Text="{v:Tr Settings_GroupDevices}" />
            </StackPanel>
            <Border Classes="sheet">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="24" ToolTip.Tip="{v:Tr Settings_PauseRulesHint}">
                  <TextBlock VerticalAlignment="Center" Classes="label" Text="{v:Tr Settings_PauseRules}" />
                  <ToggleSwitch Grid.Column="1" AutomationProperties.HelpText="{v:Tr Settings_PauseRulesHint}" AutomationProperties.Name="{v:Tr Settings_PauseRules}" IsChecked="{Binding Devices.IsPaused}" OffContent="" OnContent="" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Devices.NamedDevices}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UsbNameCard">
                      <StackPanel>
                        <Border Classes="divider" />
                        <Grid Classes="row" ColumnDefinitions="Auto,*,200" ColumnSpacing="12">
                          <Path Classes="icon quiet" Data="{x:Static v:Icons.PlugConnected16}" />
                          <!-- Name and state; the VID/PID only as the tooltip. -->
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip.Tip="{Binding Id}">
                            <TextBlock Classes="label" Text="{Binding WindowsName}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Ellipse
                                Classes="status"
                                Classes.ok="{Binding StateKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Ok}"
                                Classes.warn="{Binding StateKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Warn}"
                                Classes.error="{Binding StateKind, Converter={x:Static v:Converters.Is}, ConverterParameter=Error}" />
                              <TextBlock Classes="caption" Text="{Binding StateText}" />
                            </StackPanel>
                          </StackPanel>
                          <TextBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="{Binding WindowsName}"
                            AutomationProperties.Name="{v:Tr Editor_CustomName}"
                            KeyDown="OnDeviceNameKeyDown"
                            LostFocus="OnDeviceNameLostFocus"
                            MaxLength="40"
                            PlaceholderText="{v:Tr Editor_CustomName}"
                            Text="{Binding CustomName}" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<Window
  x:Class="RigShift.Avalonia.Views.GamePickerWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:GamePickerViewModel"
  Title="{Binding WindowTitle}"
  Width="620"
  Height="600"
  MinWidth="420"
  MinHeight="380"
  ShowInTaskbar="False"
  WindowStartupLocation="CenterOwner"
  Background="{DynamicResource RsCard}">
  <Window.Styles>
    <Style Selector="ListBox.games ListBoxItem">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.games:not(.multi) CheckBox">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The store a game comes from, as a small chip at the end of the row. -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource RsRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RsDivider}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <!-- Title and search, 48 px rows with the games' own icons, the foot with the answers. -->
  <Grid Margin="24,20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="6">
      <TextBlock Classes="h3" Text="{Binding WindowTitle}" />
      <TextBlock Classes="secondary" Text="{Binding Intro}" TextWrapping="Wrap" />
      <TextBox
        x:Name="SearchBox"
        Margin="0,8,0,0"
        AutomationProperties.Name="{v:Tr GamePicker_Search}"
        KeyDown="OnSearchKeyDown"
        Text="{Binding Query}"
        PlaceholderText="{v:Tr GamePicker_Search}" />
    </StackPanel>

    <Panel Grid.Row="1">
      <ListBox
        x:Name="GameList"
        AutomationProperties.Name="{Binding WindowTitle}"
        Classes="games"
        Classes.multi="{Binding IsMultiple}"
        Background="Transparent"
        DoubleTapped="OnDoubleTapped"
        ItemsSource="{Binding Games}"
        SelectedItem="{Binding Selected}"
        SelectionMode="Single">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:InstalledGameItem">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
              <!-- Not focusable: the arrow keys stay in the list, Space ticks the selected row. -->
              <CheckBox
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Name}"
                Focusable="False"
                IsChecked="{Binding IsChecked}"
                IsVisible="{Binding $parent[Window].((vm:GamePickerViewModel)DataContext).IsMultiple}" />
              <!-- The game's own icon: it says more about the game than any symbol we could pick for it. -->
              <Border Grid.Column="1" Width="28" Height="28" Background="{DynamicResource RsRaised}" ClipToBounds="True" CornerRadius="6">
                <Panel>
                  <Path Classes="icon small" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{x:Static v:Icons.Games}" IsVisible="{Binding !HasIcon}" />
                  <Image Width="24" Height="24" IsVisible="{Binding HasIcon}" Source="{Binding Icon, Converter={x:Static v:Converters.IconImage}}" />
                </Panel>
              </Border>
              <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="3" VerticalAlignment="Center" Classes="chip" IsVisible="{Binding HasSource}">
                <TextBlock Classes="caption" Text="{Binding Source}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ProgressBar VerticalAlignment="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Classes="secondary"
        IsVisible="{Binding IsEmpty}"
        Text="{v:Tr GamePicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap" />
    </Panel>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button HorizontalAlignment="Left" Classes="link" Click="OnBrowse" Content="{v:Tr GamePicker_BrowseFile}" IsVisible="{Binding IsSingle}" />
      <Button
        Grid.Column="1"
        MinWidth="96"
        HorizontalContentAlignment="Center"
        Classes="primary"
        Click="OnChoose"
        Content="{Binding ChooseText, Converter={x:Static v:Converters.NoAccessKey}}"
        IsDefault="True"
        IsEnabled="{Binding CanChoose}" />
      <Button Grid.Column="2" MinWidth="96" HorizontalContentAlignment="Center" Classes="neutral" Click="OnCancel" Content="{v:Tr Common_Cancel}" IsCancel="True" />
    </Grid>
  </Grid>
</Window>

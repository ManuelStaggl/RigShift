<UserControl
  x:Class="RigShift.Avalonia.Views.AppListView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:AppListEditor">
  <!-- The apps a profile or a game starts and ends: action, when, wait, arguments; the USB device they wait for. -->
  <StackPanel>
    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AppEditItem">
          <StackPanel>
            <Grid Margin="0,12" ColumnDefinitions="28,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
              <Panel Width="24" Height="24" VerticalAlignment="Center">
                <Path Classes="icon lg" Data="{x:Static v:Icons.Window24}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image Source="{Binding Icon, Converter={x:Static v:Converters.IconImage}}" />
              </Panel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="strong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                <TextBlock Classes="caption warning" IsVisible="{Binding HasPathNote}" Text="{Binding PathNote}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Margin="0,0,8,0" VerticalAlignment="Center" Classes="link" Click="OnBrowse" Content="{v:Tr App_Change}" Tag="{Binding}" />
                <Button AutomationProperties.Name="{v:Tr App_MoveUp}" Classes="ghost" Click="OnMoveUp" Tag="{Binding}" ToolTip.Tip="{v:Tr App_MoveUp}">
                  <Path Classes="icon" Data="{x:Static v:Icons.ArrowUp16}" />
                </Button>
                <Button AutomationProperties.Name="{v:Tr App_MoveDown}" Classes="ghost" Click="OnMoveDown" Tag="{Binding}" ToolTip.Tip="{v:Tr App_MoveDown}">
                  <Path Classes="icon" Data="{x:Static v:Icons.ArrowDown16}" />
                </Button>
                <Button AutomationProperties.Name="{v:Tr App_Remove}" Classes="ghost" Click="OnRemoveApp" Tag="{Binding}" ToolTip.Tip="{v:Tr App_Remove}">
                  <Path Classes="icon" Data="{x:Static v:Icons.Delete16}" />
                </Button>
              </StackPanel>
              <!-- What, how long to wait, with which options -->
              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <ComboBox MinWidth="104" AutomationProperties.Name="{v:Tr App_Action}" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind, Converter={x:Static v:Converters.KeepOnNull}}" ToolTip.Tip="{v:Tr App_Action}" />
                <ComboBox Grid.Column="1" MinWidth="140" AutomationProperties.Name="{v:Tr App_When}" IsVisible="{Binding ShowWhen}" ItemsSource="{Binding WhenChoices}" SelectedItem="{Binding SelectedWhen, Converter={x:Static v:Converters.KeepOnNull}}" ToolTip.Tip="{v:Tr App_When}" />
                <NumericUpDown
                  Grid.Column="2"
                  Width="112"
                  AutomationProperties.Name="{v:Tr App_Wait}"
                  FormatString="0.#"
                  IsVisible="{Binding IsStart}"
                  Maximum="300"
                  Minimum="0"
                  ToolTip.Tip="{v:Tr App_Wait}"
                  Value="{Binding WaitSeconds, Converter={x:Static v:Converters.Seconds}}"
                  PlaceholderText="{v:Tr App_WaitShort}" />
                <TextBox Grid.Column="3" AutomationProperties.Name="{v:Tr App_Arguments}" IsVisible="{Binding IsStart}" Text="{Binding Arguments}" PlaceholderText="{v:Tr App_Arguments}" />
                <CheckBox Grid.Column="4" AutomationProperties.HelpText="{v:Tr App_WaitForWindowTip}" Content="{v:Tr App_WaitForWindow}" IsChecked="{Binding WaitForWindow}" IsVisible="{Binding IsStart}" ToolTip.Tip="{v:Tr App_WaitForWindowTip}" />
              </Grid>
            </Grid>
            <Border Classes="divider" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Margin="0,8,0,0" Classes="danger" IsVisible="{Binding HasProblem}" Text="{Binding Problem}" TextWrapping="Wrap" />
    <Grid Classes="row" ColumnDefinitions="*,300" ColumnSpacing="12">
      <TextBlock Classes="label" Text="{v:Tr Editor_AppsWaitDevice}" ToolTip.Tip="{v:Tr Editor_AppsWaitHint}" />
      <ComboBox
        Grid.Column="1"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        AutomationProperties.Name="{v:Tr Editor_AppsWaitDevice}"
        ItemsSource="{Binding WaitDevice.Choices}"
        SelectedItem="{Binding WaitDevice.Selected, Converter={x:Static v:Converters.KeepOnNull}}" />
    </Grid>
    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Classes="neutral" AutomationProperties.Name="{Binding AddText}" Command="{Binding AddPickedCommand}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Classes="icon" Data="{x:Static v:Icons.Add16}" />
        <TextBlock Text="{Binding AddText}" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>

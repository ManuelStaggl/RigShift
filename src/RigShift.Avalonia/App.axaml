<Application
  x:Class="RigShift.Avalonia.App"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:semi="https://irihi.tech/semi"
  RequestedThemeVariant="Default">
  <Application.Styles>
    <semi:SemiTheme Locale="en-US" />
    <semi:UrsaSemiTheme Locale="en-US" />
    <StyleInclude Source="avares://RigShift.Avalonia/Themes/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RigShift.Avalonia/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

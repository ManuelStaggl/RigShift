<!-- RigShift's own styles on top of Semi: type scale, rail, rows, links, the one primary button. -->
<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:u="https://irihi.tech/ursa">

  <!-- Type: 12/14/16/20/28, regular + semibold. -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource RsText3}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource RsWarning}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource RsDanger}" />
  </Style>
  <!-- No tabular figures: Mona Sans draws the tabular 1 with a foot serif, which reads as a mono font. -->

  <!-- Stroke icons on the 24 grid -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource RsText2}" />
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <!-- Three points have no height to stretch: drawn unscaled on the 24 grid, centred like the other icons. -->
  <Style Selector="Path.icon.dots">
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="-3" />
  </Style>
  <!-- A profile symbol: the brand drawing at 24 px. -->
  <Style Selector="Path.symbol">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource RsText2}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>

  <!-- Focus ring: accent line colour, 2 px, everywhere the keyboard lands. -->
  <Style Selector="Button, ToggleButton, TextBox, ComboBox, CheckBox, RadioButton, ToggleSwitch, NumericUpDown, ListBoxItem, u|SettingsCard, DropDownButton">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderBrush="{DynamicResource RsAccentText}" BorderThickness="2" CornerRadius="8" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Semi's NumericUpDown template leaves its field and spinner unnamed; Narrator read them as "PathIcon". -->
  <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
    <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="AutomationProperties.Name" Value="Increase" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton#PART_DecreaseButton">
    <Setter Property="AutomationProperties.Name" Value="Decrease" />
  </Style>

  <!-- Controls: 6 px radius, hairline outline, raised fill. -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Neutral button: raised fill, hairline, primary text. -->
  <Style Selector="Button.neutral">
    <Setter Property="Background" Value="{DynamicResource RsRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RsOutline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    <Setter Property="FontWeight" Value="Regular" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.neutral:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsRaisedHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RsOutline}" />
  </Style>

  <!-- The one saturated element on a screen. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource RsAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource RsOnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,7" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource RsOnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsAccentHover}" />
  </Style>
  <!-- Disabled: the same button, faded as a whole, so the label stays readable and it never looks active. -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource RsOnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Icon-only button: no fill until hovered. -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsRaisedHover}" />
  </Style>

  <!-- Links: neutral, semibold, underline on hover; the accent is kept for the primary action. -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>

  <!-- Rail -->
  <Style Selector="Button.rail">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rail:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.rail Border.plate">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail:pointerover Border.plate">
    <Setter Property="Background" Value="{DynamicResource RsHover}" />
  </Style>
  <Style Selector="Button.rail.selected Border.plate">
    <Setter Property="Background" Value="{DynamicResource RsRailOn}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RsRailOnShadow}" />
  </Style>
  <Style Selector="Button.rail Border.pill">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Background" Value="{DynamicResource RsAccentText}" />
  </Style>
  <Style Selector="Button.rail.selected Border.pill">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Path.icon.rail">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="Stroke" Value="{DynamicResource RsText3}" />
  </Style>
  <Style Selector="Button.rail:pointerover Path.icon.rail">
    <Setter Property="Stroke" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="Button.rail.selected Path.icon.rail">
    <Setter Property="Stroke" Value="{DynamicResource RsRailOnText}" />
    <Setter Property="Fill" Value="{DynamicResource RsAccentDuo}" />
  </Style>

  <!-- Title-bar search: a recessed well, placeholder in the hint colour, the shortcut as a keycap. -->
  <Style Selector="Button.search">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{DynamicResource RsDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RsDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.search:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsDeep}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RsOutline}" />
  </Style>
  <Style Selector="Button.search Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource RsText4}" />
  </Style>
  <Style Selector="Button.search TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource RsText4}" />
  </Style>

  <!-- Keycap: raised, 5 px radius, 11 px semibold. -->
  <Style Selector="Border.kbd">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="{DynamicResource RsKey}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RsKeyShadow}" />
  </Style>
  <Style Selector="Border.kbd > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Hairline divider -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource RsDivider}" />
  </Style>

  <!-- A row: label left, control right. -->
  <Style Selector="Grid.row">
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="0,0" />
  </Style>

  <!-- Notices instead of InfoBars: tinted surface, no icon badge. -->
  <Style Selector="Border.notice">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="{DynamicResource RsWarningSoft}" />
  </Style>
  <Style Selector="Border.notice.danger">
    <Setter Property="Background" Value="{DynamicResource RsDangerSoft}" />
  </Style>

  <!-- Ursa SettingsCard as a group header row: no own fill, our type. -->
  <Style Selector="u|SettingsCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="4,12" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="u|SettingsCard /template/ ContentPresenter#PART_Content">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <!-- Avalonia 12 drawn caption buttons (Semi theme): no title text (the rail carries the brand), no fullscreen button. -->
  <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ===== The sheet of the profiles and games pages ===== -->

  <!-- Master list of the profiles and games pages: the selected row is the accent pill, like the rail. -->
  <Style Selector="ListBox.master">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.master ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ListBox.master ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsHover}" />
  </Style>
  <Style Selector="ListBox.master ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.master ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsRailOn}" />
    <Setter Property="BoxShadow" Value="{DynamicResource RsRailOnShadow}" />
  </Style>

  <!-- The name as a 32 px heading that turns into a field on hover and focus. -->
  <Style Selector="TextBox.title">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.7" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="-7,0,0,0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Groups: Ursa SettingsCard rows inside one card, a hairline between them. -->
  <Style Selector="u|SettingsCard.group">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="u|SettingsCard.group /template/ ContentPresenter#PART_Content">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="u|SettingsCard.group /template/ Border#PART_Separator">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="u|SettingsCard.group /template/ Border#PART_DetailHost">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="u|SettingsCard.group /template/ ContentPresenter#PART_Description">
    <Setter Property="Foreground" Value="{DynamicResource RsText3}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Border.tile > Path.icon">
    <Setter Property="StrokeThickness" Value="2" />
  </Style>

  <!-- A settings row inside a group or the inspector. -->
  <Style Selector="Grid.row > TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
  </Style>
  <!-- Inspector key/value rows -->
  <Style Selector="Grid.kv">
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Grid.kv > TextBlock.k">
    <Setter Property="Foreground" Value="{DynamicResource RsText3}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.kv TextBlock.val">
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Status dot in front of a status line: grey, green ready, amber learning, red failed, accent while running. -->
  <Style Selector="Ellipse.status">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource RsText4}" />
  </Style>
  <Style Selector="Ellipse.status.ok">
    <Setter Property="Fill" Value="{DynamicResource RsSuccess}" />
  </Style>
  <Style Selector="Ellipse.status.warn">
    <Setter Property="Fill" Value="{DynamicResource RsWarning}" />
  </Style>
  <Style Selector="Ellipse.status.error">
    <Setter Property="Fill" Value="{DynamicResource RsDanger}" />
  </Style>
  <Style Selector="Ellipse.status.accent">
    <Setter Property="Fill" Value="{DynamicResource RsAccent}" />
  </Style>

  <!-- A card of setting rows, as the groups of the profiles and games pages; a hairline between the rows. -->
  <Style Selector="Border.sheet">
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{DynamicResource RsCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RsDivider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="{DynamicResource RsCardShadow}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <!-- A section's name over its card, as on the overview. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Action bar buttons: flat until hovered, label + keycap. -->
  <Style Selector="Button.ab">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0,6,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource RsText}" />
  </Style>
  <Style Selector="Button.ab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource RsHover}" />
  </Style>
</Styles>

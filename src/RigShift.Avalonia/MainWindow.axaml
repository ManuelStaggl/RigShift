<Window
  x:Class="RigShift.Avalonia.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  xmlns:v="using:RigShift.Avalonia.Views"
  Title="RigShift"
  Width="1280"
  Height="780"
  MinWidth="900"
  MinHeight="560"
  Background="{DynamicResource RsRail}"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaTitleBarHeightHint="40"
  WindowStartupLocation="CenterScreen">
  <!-- Chrome: 40 px title bar, 64 px icon rail, the content panel floating inside. -->
  <Grid ColumnDefinitions="64,*" RowDefinitions="40,*">
    <!-- Title bar: the whole strip drags; the search box sits on top of it and takes its own clicks. -->
    <Border Grid.ColumnSpan="2" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,*" IsHitTestVisible="True">
      <StackPanel Margin="16,0,0,0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False">
        <!-- The brand package's tray symbol, drawn for small sizes; white in dark, dark in light (code-behind). -->
        <Image x:Name="TitleIcon" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Classes="caption" Text="RigShift" VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="Search" Grid.Column="1" Classes="search" Width="440" Click="OnSearchClick">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Path Classes="icon" Data="{x:Static v:Icons.Search16}" />
          <TextBlock x:Name="SearchText" Grid.Column="1" Margin="8,0" Classes="caption" VerticalAlignment="Center" />
          <Border Grid.Column="2" Classes="kbd"><TextBlock x:Name="SearchKey" /></Border>
        </Grid>
      </Button>
    </Grid>

    <DockPanel Grid.Row="1">
      <StackPanel x:Name="BottomRail" DockPanel.Dock="Bottom" Margin="0,0,0,12" Spacing="4" />
      <StackPanel x:Name="TopRail" Margin="0,8,0,0" Spacing="4" />
    </DockPanel>

    <Border
      Grid.Row="1"
      Grid.Column="1"
      Margin="0,0,8,8"
      Background="{DynamicResource RsContent}"
      BorderBrush="{DynamicResource RsDivider}"
      BorderThickness="1"
      ClipToBounds="True"
      CornerRadius="{DynamicResource RsRadiusLg}">
      <!-- Windows "Text size" scales the pages, which Avalonia does not follow on its own (see TextScaleSetting). -->
      <LayoutTransformControl x:Name="Scaled">
        <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </LayoutTransformControl>
    </Border>

    <!-- Command palette (Ctrl+K): one field, the matching commands below, Enter runs the highlighted one. -->
    <Panel x:Name="Palette" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False">
      <Border Background="{DynamicResource SemiColorOverlayBackground}" PointerPressed="OnPaletteDimPressed" />
      <Border
        Width="560"
        Margin="0,64,0,0"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="{DynamicResource RsCard}"
        BorderBrush="{DynamicResource RsOutline}"
        BorderThickness="1"
        BoxShadow="{DynamicResource RsPopShadow}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource RsRadiusLg}">
        <DockPanel>
          <Grid Height="48" Margin="16,0,12,0" ColumnDefinitions="Auto,*,Auto" DockPanel.Dock="Top">
            <Path Classes="icon" Data="{x:Static v:Icons.Search16}" />
            <TextBox
              x:Name="PaletteQuery"
              Grid.Column="1"
              Margin="8,0"
              VerticalAlignment="Center"
              Background="Transparent"
              BorderThickness="0"
              TextChanged="OnPaletteQueryChanged"
              KeyDown="OnPaletteKeyDown" />
            <Border Grid.Column="2" VerticalAlignment="Center" Classes="kbd"><TextBlock Text="Esc" /></Border>
          </Grid>
          <Border Classes="divider" DockPanel.Dock="Top" />
          <TextBlock x:Name="PaletteEmpty" Margin="16,12" Classes="caption" DockPanel.Dock="Top" IsVisible="False" />
          <ListBox x:Name="PaletteList" MaxHeight="360" Margin="8" Background="Transparent" Focusable="False" Tapped="OnPaletteTapped" />
        </DockPanel>
      </Border>
    </Panel>
  </Grid>
</Window>

  <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ContextMenuForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="MenuBarBackground" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="MenuBarItemBackgroundSelected" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource RigShift.Color.Line}" />

<!--
  Design tokens of RigShift 3.0: Brand Package 1.0, tokens.json → themes.dark. There is one theme, dark; high contrast
  swaps this dictionary for TokensHighContrast.xaml (same keys, system colors). Derived values are marked.
  The second half maps the WPF-UI resource keys onto the same values so its stock controls (ComboBox, CheckBox,
  ToggleSwitch, Slider, menus, tooltips) wear the brand without their own templates.
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Surfaces -->
  <Color x:Key="RigShift.Color.Chrome">#0B1220</Color>
  <Color x:Key="RigShift.Color.Page">#111A2B</Color>
  <Color x:Key="RigShift.Color.Layer">#1E293B</Color>
  <Color x:Key="RigShift.Color.LayerHover">#253449</Color>
  <Color x:Key="RigShift.Color.Selected">#273E5A</Color>
  <Color x:Key="RigShift.Color.Line">#2C3A52</Color>
  <Color x:Key="RigShift.Color.LineStrong">#5B6B85</Color>
  <!-- Text -->
  <Color x:Key="RigShift.Color.TextPrimary">#F8FAFC</Color>
  <Color x:Key="RigShift.Color.TextSecondary">#B8C6D9</Color>
  <Color x:Key="RigShift.Color.TextDisabled">#6B7A93</Color>
  <!-- Accent (primary / onPrimary); hover and pressed are derived. -->
  <Color x:Key="RigShift.Color.Accent">#79B8FF</Color>
  <Color x:Key="RigShift.Color.AccentHover">#8FC4FF</Color>
  <Color x:Key="RigShift.Color.AccentPressed">#66A9F2</Color>
  <Color x:Key="RigShift.Color.AccentRing">#6679B8FF</Color>
  <Color x:Key="RigShift.Color.OnAccent">#0B1220</Color>
  <!-- State -->
  <Color x:Key="RigShift.Color.Ok">#74D99A</Color>
  <Color x:Key="RigShift.Color.Warn">#F4C96B</Color>
  <Color x:Key="RigShift.Color.Error">#FF9EA9</Color>
  <!-- Topology -->
  <Color x:Key="RigShift.Color.DisplayFill">#253449</Color>
  <Color x:Key="RigShift.Color.DisplayFillOff">#172033</Color>

  <SolidColorBrush x:Key="RigShift.Brush.Chrome" Color="{StaticResource RigShift.Color.Chrome}" />
  <SolidColorBrush x:Key="RigShift.Brush.Page" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="RigShift.Brush.Layer" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="RigShift.Brush.LayerHover" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="RigShift.Brush.Selected" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="RigShift.Brush.OnSelected" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="RigShift.Brush.Line" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="RigShift.Brush.LineStrong" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="RigShift.Brush.TextPrimary" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="RigShift.Brush.TextSecondary" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="RigShift.Brush.TextDisabled" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="RigShift.Brush.Accent" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="RigShift.Brush.AccentHover" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="RigShift.Brush.AccentPressed" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="RigShift.Brush.AccentRing" Color="{StaticResource RigShift.Color.AccentRing}" />
  <SolidColorBrush x:Key="RigShift.Brush.OnAccent" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="RigShift.Brush.Ok" Color="{StaticResource RigShift.Color.Ok}" />
  <SolidColorBrush x:Key="RigShift.Brush.Warn" Color="{StaticResource RigShift.Color.Warn}" />
  <SolidColorBrush x:Key="RigShift.Brush.Error" Color="{StaticResource RigShift.Color.Error}" />
  <SolidColorBrush x:Key="RigShift.Brush.DisplayFill" Color="{StaticResource RigShift.Color.DisplayFill}" />
  <SolidColorBrush x:Key="RigShift.Brush.DisplayFillOff" Color="{StaticResource RigShift.Color.DisplayFillOff}" />
  <!-- Hatch for a missing display: 45° lines in the error color at 45 %. -->
  <DrawingBrush
    x:Key="RigShift.Brush.Hatch"
    TileMode="Tile"
    Viewport="0,0,6,6"
    ViewportUnits="Absolute"
    Viewbox="0,0,6,6"
    ViewboxUnits="Absolute"
    Opacity="0.45">
    <DrawingBrush.Drawing>
      <GeometryDrawing>
        <GeometryDrawing.Pen>
          <Pen Brush="{StaticResource RigShift.Brush.Error}" Thickness="1" />
        </GeometryDrawing.Pen>
        <GeometryDrawing.Geometry>
          <LineGeometry StartPoint="0,6" EndPoint="6,0" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Type: Segoe UI Variable (Brand), Cascadia Mono for values (addition, spec principle 5). -->
  <FontFamily x:Key="RigShift.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="RigShift.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="RigShift.Font.Small">Segoe UI Variable Small, Segoe UI</FontFamily>
  <FontFamily x:Key="RigShift.Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <sys:Double x:Key="RigShift.Type.Caption.Size">12</sys:Double>
  <sys:Double x:Key="RigShift.Type.Caption.LineHeight">16</sys:Double>
  <sys:Double x:Key="RigShift.Type.Body.Size">14</sys:Double>
  <sys:Double x:Key="RigShift.Type.Body.LineHeight">20</sys:Double>
  <sys:Double x:Key="RigShift.Type.Subtitle.Size">20</sys:Double>
  <sys:Double x:Key="RigShift.Type.Subtitle.LineHeight">28</sys:Double>
  <sys:Double x:Key="RigShift.Type.Title.Size">28</sys:Double>
  <sys:Double x:Key="RigShift.Type.Title.LineHeight">36</sys:Double>
  <sys:Double x:Key="RigShift.Type.Mono.Size">12</sys:Double>
  <sys:Double x:Key="RigShift.Type.Mono.LineHeight">16</sys:Double>
  <FontWeight x:Key="RigShift.Type.Weight.Regular">Normal</FontWeight>
  <FontWeight x:Key="RigShift.Type.Weight.Strong">SemiBold</FontWeight>

  <!-- Geometry: radii and the 4 px spacing scale. -->
  <CornerRadius x:Key="RigShift.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="RigShift.Radius.Card">12</CornerRadius>
  <CornerRadius x:Key="RigShift.Radius.Window">12</CornerRadius>
  <sys:Double x:Key="RigShift.Space.1">4</sys:Double>
  <sys:Double x:Key="RigShift.Space.2">8</sys:Double>
  <sys:Double x:Key="RigShift.Space.3">12</sys:Double>
  <sys:Double x:Key="RigShift.Space.4">16</sys:Double>
  <sys:Double x:Key="RigShift.Space.6">24</sys:Double>
  <sys:Double x:Key="RigShift.Space.8">32</sys:Double>

  <!-- ===== WPF-UI keys, so its stock controls follow the brand. Templates read these with DynamicResource. ===== -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
  <sys:Double x:Key="ControlContentThemeFontSize">14</sys:Double>

  <!-- Accent: one blue, no derived tints; hover/pressed use the two derived values above. -->
  <Color x:Key="SystemAccentColor">#79B8FF</Color>
  <Color x:Key="SystemAccentColorPrimary">#79B8FF</Color>
  <Color x:Key="SystemAccentColorSecondary">#8FC4FF</Color>
  <Color x:Key="SystemAccentColorTertiary">#66A9F2</Color>
  <Color x:Key="AccentFillColorDefault">#79B8FF</Color>
  <Color x:Key="AccentFillColorSecondary">#8FC4FF</Color>
  <Color x:Key="AccentFillColorTertiary">#66A9F2</Color>
  <Color x:Key="AccentFillColorSelectedTextBackground">#79B8FF</Color>
  <Color x:Key="AccentTextFillColorPrimary">#79B8FF</Color>
  <Color x:Key="AccentTextFillColorSecondary">#8FC4FF</Color>
  <Color x:Key="AccentTextFillColorTertiary">#66A9F2</Color>
  <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B30B1220" />
  <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{StaticResource RigShift.Color.Accent}" />

  <!-- Surfaces and strokes -->
  <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource RigShift.Color.Chrome}" />
  <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource RigShift.Color.Chrome}" />
  <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="CircleElevationBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="{StaticResource RigShift.Color.Chrome}" />
  <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.Selected}" />

  <!-- Text -->
  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="LabelForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />

  <!-- State (system fill) -->
  <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{StaticResource RigShift.Color.Ok}" />
  <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{StaticResource RigShift.Color.Warn}" />
  <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{StaticResource RigShift.Color.Error}" />
  <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource RigShift.Color.Accent}" />

  <!-- Buttons (stock; RigShift buttons have their own styles in Controls.xaml) -->
  <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="HyperlinkButtonForegroundDisabled" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="ToggleButtonBackground" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />

  <!-- Fields -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="TextControlButtonForeground" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource RigShift.Color.TextDisabled}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="{StaticResource RigShift.Color.TextSecondary}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource RigShift.Color.Layer}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource RigShift.Color.TextPrimary}" />

  <!-- Check, radio, switch, slider, progress -->
  <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="CheckBoxBackground" Color="Transparent" />
  <SolidColorBrush x:Key="CheckBoxCheckBorderBrush" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource RigShift.Color.OnAccent}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource RigShift.Color.AccentPressed}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="RadioButtonForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseStroke" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource RigShift.Color.AccentHover}" />
  <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseFill" Color="Transparent" />
  <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource RigShift.Color.LayerHover}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{StaticResource RigShift.Color.Selected}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="{StaticResource RigShift.Color.LineStrong}" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{StaticResource RigShift.Color.TextSecondary}" />

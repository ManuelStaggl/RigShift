  <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ContentDialogForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="MessageBoxBackground" Color="{StaticResource RigShift.Color.Page}" />
  <SolidColorBrush x:Key="MessageBoxForeground" Color="{StaticResource RigShift.Color.TextPrimary}" />
  <SolidColorBrush x:Key="MessageBoxSeparatorBorderBrush" Color="{StaticResource RigShift.Color.Line}" />

  <SolidColorBrush x:Key="ProgressBarBackground" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ProgressBarIndeterminateBackground" Color="{StaticResource RigShift.Color.Line}" />
  <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource RigShift.Color.Accent}" />
  <SolidColorBrush x:Key="ProgressRingBackgroundThemeBrush" Color="{StaticResource RigShift.Color.Line}" />

  <!-- Menus, flyouts, tooltips, dialogs, lists, scrollbars -->

<!--
  Component styles of RigShift 3.0 on the tokens in Tokens.xaml. Explicit keys throughout – an implicit TextBlock style
  would leak into every WPF-UI template. Fonts and the text color are inherited from the window; every style that
  sits on a page background sets its foreground anyway (WPF-UI draws ui:TextBlock too dark otherwise).
-->
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization">

  <!-- Keyboard focus: a 2 px accent ring outside the control. -->
  <Style x:Key="RigShift.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle
            Margin="-3"
            RadiusX="8"
            RadiusY="8"
            SnapsToDevicePixels="True"
            Stroke="{DynamicResource RigShift.Brush.Accent}"
            StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Elevation of flyouts, menus and drop downs (F-02): a shadow on its own layer behind the surface, so the text
       above it keeps ClearType. The popup needs AllowsTransparency and a margin the shadow can fall into. -->
  <Style x:Key="RigShift.FlyoutShadow" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RigShift.Radius.Card}" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.45" ShadowDepth="6" Color="{DynamicResource RigShift.Color.Shadow}" />
      </Setter.Value>
    </Setter>
  </Style>
  <controls:AddConverter x:Key="RigShift.PlusShadowMargin" Amount="32" />

  <!-- ===== Text roles (spec 7.2) ===== -->
  <Style x:Key="RigShift.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="RigShift.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="RigShift.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
  </Style>
  <Style x:Key="RigShift.Text.CaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Caption}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Field label: caption above the field, no colon. -->
  <Style x:Key="RigShift.Text.Label" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Caption}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="RigShift.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="RigShift.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Subtitle}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
  </Style>
  <!-- Page title: 24 on the display face, one per page. -->
  <Style x:Key="RigShift.Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Subtitle}">
    <Setter Property="FontSize" Value="{DynamicResource RigShift.Type.PageTitle.Size}" />
    <Setter Property="LineHeight" Value="{DynamicResource RigShift.Type.PageTitle.LineHeight}" />
  </Style>
  <!-- Section heading inside a page or tab: 16 semibold, primary text. -->
  <Style x:Key="RigShift.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource RigShift.Type.Section.Size}" />
    <Setter Property="LineHeight" Value="{DynamicResource RigShift.Type.Section.LineHeight}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Values: resolutions, refresh rates, hotkeys, process names, paths, times. The text face with tabular figures,
       so columns of numbers stay aligned without a monospaced font. -->
  <!-- A result as a key figure (V-02): big, semibold, tabular figures. -->
  <Style x:Key="RigShift.Text.Metric" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Display}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <Style x:Key="RigShift.Text.Value" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="RigShift.Text.ValueSecondary" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Value}">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
  </Style>

  <!-- ===== Buttons (spec 7.3): one template, the rank sets fills through Interaction.* ===== -->
  <!-- Hover and pressed fills are layers over the rest fill whose opacity fades (Motion.Fast), so any brush works. -->
  <ControlTemplate x:Key="RigShift.ButtonTemplate" TargetType="ButtonBase">
    <Grid SnapsToDevicePixels="True">
      <Border
        x:Name="Root"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{DynamicResource RigShift.Radius.Control}" />
      <Border
        x:Name="HoverLayer"
        Margin="{TemplateBinding BorderThickness}"
        Background="{Binding Path=(controls:Interaction.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
        CornerRadius="{DynamicResource RigShift.Radius.Control}"
        Opacity="0" />
      <Border
        x:Name="PressedLayer"
        Margin="{TemplateBinding BorderThickness}"
        Background="{Binding Path=(controls:Interaction.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
        CornerRadius="{DynamicResource RigShift.Radius.Control}"
        Opacity="0" />
      <ContentPresenter
        x:Name="Content"
        Margin="{TemplateBinding Padding}"
        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
        RecognizesAccessKey="True"
        TextElement.Foreground="{TemplateBinding Foreground}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Content" Property="TextElement.Foreground" Value="{Binding Path=(controls:Interaction.HoverForeground), RelativeSource={RelativeSource TemplatedParent}}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="PressedLayer" Property="Opacity" Value="1" />
        <Setter TargetName="HoverLayer" Property="Visibility" Value="Hidden" />
      </Trigger>
      <!-- Disabled: no accent, no frame, muted text – it must not look clickable (Z-06). -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Background" Value="{Binding Path=(controls:Interaction.DisabledBackground), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
        <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
        <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Secondary: the default rank. -->
  <Style x:Key="RigShift.Button" TargetType="Button">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.LayerHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="controls:Interaction.HoverBackground" Value="{DynamicResource RigShift.Brush.Selected}" />
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="controls:Interaction.PressedBackground" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="controls:Interaction.DisabledBackground" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
    <Setter Property="Template" Value="{StaticResource RigShift.ButtonTemplate}" />
  </Style>
  <!-- Primary: the one accent button of a view (R-ACT-1). -->
  <Style x:Key="RigShift.Button.Primary" TargetType="Button" BasedOn="{StaticResource RigShift.Button}">
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="controls:Interaction.HoverBackground" Value="{DynamicResource RigShift.Brush.AccentHover}" />
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.OnAccent}" />
    <Setter Property="controls:Interaction.PressedBackground" Value="{DynamicResource RigShift.Brush.AccentPressed}" />
  </Style>
  <!-- Ghost: quiet, for tertiary actions and toolbars. -->
  <Style x:Key="RigShift.Button.Ghost" TargetType="Button" BasedOn="{StaticResource RigShift.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="controls:Interaction.HoverBackground" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="controls:Interaction.PressedBackground" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
    <Setter Property="controls:Interaction.DisabledBackground" Value="Transparent" />
  </Style>
  <!-- Icon buttons: 32 × 32, ghost or outlined. The content is a ui:SymbolIcon; the AutomationProperties.Name carries the meaning. -->
  <Style x:Key="RigShift.Button.Icon" TargetType="Button" BasedOn="{StaticResource RigShift.Button.Ghost}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Kept as a key for existing pages; every icon button is a ghost now (B-08). -->
  <Style x:Key="RigShift.Button.IconOutlined" TargetType="Button" BasedOn="{StaticResource RigShift.Button.Icon}" />
  <!-- Delete and remove: quiet at rest, red on hover. -->
  <Style x:Key="RigShift.Button.IconDanger" TargetType="Button" BasedOn="{StaticResource RigShift.Button.Icon}">
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.Error}" />
  </Style>
  <!-- Destructive: red fill with dark text, only in dialogs (D-03); hover lightens it like the other buttons. -->
  <Style x:Key="RigShift.Button.Danger" TargetType="Button" BasedOn="{StaticResource RigShift.Button}">
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="controls:Interaction.HoverBackground" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.OnAccent}" />
    <Setter Property="controls:Interaction.PressedBackground" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
  </Style>
  <!-- Link: accent text, underline only on hover (B-09). -->
  <Style x:Key="RigShift.Link" TargetType="Button" BasedOn="{StaticResource RigShift.Button.Ghost}">
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.Accent}" />
    <Setter Property="controls:Interaction.HoverBackground" Value="Transparent" />
    <Setter Property="controls:Interaction.HoverForeground" Value="{DynamicResource RigShift.Brush.AccentHover}" />
    <Setter Property="controls:Interaction.PressedBackground" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock
            x:Name="Text"
            Foreground="{TemplateBinding Foreground}"
            Text="{TemplateBinding Content}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Text" Property="Foreground" Value="{Binding Path=(controls:Interaction.HoverForeground), RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Field (spec 7.3): 32 high, page background, strong line; focus = accent edge + 40 % ring ===== -->
  <Style x:Key="RigShift.Field" TargetType="TextBox">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Page}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
    <Setter Property="SelectionOpacity" Value="0.4" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="AllowDrop" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border
              x:Name="Ring"
              Margin="-2"
              BorderBrush="{DynamicResource RigShift.Brush.AccentRing}"
              BorderThickness="2"
              CornerRadius="8"
              Visibility="Collapsed" />
            <!-- No padding here: a TextBox lays out its own Padding around the text, so a second one would double it. -->
            <Border
              x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              SnapsToDevicePixels="True">
              <ScrollViewer
                x:Name="PART_ContentHost"
                Margin="0"
                Padding="0"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Focusable="False" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:Interaction.IsInvalid" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Values (hotkeys, process names, commands): the text face with tabular figures. -->
  <Style x:Key="RigShift.Field.Value" TargetType="TextBox" BasedOn="{StaticResource RigShift.Field}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>
  <!-- The name in a detail head: subtitle size, no frame until it has the focus (F2 edits it). -->
  <Style x:Key="RigShift.Field.Title" TargetType="TextBox" BasedOn="{StaticResource RigShift.Field}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Display}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="-7,0,0,0" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Page}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!--
    Inline edit in a list row (O-03): reads as plain text, shows its frame and a pen on hover, the full field with the
    focus. An empty value shows the placeholder from Tag in the disabled text color.
  -->
  <Style x:Key="RigShift.Field.Inline" TargetType="TextBox" BasedOn="{StaticResource RigShift.Field}">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,0,28,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border
              x:Name="Ring"
              Margin="-2"
              BorderBrush="{DynamicResource RigShift.Brush.AccentRing}"
              BorderThickness="2"
              CornerRadius="8"
              Visibility="Collapsed" />
            <Border
              x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              SnapsToDevicePixels="True">
              <Grid>
                <TextBlock
                  x:Name="Placeholder"
                  Margin="{TemplateBinding Padding}"
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource RigShift.Brush.TextPlaceholder}"
                  IsHitTestVisible="False"
                  Text="{TemplateBinding Tag}"
                  TextTrimming="CharacterEllipsis"
                  Visibility="Collapsed" />
                <ScrollViewer
                  x:Name="PART_ContentHost"
                  Margin="0"
                  Padding="0"
                  VerticalAlignment="Center"
                  Focusable="False" />
                <ui:SymbolIcon
                  x:Name="Pen"
                  Margin="0,0,8,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                  IsHitTestVisible="False"
                  Opacity="0"
                  Symbol="Edit16" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter TargetName="Pen" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.Page}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Pen" Property="Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Caption under a field with the validation reason. -->
  <Style x:Key="RigShift.Text.FieldError" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Caption}">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.Error}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <!-- ===== Select: own template, so the text sits on the field's baseline and never runs into the chevron ===== -->
  <ControlTemplate x:Key="RigShift.SelectToggleTemplate" TargetType="ToggleButton">
    <Border Background="Transparent" />
  </ControlTemplate>
  <!-- A row of the drop down; a long entry ends in an ellipsis instead of widening the list past its cap. -->
  <Style x:Key="RigShift.SelectItem" TargetType="ComboBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Root"
            MinHeight="{TemplateBinding MinHeight}"
            Margin="4,1"
            Padding="{TemplateBinding Padding}"
            Background="Transparent"
            CornerRadius="{DynamicResource RigShift.Radius.Control}"
            SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                  <Setter Property="TextWrapping" Value="NoWrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.Selected}" />
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.OnSelected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RigShift.Select" TargetType="ComboBox">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="72" />
    <!-- Left inset 11 like the field (1 border + 10); the chevron owns the right end. -->
    <Setter Property="Padding" Value="11,0,6,0" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Page}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MaxDropDownHeight" Value="360" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RigShift.SelectItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border
              x:Name="Ring"
              Margin="-2"
              BorderBrush="{DynamicResource RigShift.Brush.AccentRing}"
              BorderThickness="2"
              CornerRadius="8"
              Visibility="Collapsed" />
            <Border
              x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                  x:Name="Selection"
                  Grid.Column="0"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="Center"
                  Content="{TemplateBinding SelectionBoxItem}"
                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                  IsHitTestVisible="False"
                  TextElement.Foreground="{TemplateBinding Foreground}">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
                <Path
                  x:Name="Chevron"
                  Grid.Column="1"
                  Width="10"
                  Height="6"
                  Margin="0,1,11,0"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5"
                  Data="M 0,0 L 5,5 L 10,0"
                  IsHitTestVisible="False"
                  Stretch="None"
                  Stroke="{DynamicResource RigShift.Brush.TextSecondary}"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="1.4">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="ChevronTurn" Angle="0" />
                  </Path.RenderTransform>
                </Path>
              </Grid>
            </Border>
            <!-- Stretch spelled out: the WPF-UI style for ToggleButton would shrink this empty template to nothing. -->
            <ToggleButton
              x:Name="Toggle"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              MinWidth="0"
              MinHeight="0"
              ClickMode="Press"
              Focusable="False"
              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
              Template="{StaticResource RigShift.SelectToggleTemplate}" />
            <!-- A transparent margin around the list carries the flyout shadow; the offsets take it back out. -->
            <Popup
              x:Name="PART_Popup"
              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RigShift.PlusShadowMargin}}"
              MaxWidth="592"
              AllowsTransparency="True"
              Focusable="False"
              HorizontalOffset="-16"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              Placement="Bottom"
              PopupAnimation="None"
              VerticalOffset="4">
              <Grid x:Name="Flyout" Margin="16,0,16,24">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="FlyoutShift" />
                </Grid.RenderTransform>
                <Border Style="{StaticResource RigShift.FlyoutShadow}" />
                <Border
                  MaxHeight="{TemplateBinding MaxDropDownHeight}"
                  Padding="0,4"
                  Background="{DynamicResource RigShift.Brush.Layer}"
                  BorderBrush="{DynamicResource RigShift.Brush.Line}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RigShift.Radius.Card}"
                  SnapsToDevicePixels="True">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="180" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="Flyout" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static controls:Motion.Enter}" />
                    <DoubleAnimation Storyboard.TargetName="FlyoutShift" Storyboard.TargetProperty="Y" From="-4" To="0" Duration="{x:Static controls:Motion.Enter}" EasingFunction="{x:Static controls:Motion.Decelerate}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:Interaction.IsInvalid" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
              <Setter TargetName="Selection" Property="TextElement.Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Toggle 36 × 20 and the check box on the WPF-UI templates; the tokens color them. -->
  <Style x:Key="RigShift.Toggle" TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
  </Style>
  <!-- A long label wraps; without this the text is cut at the column's edge. Element content stays as it is. -->
  <DataTemplate x:Key="RigShift.WrappingLabel">
    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
  </DataTemplate>
  <controls:LabelTemplateSelector x:Key="RigShift.LabelSelector" TextTemplate="{StaticResource RigShift.WrappingLabel}" />
  <Style x:Key="RigShift.Check" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ContentTemplateSelector" Value="{StaticResource RigShift.LabelSelector}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
  </Style>
  <!-- Number box on the field's measurements; the WPF-UI default is a few pixels taller than a text field. -->
  <Style x:Key="RigShift.Number" TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
  </Style>
  <!-- Radio (Z-01): 20 px, 1.5 px ring; chosen = accent disc with an 8 px dot, 10 px on hover. One look everywhere. -->
  <Style x:Key="RigShift.Radio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ContentTemplateSelector" Value="{StaticResource RigShift.LabelSelector}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="20" Height="20" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Ellipse x:Name="Ring" Fill="Transparent" Stroke="{DynamicResource RigShift.Brush.LineStrong}" StrokeThickness="1.5" />
              <Ellipse
                x:Name="Dot"
                Width="8"
                Height="8"
                Fill="{DynamicResource RigShift.Brush.OnAccent}"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Collapsed">
                <Ellipse.RenderTransform>
                  <ScaleTransform x:Name="DotScale" />
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ContentPresenter
              x:Name="Label"
              Grid.Column="1"
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
              RecognizesAccessKey="True"
              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" From="0.4" To="1" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" From="0.4" To="1" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource RigShift.Brush.AccentHover}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RigShift.Brush.AccentHover}" />
              <Setter TargetName="Dot" Property="Width" Value="10" />
              <Setter TargetName="Dot" Property="Height" Value="10" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsEnabled" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource RigShift.Brush.Line}" />
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Segment: one of three ("Leave · Off · On"), a ListBox with equal cells ===== -->
  <Style x:Key="RigShift.Segment" TargetType="ListBox">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Chrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="2"
            CornerRadius="{DynamicResource RigShift.Radius.Control}"
            SnapsToDevicePixels="True">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
          <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
          <Setter Property="FontSize" Value="14" />
          <Setter Property="Padding" Value="8,0" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid Background="Transparent" SnapsToDevicePixels="True">
                  <Border x:Name="Hover" Background="{DynamicResource RigShift.Brush.HoverOverlay}" CornerRadius="4" Opacity="0" />
                  <Border
                    x:Name="Pill"
                    Background="{DynamicResource RigShift.Brush.LayerHover}"
                    BorderBrush="{DynamicResource RigShift.Brush.LineStrong}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Opacity="0" />
                  <Border
                    x:Name="Focus"
                    Margin="-1"
                    BorderBrush="{DynamicResource RigShift.Brush.Accent}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Visibility="Collapsed" />
                  <ContentPresenter
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextElement.Foreground="{TemplateBinding Foreground}" />
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
                  <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Fast}" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Fast}" />
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                    <Trigger.EnterActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Base}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Pill" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Base}" />
                        </Storyboard>
                      </BeginStoryboard>
                    </Trigger.ExitActions>
                  </Trigger>
                  <Trigger Property="controls:Interaction.IsKeyboardFocusVisible" Value="True">
                    <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Chip (22 high, pill): a fact ===== -->
  <Style x:Key="RigShift.Chip" TargetType="ContentControl">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.LayerHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RigShift.Radius.Chip}"
            SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RigShift.Chip.Value" TargetType="ContentControl" BasedOn="{StaticResource RigShift.Chip}">
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
  </Style>

  <!-- ===== Card: layer surface, 12 radius, thin line; 16 padding (spec 7.3) ===== -->
  <Style x:Key="RigShift.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RigShift.Radius.Card}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <!-- Hairline between rows and groups. -->
  <Style x:Key="RigShift.Divider" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <!-- Surface under a topology picture: chrome, a soft light in the middle, a solid hairline, 12 radius (F-01). -->
  <Style x:Key="RigShift.TopologyPanel" TargetType="ContentControl">
    <Setter Property="Padding" Value="16,12,16,16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border
              Background="{DynamicResource RigShift.Brush.Chrome}"
              BorderBrush="{DynamicResource RigShift.Brush.Line}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RigShift.Radius.Card}"
              SnapsToDevicePixels="True" />
            <Border Margin="1" CornerRadius="11" IsHitTestVisible="False">
              <Border.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.6" RadiusY="0.75">
                  <GradientStop Offset="0" Color="#1479B8FF" />
                  <GradientStop Offset="1" Color="#0079B8FF" />
                </RadialGradientBrush>
              </Border.Background>
            </Border>
            <ContentPresenter Margin="{TemplateBinding Padding}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Master list and navigation rows (R-NAV-1/2, R-ACT-4: rows carry no buttons) ===== -->
  <Style x:Key="RigShift.List" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="RigShift.RowTemplate" TargetType="ListBoxItem">
    <Grid SnapsToDevicePixels="True">
      <Border
        x:Name="Root"
        Background="{TemplateBinding Background}"
        BorderBrush="{TemplateBinding BorderBrush}"
        BorderThickness="{TemplateBinding BorderThickness}"
        CornerRadius="{Binding Path=(controls:Interaction.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
      <Border
        x:Name="Hover"
        Background="{DynamicResource RigShift.Brush.HoverOverlay}"
        CornerRadius="{Binding Path=(controls:Interaction.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
        Opacity="0" />
      <ContentPresenter
        Margin="{TemplateBinding Padding}"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Center"
        TextElement.Foreground="{TemplateBinding Foreground}" />
      <!-- Pill of the selected row, 3 × 16, vertically centered like the WinUI navigation view; it grows in. -->
      <Rectangle
        x:Name="Bar"
        Width="3"
        Height="16"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        Fill="{DynamicResource RigShift.Brush.Accent}"
        RadiusX="1.5"
        RadiusY="1.5"
        RenderTransformOrigin="0.5,0.5"
        Visibility="Collapsed">
        <Rectangle.RenderTransform>
          <ScaleTransform x:Name="BarScale" />
        </Rectangle.RenderTransform>
      </Rectangle>
      <Border
        x:Name="Focus"
        BorderBrush="{DynamicResource RigShift.Brush.Accent}"
        BorderThickness="2"
        CornerRadius="{Binding Path=(controls:Interaction.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
        IsHitTestVisible="False"
        Visibility="Collapsed" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Fast}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.Selected}" />
        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
        <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.OnSelected}" />
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" From="0" To="1" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
      </Trigger>
      <Trigger Property="controls:Interaction.IsKeyboardFocusVisible" Value="True">
        <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- Master list row: 56 high, rounded, 8 in from the column edges, 2 apart; pill when selected. -->
  <Style x:Key="RigShift.ListRow" TargetType="ListBoxItem">
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="8,0,8,2" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="controls:Interaction.CornerRadius" Value="{DynamicResource RigShift.Radius.Row}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource RigShift.RowTemplate}" />
  </Style>
  <!-- Picker row (D-01): 48 high, the list's full width; selected = the row fill of the master lists. -->
  <Style x:Key="RigShift.PickerRow" TargetType="ListBoxItem" BasedOn="{StaticResource RigShift.ListRow}">
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <!-- Dialog foot: chrome surface under a line, actions on the right (D-01). -->
  <Style x:Key="RigShift.DialogFooter" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Chrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,16" />
  </Style>
  <!-- Navigation entry: 36 high, 6 radius, symbol 16 + text; the page sets the content. -->
  <Style x:Key="RigShift.NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource RigShift.ListRow}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
  </Style>

  <!-- Tray popup row (component TrayRow): 44 high for a profile, 36 for a game or an action; no border, radius 6. -->
  <Style x:Key="RigShift.TrayRow" TargetType="Button" BasedOn="{StaticResource RigShift.Button.Ghost}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="RigShift.TrayRow.Small" TargetType="Button" BasedOn="{StaticResource RigShift.TrayRow}">
    <Setter Property="Height" Value="36" />
  </Style>

  <!-- ===== Status line: dot + caption; the color never stands alone (R-COL-2) ===== -->
  <Style TargetType="controls:StatusLine">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="DotBrush" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:StatusLine">
          <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse
              Width="8"
              Height="8"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              Fill="{TemplateBinding DotBrush}" />
            <TextBlock
              Grid.Column="1"
              VerticalAlignment="Center"
              Foreground="{TemplateBinding Foreground}"
              Style="{StaticResource RigShift.Text.Caption}"
              Text="{TemplateBinding Text}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="NoWrap" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Ok">
        <Setter Property="DotBrush" Value="{DynamicResource RigShift.Brush.Ok}" />
      </Trigger>
      <Trigger Property="Kind" Value="Warn">
        <Setter Property="DotBrush" Value="{DynamicResource RigShift.Brush.Warn}" />
      </Trigger>
      <Trigger Property="Kind" Value="Error">
        <Setter Property="DotBrush" Value="{DynamicResource RigShift.Brush.Error}" />
        <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.Error}" />
      </Trigger>
      <Trigger Property="Kind" Value="Accent">
        <Setter Property="DotBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Info bar: 40 high, 3 px edge, symbol, text, optional action ===== -->
  <Style TargetType="controls:InfoBar">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="EdgeBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
    <Setter Property="Symbol" Value="Info16" />
    <Setter Property="Padding" Value="12,8,12,8" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:InfoBar">
          <Border
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RigShift.Radius.Control}"
            SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border
                Grid.Column="0"
                Margin="-1,-1,0,-1"
                Background="{TemplateBinding EdgeBrush}"
                CornerRadius="6,0,0,6" />
              <ui:SymbolIcon
                Grid.Column="1"
                Margin="12,0,10,0"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{TemplateBinding EdgeBrush}"
                Symbol="{TemplateBinding Symbol}" />
              <TextBlock
                Grid.Column="2"
                Margin="0,8,12,8"
                VerticalAlignment="Center"
                Foreground="{TemplateBinding Foreground}"
                Style="{StaticResource RigShift.Text.Body}"
                Text="{TemplateBinding Text}" />
              <ContentPresenter
                Grid.Column="3"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Content="{TemplateBinding Action}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Warn">
        <Setter Property="EdgeBrush" Value="{DynamicResource RigShift.Brush.Warn}" />
        <Setter Property="Symbol" Value="Warning16" />
      </Trigger>
      <Trigger Property="Kind" Value="Error">
        <Setter Property="EdgeBrush" Value="{DynamicResource RigShift.Brush.Error}" />
        <Setter Property="Symbol" Value="ErrorCircle16" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Setting row: 52 high card, title and caption left, the control right ===== -->
  <Style TargetType="controls:SettingRow">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingRow">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RigShift.Radius.Card}"
            SnapsToDevicePixels="True">
            <controls:AdaptiveColumns Gap="16">
              <StackPanel VerticalAlignment="Center" controls:AdaptiveColumns.MinColumnWidth="180">
                <TextBlock
                  Foreground="{TemplateBinding Foreground}"
                  Style="{StaticResource RigShift.Text.Body}"
                  Text="{TemplateBinding Title}"
                  TextWrapping="Wrap" />
                <TextBlock
                  x:Name="CaptionText"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{TemplateBinding Caption}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ContentPresenter VerticalAlignment="Center" />
            </controls:AdaptiveColumns>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Caption" Value="">
              <Setter TargetName="CaptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsCaptionError" Value="True">
              <Setter TargetName="CaptionText" Property="Foreground" Value="{DynamicResource RigShift.Brush.Error}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rows inside one card (a group of settings): no frame of their own, the card draws it; dividers go between. -->
  <Style x:Key="RigShift.SettingRow.Inner" TargetType="controls:SettingRow" BasedOn="{StaticResource {x:Type controls:SettingRow}}">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0,8" />
  </Style>
  <!-- Card that holds a group of rows: 16 to the sides, the rows bring their own height. -->
  <Style x:Key="RigShift.Card.Group" TargetType="Border" BasedOn="{StaticResource RigShift.Card}">
    <Setter Property="Padding" Value="16,4" />
  </Style>
  <!-- Head of a card group: symbol, title and an optional caption; the right slot takes the card's actions. -->
  <Style x:Key="RigShift.Text.CardTitle" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.BodyStrong}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Keys as keycaps ("Ctrl+Alt+F1", "Enter"): a thin frame with a heavier bottom edge, text face (T-01). -->
  <Style x:Key="RigShift.Keycap" TargetType="ContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border
            MinWidth="22"
            Height="22"
            Padding="7,0"
            Background="{DynamicResource RigShift.Brush.HoverOverlay}"
            BorderBrush="{DynamicResource RigShift.Brush.LineStrong}"
            BorderThickness="1,1,1,2"
            CornerRadius="4"
            SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Slider (B-05): 4 px rail, accent fill up to the thumb, 20 px thumb with an accent dot that grows on hover ===== -->
  <Style x:Key="RigShift.SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RigShift.SliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Ellipse
              Fill="{DynamicResource RigShift.Brush.Layer}"
              Stroke="{DynamicResource RigShift.Brush.LineStrong}"
              StrokeThickness="1" />
            <Ellipse
              x:Name="Dot"
              Width="12"
              Height="12"
              Fill="{DynamicResource RigShift.Brush.Accent}"
              RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DotScale" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1.17" Duration="{x:Static controls:Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1.17" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{x:Static controls:Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="DotScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource RigShift.Brush.AccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RigShift.Slider" TargetType="Slider">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center" Background="Transparent">
            <Border
              Height="4"
              Margin="10,0"
              Background="{DynamicResource RigShift.Brush.LineStrong}"
              CornerRadius="2" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton
                  x:Name="Fill"
                  Margin="10,0,-10,0"
                  Background="{DynamicResource RigShift.Brush.Accent}"
                  Command="Slider.DecreaseLarge"
                  Style="{StaticResource RigShift.SliderFill}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton
                  Background="Transparent"
                  Command="Slider.IncreaseLarge"
                  Style="{StaticResource RigShift.SliderFill}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource RigShift.SliderThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Save bar: 48 high at the bottom of a detail; Save is the primary while it shows (R-ACT-1) ===== -->
  <Style TargetType="controls:SaveBar">
    <Setter Property="Height" Value="48" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SaveBar">
          <Border
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="0,1,0,0"
            SnapsToDevicePixels="True">
            <DockPanel LastChildFill="False">
              <ui:SymbolIcon
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontSize="16"
                Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                Symbol="Info16" />
              <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Style="{StaticResource RigShift.Text.Body}"
                Text="{loc:Tr SaveBar_Unsaved}" />
              <StackPanel
                x:Name="Problems"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Horizontal">
                <ui:SymbolIcon
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  FontSize="14"
                  Foreground="{DynamicResource RigShift.Brush.Error}"
                  Symbol="ErrorCircle16" />
                <TextBlock
                  VerticalAlignment="Center"
                  Foreground="{DynamicResource RigShift.Brush.Error}"
                  Style="{StaticResource RigShift.Text.Body}"
                  Text="{TemplateBinding ProblemsText}" />
              </StackPanel>
              <Button
                Margin="8,0,0,0"
                Command="{TemplateBinding SaveCommand}"
                Content="{loc:Tr Common_Save}"
                DockPanel.Dock="Right"
                IsDefault="True"
                IsEnabled="{TemplateBinding CanSave}"
                Style="{StaticResource RigShift.Button.Primary}" />
              <Button
                Command="{TemplateBinding DiscardCommand}"
                Content="{loc:Tr Common_Discard}"
                DockPanel.Dock="Right"
                Style="{StaticResource RigShift.Button}" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="CanSave" Value="True">
              <Setter TargetName="Problems" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Tabs: 40 high, BodyStrong, 2 px accent underline; a red dot marks a tab with a validation problem (spec 7.3) ===== -->
  <Style x:Key="RigShift.Tabs" TargetType="TabControl">
    <Setter Property="controls:Motion.AnimateTabContent" Value="True" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
              Grid.Row="0"
              Padding="12,0"
              BorderBrush="{DynamicResource RigShift.Brush.Line}"
              BorderThickness="0,0,0,1"
              SnapsToDevicePixels="True">
              <ItemsPresenter KeyboardNavigation.TabNavigation="Once" />
            </Border>
            <!-- PART_SelectedContentHost: without the name, UI Automation does not see the tab content. -->
            <ContentPresenter
              x:Name="PART_SelectedContentHost"
              Grid.Row="1"
              ContentSource="SelectedContent"
              KeyboardNavigation.TabNavigation="Local" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RigShift.Tab" TargetType="TabItem">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Border
              x:Name="Hover"
              Margin="0,4,0,6"
              Background="{DynamicResource RigShift.Brush.HoverOverlay}"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              Opacity="0" />
            <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center">
              <ContentPresenter
                x:Name="Header"
                ContentSource="Header"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="Center" />
              <Ellipse
                x:Name="Dot"
                Width="6"
                Height="6"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Fill="{DynamicResource RigShift.Brush.Error}"
                Visibility="Collapsed" />
            </StackPanel>
            <Rectangle
              x:Name="Underline"
              Height="3"
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="Bottom"
              Fill="{DynamicResource RigShift.Brush.Accent}"
              RadiusX="1.5"
              RadiusY="1.5"
              RenderTransformOrigin="0.5,0.5"
              Visibility="Collapsed">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="UnderlineScale" />
              </Rectangle.RenderTransform>
            </Rectangle>
            <Border
              x:Name="Focus"
              Margin="0,4,0,6"
              BorderBrush="{DynamicResource RigShift.Brush.Accent}"
              BorderThickness="2"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" From="0.3" To="1" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="controls:Interaction.IsInvalid" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:Interaction.IsKeyboardFocusVisible" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Step variant (games): "1 Game → 2 Profile → …" – number in mono, arrow between the tabs (spec 7.3, TabStrip).
       The TabControl sets AlternationCount, so the first tab knows it has no arrow in front; the number is the Tag. -->
  <Style x:Key="RigShift.Tab.Step" TargetType="TabItem" BasedOn="{StaticResource RigShift.Tab}">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <!-- Column 0 is the separator: no background, so it takes no clicks and never carries hover or focus. -->
          <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon
              x:Name="Arrow"
              Grid.Column="0"
              Margin="4,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource RigShift.Brush.TextDisabled}"
              IsHitTestVisible="False"
              Symbol="ChevronRight12" />
            <Border Grid.Column="1" Background="Transparent" />
            <Border
              x:Name="Hover"
              Grid.Column="1"
              Margin="0,4,0,6"
              Background="{DynamicResource RigShift.Brush.HoverOverlay}"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              Opacity="0" />
            <StackPanel Grid.Column="1" Margin="{TemplateBinding Padding}" Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="NumberDisc" Stroke="{DynamicResource RigShift.Brush.LineStrong}" StrokeThickness="1" />
                <TextBlock
                  x:Name="Number"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  FontSize="11"
                  FontWeight="SemiBold"
                  Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                  Text="{TemplateBinding Tag}" />
              </Grid>
              <ContentPresenter
                x:Name="Header"
                ContentSource="Header"
                TextElement.Foreground="{TemplateBinding Foreground}"
                VerticalAlignment="Center" />
              <Ellipse
                x:Name="Dot"
                Width="6"
                Height="6"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Fill="{DynamicResource RigShift.Brush.Error}"
                Visibility="Collapsed" />
            </StackPanel>
            <Rectangle
              x:Name="Underline"
              Grid.Column="1"
              Height="3"
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="Bottom"
              Fill="{DynamicResource RigShift.Brush.Accent}"
              RadiusX="1.5"
              RadiusY="1.5"
              RenderTransformOrigin="0.5,0.5"
              Visibility="Collapsed">
              <Rectangle.RenderTransform>
                <ScaleTransform x:Name="UnderlineScale" />
              </Rectangle.RenderTransform>
            </Rectangle>
            <Border
              x:Name="Focus"
              Grid.Column="1"
              Margin="0,4,0,6"
              BorderBrush="{DynamicResource RigShift.Brush.Accent}"
              BorderThickness="2"
              CornerRadius="{DynamicResource RigShift.Radius.Control}"
              IsHitTestVisible="False"
              Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
              <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{x:Static controls:Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
              <Setter TargetName="NumberDisc" Property="Fill" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="NumberDisc" Property="Stroke" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource RigShift.Brush.OnAccent}" />
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="UnderlineScale" Storyboard.TargetProperty="ScaleX" From="0.3" To="1" Duration="{x:Static controls:Motion.Base}" EasingFunction="{x:Static controls:Motion.Standard}" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
            </Trigger>
            <Trigger Property="controls:Interaction.IsInvalid" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:Interaction.IsKeyboardFocusVisible" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Option cards (G-03): side by side, 216 wide; the chosen card carries a 2 px accent edge and a check badge. -->
  <Style x:Key="RigShift.OptionCards" TargetType="ListBox" BasedOn="{StaticResource RigShift.List}">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Width" Value="216" />
          <Setter Property="Margin" Value="0,0,12,12" />
          <Setter Property="Padding" Value="16,16,16,14" />
          <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Layer}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
          <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Grid>
                  <Border
                    x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RigShift.Radius.Card}"
                    SnapsToDevicePixels="True" />
                  <Border
                    x:Name="Ring"
                    BorderBrush="{DynamicResource RigShift.Brush.Accent}"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RigShift.Radius.Card}"
                    SnapsToDevicePixels="True"
                    Visibility="Collapsed" />
                  <ContentPresenter Margin="{TemplateBinding Padding}" />
                  <Grid
                    x:Name="Badge"
                    Width="20"
                    Height="20"
                    Margin="0,10,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <Ellipse Fill="{DynamicResource RigShift.Brush.Accent}" />
                    <ui:SymbolIcon FontSize="12" Foreground="{DynamicResource RigShift.Brush.OnAccent}" Symbol="Checkmark12" />
                  </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource RigShift.Brush.LayerHover}" />
                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.LineStrong}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Badge" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger Property="controls:Interaction.IsKeyboardFocusVisible" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Ring" Property="Margin" Value="-4" />
                    <Setter TargetName="Ring" Property="CornerRadius" Value="16" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Device chip (28 high): connected dot, name, remove (component DeviceChip). -->
  <Style x:Key="RigShift.DeviceChip" TargetType="Border">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0,2,0" />
    <Setter Property="Background" Value="{DynamicResource RigShift.Brush.LayerHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- "+ Device" (B-07): a chip of the same height, dashed because it is a slot to fill, not a device. -->
  <Style x:Key="RigShift.Button.AddChip" TargetType="Button">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RigShift.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Fill" Background="Transparent" CornerRadius="14" />
            <Rectangle
              x:Name="Edge"
              RadiusX="14"
              RadiusY="14"
              SnapsToDevicePixels="True"
              Stroke="{DynamicResource RigShift.Brush.LineStrong}"
              StrokeDashArray="3 2"
              StrokeThickness="1" />
            <ContentPresenter
              Margin="{TemplateBinding Padding}"
              VerticalAlignment="Center"
              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
              <Setter TargetName="Edge" Property="Stroke" Value="{DynamicResource RigShift.Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RigShift.Brush.PressedOverlay}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Progress line: 2 px, indeterminate, accent ===== -->
  <Style TargetType="controls:ProgressLine">
    <Setter Property="Height" Value="2" />
    <Setter Property="TrackBrush" Value="{DynamicResource RigShift.Brush.Line}" />
    <Setter Property="BarBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
  </Style>

  <!-- Tooltip (B-10): layer surface, 6 radius, a soft shadow, caption text; implicit, so every tooltip gets it. -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource RigShift.Font.Text}" />
    <Setter Property="FontSize" Value="12" />
    <!-- True keeps the popup transparent, so the margin around the card can carry the own shadow. -->
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Grid Margin="8,4,8,12">
            <Border Background="{DynamicResource RigShift.Brush.Chrome}" CornerRadius="6">
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.45" ShadowDepth="3" Color="Black" />
              </Border.Effect>
            </Border>
            <Border
              MaxWidth="360"
              Padding="10,6"
              Background="{DynamicResource RigShift.Brush.Layer}"
              BorderBrush="{DynamicResource RigShift.Brush.LineStrong}"
              BorderThickness="1"
              CornerRadius="6">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

<ui:FluentWindow
  x:Class="RigShift.App.Views.WindowCaptureWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr Capture_Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="660"
  Height="620"
  MinWidth="440"
  MinHeight="400"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Tr Capture_Title}" ShowMaximize="False" ShowMinimize="False" />

    <TextBlock
      Grid.Row="1"
      Margin="24,8,24,12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{loc:Tr Capture_Intro}"
      TextWrapping="Wrap" />

    <ListBox
      Grid.Row="2"
      Margin="24,0"
      AutomationProperties.Name="{loc:Tr Capture_Title}"
      ItemsSource="{Binding Windows}"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox Margin="0,2" IsChecked="{Binding IsChosen}">
            <StackPanel>
              <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
            </StackPanel>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="3" Margin="24,16,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding ChosenText}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Appearance="Primary"
          Click="OnSave"
          Content="{loc:Tr Capture_Save}"
          IsDefault="True"
          IsEnabled="{Binding CanSave}" />
        <ui:Button Content="{loc:Tr Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>

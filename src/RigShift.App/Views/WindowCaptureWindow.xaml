<ui:FluentWindow
  x:Class="RigShift.App.Views.WindowCaptureWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr Capture_Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  MinWidth="440"
  MaxHeight="680"
  Background="{DynamicResource RigShift.Brush.Page}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <!-- D-02: as tall as the list (room for five rows at least), one line per window with its size. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Height="32" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,0,24,12">
      <TextBlock Style="{StaticResource RigShift.Text.Subtitle}" Text="{loc:Tr Capture_Title}" />
      <TextBlock
        Margin="0,6,0,0"
        Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
        Style="{StaticResource RigShift.Text.Body}"
        Text="{loc:Tr Capture_Intro}"
        TextWrapping="Wrap" />
    </StackPanel>

    <ListBox
      Grid.Row="2"
      MinHeight="250"
      Margin="16,0"
      AutomationProperties.Name="{loc:Tr Capture_Title}"
      Background="Transparent"
      BorderThickness="0"
      HorizontalContentAlignment="Stretch"
      ItemContainerStyle="{StaticResource RigShift.PickerRow}"
      ItemsSource="{Binding Windows}"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsChosen}" Style="{StaticResource RigShift.Check}" ToolTip="{Binding Position}">
            <StackPanel Margin="4,0,0,0">
              <TextBlock Style="{StaticResource RigShift.Text.Body}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource RigShift.Text.Caption}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </CheckBox>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource RigShift.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            Click="OnSave"
            Content="{loc:Tr Capture_Save}"
            IsDefault="True"
            IsEnabled="{Binding CanSave}"
            Style="{StaticResource RigShift.Button.Primary}" />
          <Button Content="{loc:Tr Common_Cancel}" IsCancel="True" Style="{StaticResource RigShift.Button}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{Binding ChosenText}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

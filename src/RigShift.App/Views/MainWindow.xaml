<ui:FluentWindow
  x:Class="RigShift.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="1280"
  Height="780"
  MinWidth="1080"
  MinHeight="680"
  Background="{DynamicResource RigShift.Brush.Chrome}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: symbol 18 px + name, Windows convention (R-BRAND-1). -->
    <ui:TitleBar
      Grid.Row="0"
      Height="40"
      Title="RigShift"
      FontWeight="SemiBold"
      Foreground="{DynamicResource RigShift.Brush.TextPrimary}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon
          Width="18"
          Height="18"
          Source="{StaticResource RigShift.Image.AppMark}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- 2 px progress line while a switch runs (spec 7.3, F2 phase 1). -->
    <controls:ProgressLine
      x:Name="Progress"
      Grid.Row="1"
      Visibility="Collapsed" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="NavColumn" Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation: four pages on top, settings and help at the bottom (R-NAV-1), then the app's state (N-02).
           Below 1200 px, or on request, only the symbols stay (N-01). -->
      <DockPanel Grid.Column="0" Margin="8">
        <Button
          x:Name="NavToggle"
          Margin="2,0,0,6"
          HorizontalAlignment="Left"
          Click="OnNavToggleClick"
          DockPanel.Dock="Top"
          Style="{StaticResource RigShift.Button.Icon}">
          <ui:SymbolIcon x:Name="NavToggleIcon" FontSize="16" Symbol="PanelLeftContract16" />
        </Button>

        <!-- State: the active profile, paused rules. -->
        <Border
          x:Name="NavFooter"
          Margin="0,6,0,0"
          Padding="12,10,8,2"
          BorderBrush="{DynamicResource RigShift.Brush.Line}"
          BorderThickness="0,1,0,0"
          DockPanel.Dock="Bottom">
          <DockPanel>
            <ui:SymbolIcon
              x:Name="PausedIcon"
              Margin="6,0,0,0"
              DockPanel.Dock="Right"
              FontSize="14"
              Foreground="{DynamicResource RigShift.Brush.Warn}"
              Symbol="Pause16"
              Visibility="Collapsed" />
            <Ellipse
              x:Name="ActiveDot"
              Width="8"
              Height="8"
              Margin="0,0,8,0"
              VerticalAlignment="Center"
              DockPanel.Dock="Left"
              Fill="{DynamicResource RigShift.Brush.TextDisabled}" />
            <TextBlock
              x:Name="ActiveText"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
              TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <ListBox
          x:Name="NavBottom"
          DockPanel.Dock="Bottom"
          ItemContainerStyle="{StaticResource RigShift.NavItem}"
          SelectionChanged="OnNavSelectionChanged"
          Style="{StaticResource RigShift.List}" />
        <ListBox
          x:Name="NavTop"
          DockPanel.Dock="Top"
          ItemContainerStyle="{StaticResource RigShift.NavItem}"
          SelectionChanged="OnNavSelectionChanged"
          Style="{StaticResource RigShift.List}" />
        <Border />
      </DockPanel>

      <!-- Page surface: lighter than the chrome, rounded at the top left. -->
      <Border
        Grid.Column="1"
        Background="{DynamicResource RigShift.Brush.Page}"
        BorderBrush="{DynamicResource RigShift.Brush.Line}"
        BorderThickness="1,1,0,0"
        ClipToBounds="True"
        CornerRadius="8,0,0,0"
        SnapsToDevicePixels="True">
        <Frame
          x:Name="PageHost"
          Focusable="False"
          JournalOwnership="OwnsJournal"
          NavigationUIVisibility="Hidden" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>

<ui:FluentWindow
  x:Class="RigShift.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="1280"
  Height="780"
  MinWidth="1080"
  MinHeight="680"
  Background="{DynamicResource RigShift.Brush.Chrome}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen"
>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: symbol 18 px + name, Windows convention (R-BRAND-1). -->
    <ui:TitleBar
      Grid.Row="0"
      Height="40"
      Title="RigShift"
      FontWeight="SemiBold"
      Foreground="{DynamicResource RigShift.Brush.TextPrimary}">
      <ui:TitleBar.Icon>
        <ui:ImageIcon
          Width="18"
          Height="18"
          Source="{StaticResource RigShift.Image.AppMark}" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- 2 px progress line while a switch runs (spec 7.3, F2 phase 1). -->
    <controls:ProgressLine
      x:Name="Progress"
      Grid.Row="1"
      Visibility="Collapsed" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation: five entries, settings and help at the bottom (R-NAV-1). -->
      <DockPanel Grid.Column="0" Margin="8,8,8,8">
        <ListBox
          x:Name="NavBottom"
          DockPanel.Dock="Bottom"
          ItemContainerStyle="{StaticResource RigShift.NavItem}"
          SelectionChanged="OnNavSelectionChanged"
          Style="{StaticResource RigShift.List}" />
        <ListBox
          x:Name="NavTop"
          DockPanel.Dock="Top"
          ItemContainerStyle="{StaticResource RigShift.NavItem}"
          SelectionChanged="OnNavSelectionChanged"
          Style="{StaticResource RigShift.List}" />
        <Border />
      </DockPanel>

      <!-- Page surface: lighter than the chrome, rounded at the top left. -->
      <Border
        Grid.Column="1"
        Background="{DynamicResource RigShift.Brush.Page}"
        BorderBrush="{DynamicResource RigShift.Brush.Line}"
        BorderThickness="1,1,0,0"
        ClipToBounds="True"
        CornerRadius="8,0,0,0"
        SnapsToDevicePixels="True">
        <Frame
          x:Name="PageHost"
          Focusable="False"
          JournalOwnership="OwnsJournal"
          NavigationUIVisibility="Hidden" />
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>

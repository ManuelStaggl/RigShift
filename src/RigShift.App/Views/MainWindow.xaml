<ui:FluentWindow
  x:Class="RigShift.App.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:pages="clr-namespace:RigShift.App.Views.Pages"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="980"
  Height="660"
  MinWidth="720"
  MinHeight="480"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="RigShift">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/Brand/rigshift-app-light.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView
      x:Name="RootNavigation"
      Grid.Row="1"
      PaneDisplayMode="Left"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleVisible="False"
      OpenPaneLength="220">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem
          Content="{loc:Tr Nav_Profiles}"
          Icon="{ui:SymbolIcon Layer24}"
          TargetPageType="{x:Type pages:ProfilesPage}" />
        <ui:NavigationViewItem
          Content="{loc:Tr Nav_Displays}"
          Icon="{ui:SymbolIcon DesktopMac24}"
          TargetPageType="{x:Type pages:DisplaysPage}" />
        <ui:NavigationViewItem
          Content="{loc:Tr Nav_Automation}"
          Icon="{ui:SymbolIcon Flash24}"
          TargetPageType="{x:Type pages:AutomationPage}" />
        <ui:NavigationViewItem
          Content="{loc:Tr Nav_About}"
          Icon="{ui:SymbolIcon Info24}"
          TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem
          Content="{loc:Tr Nav_Settings}"
          Icon="{ui:SymbolIcon Settings24}"
          TargetPageType="{x:Type pages:SettingsPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>

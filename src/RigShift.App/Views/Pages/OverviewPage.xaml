<Page
  x:Class="RigShift.App.Views.Pages.OverviewPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  d:DataContext="{d:DesignInstance vm:OverviewViewModel}"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="{DynamicResource RigShift.Brush.Page}">
  <Page.Resources>
    <!-- Profile tile (O-01): the picture, the name with its hotkey or "Active", and the switch button. -->
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource RigShift.Card}">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
          <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Selected}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSwitchTarget}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A list row inside a card: hover surface, divider above all but the first. -->
    <Style x:Key="CardRow" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter Property="BorderThickness" Value="0" />
        </DataTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource RigShift.Brush.HoverOverlay}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- The game's symbol at 32 px: a picked one, else its own icon, else the generic glyph. -->
    <DataTemplate x:Key="GameGlyph" DataType="{x:Type vm:GameItem}">
      <Border Width="32" Height="32" Background="{DynamicResource RigShift.Brush.HoverOverlay}" CornerRadius="6" ClipToBounds="True">
        <Grid>
          <controls:ProfileIcon
            Width="18"
            Height="18"
            IconKey="{Binding IconKey}"
            TextElement.Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
          <Image
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="{Binding GameIcon}"
            Stretch="UniformToFill"
            Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisibility}}" />
          <ui:SymbolIcon
            FontSize="18"
            Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
            Symbol="Games20"
            Visibility="{Binding HasFallbackIcon, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,20,32,24" MaxWidth="1200">
      <TextBlock Style="{StaticResource RigShift.Text.PageTitle}" Text="{loc:Tr Nav_Overview}" />

      <controls:InfoBar
        Margin="0,12,0,0"
        Kind="Error"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <!-- Live picture: what Windows shows right now. -->
      <ContentControl Margin="0,20,0,0" Style="{StaticResource RigShift.TopologyPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource RigShift.Text.Caption}">
              <Run Text="{loc:Tr Overview_Now}" /><Run Text=" · " /><Run Foreground="{DynamicResource RigShift.Brush.TextPrimary}" Text="{Binding ActiveName, Mode=OneWay}" />
            </TextBlock>
            <Button
              Height="28"
              Command="{Binding IdentifyCommand}"
              Content="{loc:Tr Displays_Identify}"
              DockPanel.Dock="Right"
              Style="{StaticResource RigShift.Button}"
              ToolTip="{loc:Tr Displays_IdentifyTip}" />
          </DockPanel>
          <controls:DisplayTopology
            Grid.Row="1"
            Height="190"
            Margin="0,8,0,0"
            Displays="{Binding LiveTopology}"
            Size="M"
            Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}" />
          <TextBlock
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource RigShift.Text.Body}"
            Text="{loc:Tr Overview_Empty}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </ContentControl>

      <!-- First start: no profiles yet -->
      <Border
        Width="360"
        Margin="0,24,0,0"
        HorizontalAlignment="Left"
        Style="{StaticResource RigShift.Card}"
        Visibility="{Binding HasProfiles, Converter={StaticResource InverseBoolToVisibility}}">
        <StackPanel>
          <TextBlock Style="{StaticResource RigShift.Text.BodyStrong}" Text="{loc:Tr Overview_SetupTitle}" />
          <TextBlock
            Margin="0,4,0,12"
            Style="{StaticResource RigShift.Text.Caption}"
            Text="{loc:Tr Overview_SetupText}"
            TextWrapping="Wrap" />
          <Button
            HorizontalAlignment="Stretch"
            Command="{Binding SetupAssistantCommand}"
            Content="{loc:Tr Overview_SetupStart}"
            Style="{StaticResource RigShift.Button.Primary}" />
          <Button
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Command="{Binding SetupManuallyCommand}"
            Content="{loc:Tr Overview_SetupManual}"
            Style="{StaticResource RigShift.Button.Ghost}" />
        </StackPanel>
      </Border>

      <!-- Profiles (O-01): the tray tiles, large. The active one says so and offers "Apply again". -->
      <StackPanel Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
        <DockPanel Margin="0,24,0,10">
          <Button
            Height="28"
            Padding="8,0"
            Command="{Binding SaveCurrentCommand}"
            DockPanel.Dock="Right"
            Style="{StaticResource RigShift.Button.Ghost}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Add16" />
              <TextBlock Text="{loc:Tr Overview_SaveCurrent}" />
            </StackPanel>
          </Button>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Nav_Profiles}" />
        </DockPanel>
        <ItemsControl
          Margin="0,0,-12,-12"
          Focusable="False"
          IsEnabled="{Binding Coordinator.IsIdle}"
          ItemsSource="{Binding Catalog.Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileItem}">
              <Border Style="{StaticResource Tile}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Border
                    Height="96"
                    Padding="8,6"
                    Background="{DynamicResource RigShift.Brush.Chrome}"
                    CornerRadius="{DynamicResource RigShift.Radius.Control}">
                    <controls:DisplayTopology Displays="{Binding Topology}" IsHitTestVisible="False" ShowLabels="False" Size="M" />
                  </Border>
                  <DockPanel Grid.Row="1" Margin="0,12,0,0">
                    <Grid Margin="12,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                      <!-- Secondary: the overview has no single main action (R-ACT-1); the tooltip names missing displays. -->
                      <Button
                        Height="28"
                        Padding="12,0"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Content="{loc:Tr Overview_Switch}"
                        Style="{StaticResource RigShift.Button}"
                        ToolTip="{Binding ReadyTip}"
                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                      <Button
                        Height="28"
                        Padding="12,0"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        Content="{loc:Tr Profile_Reapply}"
                        Style="{StaticResource RigShift.Button}"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock
                        Style="{StaticResource RigShift.Text.BodyStrong}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding Name}" />
                      <Grid Margin="0,2,0,0">
                        <controls:StatusLine
                          Kind="Active"
                          Text="{loc:Tr Profile_Active}"
                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        <!-- A required display is off: say which and what to do, as the profile list does (U-10). -->
                        <controls:StatusLine
                          Kind="{Binding ReadyKind}"
                          Text="{Binding ReadyText}"
                          ToolTip="{Binding ReadyTip}"
                          Visibility="{Binding ShowsReadiness, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap"
                          Visibility="{Binding ShowsHotkeyLine, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Caption}">
                              <Setter Property="Text" Value="{Binding HotkeyText}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HotkeyText}" Value="">
                                  <Setter Property="Text" Value="{loc:Tr Overview_NoHotkey}" />
                                  <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPlaceholder}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </StackPanel>
                  </DockPanel>
                  <controls:ProgressLine
                    Grid.Row="1"
                    Height="3"
                    Margin="0,0,0,-8"
                    VerticalAlignment="Bottom"
                    Visibility="{Binding IsSwitchTarget, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Games: start with their profile. -->
      <StackPanel Visibility="{Binding Games.HasGames, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Margin="0,24,0,10" Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Nav_Games}" />
        </StackPanel>
        <Border Padding="0" ClipToBounds="True" Style="{StaticResource RigShift.Card}">
          <ItemsControl Focusable="False" IsEnabled="{Binding Coordinator.IsIdle}" ItemsSource="{Binding Games.Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:GameItem}">
                <Border Height="56" Style="{StaticResource CardRow}">
                  <DockPanel>
                    <Grid Margin="12,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right">
                      <Button
                        Height="28"
                        Padding="10,0"
                        AutomationProperties.Name="{Binding PlayText}"
                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding CanPlay}"
                        Style="{StaticResource RigShift.Button}"
                        ToolTip="{Binding HotkeyText}"
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Filled="True" Symbol="Play16" />
                          <TextBlock Text="{loc:Tr Game_Play}" />
                        </StackPanel>
                      </Button>
                      <controls:StatusLine
                        Kind="Ok"
                        Text="{loc:Tr Game_Running}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ContentPresenter VerticalAlignment="Center" Content="{Binding}" ContentTemplate="{StaticResource GameGlyph}" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RigShift.Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <TextBlock Style="{StaticResource RigShift.Text.Caption}" Text="{Binding SourceText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Displays (O-03): a status list; the name reads as text and becomes a field on hover. Enter or leaving saves. -->
      <TextBlock Margin="0,24,0,10" Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Overview_Displays}" />
      <Border Padding="0" ClipToBounds="True" Style="{StaticResource RigShift.Card}">
        <StackPanel>
          <Grid Height="32" Margin="12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="*" MinWidth="110" />
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" MinWidth="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{loc:Tr Overview_ColDisplay}" />
            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{loc:Tr Overview_ColName}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{loc:Tr Overview_ColStatus}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{loc:Tr Overview_ColMode}" />
            <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{loc:Tr Overview_ColProfiles}" />
          </Grid>
          <ItemsControl Focusable="False" ItemsSource="{Binding Displays}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:DisplayCard}">
                <Border Height="44" BorderThickness="0,1,0,0" Style="{StaticResource CardRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" MinWidth="110" />
                      <ColumnDefinition Width="200" />
                      <ColumnDefinition Width="190" />
                      <ColumnDefinition Width="160" />
                      <ColumnDefinition Width="*" MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <!-- Number as the round badge of the picture; a dashed ring for a display Windows does not use. -->
                    <Border
                      x:Name="Badge"
                      MinWidth="20"
                      Height="20"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource RigShift.Brush.HoverOverlay}"
                      CornerRadius="10">
                      <!-- The side margin turns the disc into a pill for a number in the hundreds (remote session). -->
                      <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
                        Text="{Binding Number}" />
                    </Border>
                    <Ellipse
                      x:Name="NoBadge"
                      Width="20"
                      Height="20"
                      HorizontalAlignment="Left"
                      Stroke="{DynamicResource RigShift.Brush.LineStrong}"
                      StrokeDashArray="2 2"
                      Visibility="Collapsed" />
                    <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Body}" Text="{Binding ModelName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ModelName}" />
                    <TextBox
                      Grid.Column="2"
                      Margin="0,0,16,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{loc:Tr Overview_ColName}"
                      KeyDown="OnNameKeyDown"
                      LostFocus="OnNameLostFocus"
                      MaxLength="40"
                      Style="{StaticResource RigShift.Field.Inline}"
                      Tag="{loc:Tr Overview_NamePlaceholder}"
                      Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{loc:Tr Overview_DisplaysHint}" />
                    <controls:StatusLine Grid.Column="3" Margin="0,0,16,0" VerticalAlignment="Center" Kind="{Binding StateKind}" Text="{Binding StateText}" />
                    <TextBlock Grid.Column="4" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{Binding ModeText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ModeText}" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{Binding ProfilesText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ProfilesText}" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Number}" Value="{x:Null}">
                    <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="NoBadge" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Recent switches: same wording as the toast (R-FLOW-2). -->
      <StackPanel Margin="0,24,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Overview_History}" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding History}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryRow}">
              <Border Height="32" Style="{StaticResource RigShift.Divider}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Caption}" Text="{Binding TimeText}" />
                  <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.Body}" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <controls:StatusLine Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" Kind="{Binding Kind}" Text="{Binding ResultText}" />
                  <TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource RigShift.Text.ValueSecondary}" Text="{Binding DurationText}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

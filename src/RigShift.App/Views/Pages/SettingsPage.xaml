<Page
  x:Class="RigShift.App.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Background="{DynamicResource RigShift.Brush.Page}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,20,32,24" MaxWidth="1200">
      <TextBlock Style="{StaticResource RigShift.Text.PageTitle}" Text="{loc:Tr Nav_Settings}" />

      <controls:InfoBar
        Margin="0,12,0,0"
        Kind="Error"
        Text="{Binding Devices.ErrorMessage}"
        Visibility="{Binding Devices.HasError, Converter={StaticResource BoolToVisibility}}" />
      <controls:InfoBar
        Margin="0,12,0,0"
        Kind="Error"
        Text="{Binding ErrorMessage}"
        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

      <controls:AdaptiveColumns Margin="0,20,0,0" Gap="32">

        <!-- Left column: switching and the app itself -->
        <StackPanel controls:AdaptiveColumns.MinColumnWidth="424">
          <TextBlock Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Settings_GroupSwitching}" />

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_DefaultProfileHint}"
            Title="{loc:Tr Settings_DefaultProfile}">
            <ComboBox
              Width="220"
              AutomationProperties.Name="{loc:Tr Settings_DefaultProfile}"
              DisplayMemberPath="Name"
              ItemsSource="{Binding ProfileChoices}"
              SelectedItem="{Binding SelectedDefaultProfile}"
              Style="{StaticResource RigShift.Select}" />
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{Binding ToggleHotkeyHint}"
            Title="{loc:Tr Settings_ToggleHotkey}">
            <StackPanel Orientation="Horizontal">
              <TextBox
                Width="180"
                AutomationProperties.HelpText="{loc:Tr Hotkey_RecordTip}"
                AutomationProperties.Name="{loc:Tr Settings_ToggleHotkey}"
                controls:HotkeyBox.Field="{Binding}"
                IsReadOnly="True"
                IsReadOnlyCaretVisible="False"
                Style="{StaticResource RigShift.Field.Value}"
                Text="{Binding ToggleHotkeyText, Mode=OneWay}"
                ToolTip="{loc:Tr Hotkey_RecordTip}" />
              <Button
                Margin="8,0,0,0"
                AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
                Command="{Binding ClearHotkeyCommand}"
                IsEnabled="{Binding HasToggleHotkey}"
                Style="{StaticResource RigShift.Button.Icon}"
                ToolTip="{loc:Tr Editor_HotkeyClear}">
                <ui:SymbolIcon FontSize="16" Symbol="Dismiss16" />
              </Button>
            </StackPanel>
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_AllOnHotkeyHint}"
            Title="{loc:Tr Settings_AllOnHotkey}">
            <ContentControl
              AutomationProperties.Name="{Binding AllDisplaysOnHotkeyText}"
              Content="{Binding AllDisplaysOnHotkeyText}"
              Style="{StaticResource RigShift.Keycap}" />
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_ConfirmHint}"
            Title="{loc:Tr Settings_ConfirmTimeout}">
            <ui:ToggleSwitch
              AutomationProperties.Name="{loc:Tr Settings_ConfirmTimeout}"
              IsChecked="{Binding ConfirmEnabled}"
              Style="{StaticResource RigShift.Toggle}" />
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_ConfirmSecondsHint}"
            Title="{loc:Tr Settings_ConfirmSeconds}">
            <ui:NumberBox
              Width="100"
              AutomationProperties.Name="{loc:Tr Settings_ConfirmSeconds}"
              ClearButtonEnabled="False"
              IsEnabled="{Binding ConfirmEnabled}"
              MaxDecimalPlaces="0"
              Maximum="120"
              Minimum="1"
              SmallChange="1"
              SpinButtonPlacementMode="Hidden"
              Style="{StaticResource RigShift.Number}"
              Value="{Binding ConfirmTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
          </controls:SettingRow>

          <TextBlock Margin="0,24,0,0" Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Settings_GroupApp}" />

          <controls:SettingRow Margin="0,8,0,0" Title="{loc:Tr Settings_Autostart}">
            <ui:ToggleSwitch
              AutomationProperties.Name="{loc:Tr Settings_Autostart}"
              IsChecked="{Binding StartWithWindows}"
              Style="{StaticResource RigShift.Toggle}" />
          </controls:SettingRow>

          <controls:SettingRow Margin="0,8,0,0" Title="{loc:Tr Settings_Language}">
            <ComboBox
              Width="220"
              AutomationProperties.Name="{loc:Tr Settings_Language}"
              DisplayMemberPath="Name"
              ItemsSource="{Binding LanguageChoices}"
              SelectedItem="{Binding SelectedLanguage}"
              Style="{StaticResource RigShift.Select}" />
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_AutoUpdateHint}"
            Title="{loc:Tr Settings_AutoUpdate}"
            Visibility="{Binding ShowUpdateSetting, Converter={StaticResource BoolToVisibility}}">
            <ui:ToggleSwitch
              AutomationProperties.Name="{loc:Tr Settings_AutoUpdate}"
              IsChecked="{Binding InstallUpdatesAutomatically}"
              Style="{StaticResource RigShift.Toggle}" />
          </controls:SettingRow>

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_DetailedLogHint}"
            Title="{loc:Tr Settings_DetailedLog}">
            <ui:ToggleSwitch
              AutomationProperties.Name="{loc:Tr Settings_DetailedLog}"
              IsChecked="{Binding DetailedLogging}"
              Style="{StaticResource RigShift.Toggle}" />
          </controls:SettingRow>
        </StackPanel>

        <!-- Right column: the USB devices rules and profiles use; names are saved on Enter or on leaving (F6). -->
        <StackPanel controls:AdaptiveColumns.MinColumnWidth="424">
          <TextBlock Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Settings_GroupDevices}" />

          <controls:SettingRow
            Margin="0,8,0,0"
            Caption="{loc:Tr Settings_PauseRulesHint}"
            Title="{loc:Tr Settings_PauseRules}">
            <ui:ToggleSwitch
              AutomationProperties.Name="{loc:Tr Settings_PauseRules}"
              IsChecked="{Binding Devices.IsPaused}"
              Style="{StaticResource RigShift.Toggle}" />
          </controls:SettingRow>

          <ItemsControl Focusable="False" ItemsSource="{Binding Devices.NamedDevices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:UsbNameCard}">
                <Border Margin="0,8,0,0" MinHeight="52" Padding="16,8" Style="{StaticResource RigShift.Card}">
                  <controls:AdaptiveColumns Gap="16">
                    <StackPanel VerticalAlignment="Center" controls:AdaptiveColumns.MinColumnWidth="150">
                      <!-- Name and state; the VID/PID only as the tooltip (E-04). -->
                      <TextBlock
                        Style="{StaticResource RigShift.Text.Body}"
                        Text="{Binding WindowsName}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTip="{Binding Id}" />
                      <controls:StatusLine Margin="0,2,0,0" Kind="{Binding StateKind}" Text="{Binding StateText}" ToolTip="{Binding Id}" />
                    </StackPanel>
                    <Grid Width="180" VerticalAlignment="Center">
                      <TextBox
                        AutomationProperties.HelpText="{Binding WindowsName}"
                        AutomationProperties.Name="{loc:Tr Editor_CustomName}"
                        KeyDown="OnDeviceNameKeyDown"
                        LostFocus="OnDeviceNameLostFocus"
                        MaxLength="40"
                        Style="{StaticResource RigShift.Field}"
                        Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
                      <!-- The empty field would not say what it is for; the hint sits behind the text. -->
                      <TextBlock
                        Margin="11,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource RigShift.Brush.TextPlaceholder}"
                        IsHitTestVisible="False"
                        Style="{StaticResource RigShift.Text.Body}"
                        Text="{loc:Tr Editor_CustomName}">
                        <TextBlock.Visibility>
                          <Binding Path="CustomName">
                            <Binding.Converter>
                              <controls:EmptyToVisibilityConverter />
                            </Binding.Converter>
                          </Binding>
                        </TextBlock.Visibility>
                      </TextBlock>
                    </Grid>
                  </controls:AdaptiveColumns>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock
            Margin="0,12,0,0"
            Style="{StaticResource RigShift.Text.Caption}"
            Text="{loc:Tr Settings_DevicesHint}"
            TextWrapping="Wrap" />
        </StackPanel>
      </controls:AdaptiveColumns>
    </StackPanel>
  </ScrollViewer>
</Page>

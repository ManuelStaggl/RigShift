<Page
  x:Class="RigShift.App.Views.Pages.SettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr Nav_Settings}"
  ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Style="{StaticResource PageContent}">
      <ui:TextBlock Margin="0,0,0,16" Style="{StaticResource PageTitle}" Text="{loc:Tr Nav_Settings}" />

      <!-- Headers as wrapping TextBlocks: a plain string header is cut off in a narrow window (analysis finding I-09). -->
      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Star24, FontSize=20}">
        <ui:CardControl.Header>
          <TextBlock Text="{loc:Tr Settings_DefaultProfile}" TextWrapping="Wrap" />
        </ui:CardControl.Header>
        <ComboBox
          MinWidth="200"
          AutomationProperties.Name="{loc:Tr Settings_DefaultProfile}"
          DisplayMemberPath="Name"
          ItemsSource="{Binding ProfileChoices}"
          SelectedItem="{Binding SelectedDefaultProfile}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24, FontSize=20}">
        <ui:CardControl.Header>
          <TextBlock Text="{loc:Tr Settings_Autostart}" TextWrapping="Wrap" />
        </ui:CardControl.Header>
        <ui:ToggleSwitch AutomationProperties.Name="{loc:Tr Settings_Autostart}" IsChecked="{Binding StartWithWindows}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Window24, FontSize=20}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_ConfirmTimeout}" TextWrapping="Wrap" />
            <TextBlock controls:LiveRegion.IsLive="True" Style="{StaticResource Caption}" Text="{Binding ConfirmHint}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:NumberBox
            Width="120"
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{loc:Tr Settings_ConfirmSeconds}"
            ClearButtonEnabled="False"
            MaxDecimalPlaces="0"
            Maximum="120"
            Minimum="1"
            SmallChange="1"
            ToolTip="{loc:Tr Settings_ConfirmSeconds}"
            IsEnabled="{Binding ConfirmEnabled}"
            Value="{Binding ConfirmTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
          <!-- The box shows a bare number; without the unit it is anyone's guess what it counts. -->
          <TextBlock
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Tr Common_Seconds}" />
          <ui:ToggleSwitch VerticalAlignment="Center" AutomationProperties.Name="{loc:Tr Settings_ConfirmTimeout}" IsChecked="{Binding ConfirmEnabled}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSwap24, FontSize=20}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_ToggleHotkey}" TextWrapping="Wrap" />
            <TextBlock controls:LiveRegion.IsLive="True" Style="{StaticResource Caption}" Text="{Binding ToggleHotkeyHint}" />
          </StackPanel>
        </ui:CardControl.Header>
        <StackPanel Orientation="Horizontal">
          <ui:TextBox
            Width="200"
            AutomationProperties.HelpText="{loc:Tr Hotkey_RecordTip}"
            AutomationProperties.Name="{loc:Tr Settings_ToggleHotkey}"
            ClearButtonEnabled="False"
            GotKeyboardFocus="OnToggleHotkeyGotFocus"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            LostKeyboardFocus="OnToggleHotkeyLostFocus"
            PlaceholderText="{loc:Tr Editor_HotkeyPlaceholder}"
            PreviewKeyDown="OnToggleHotkeyKeyDown"
            Text="{Binding ToggleHotkeyText, Mode=OneWay}"
            ToolTip="{loc:Tr Hotkey_RecordTip}" />
          <ui:Button
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
            Command="{Binding ClearToggleHotkeyCommand}"
            Icon="{ui:SymbolIcon Dismiss24}"
            IsEnabled="{Binding HasToggleHotkey}"
            ToolTip="{loc:Tr Editor_HotkeyClear}" />
        </StackPanel>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LocalLanguage24, FontSize=20}">
        <ui:CardControl.Header>
          <TextBlock Text="{loc:Tr Settings_Language}" TextWrapping="Wrap" />
        </ui:CardControl.Header>
        <ComboBox
          MinWidth="200"
          AutomationProperties.Name="{loc:Tr Settings_Language}"
          DisplayMemberPath="Name"
          ItemsSource="{Binding LanguageChoices}"
          SelectedItem="{Binding SelectedLanguage}" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowDownload24, FontSize=20}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="{loc:Tr Settings_AutoUpdate}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr Settings_AutoUpdateHint}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch AutomationProperties.Name="{loc:Tr Settings_AutoUpdate}" IsChecked="{Binding InstallUpdatesAutomatically}" />
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</Page>

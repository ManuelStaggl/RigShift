<Page
  x:Class="RigShift.App.Views.Pages.DisplaysPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr Nav_Displays}"
  ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Style="{StaticResource PageContent}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Nav_Displays}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding IdentifyCommand}" Content="{loc:Tr Displays_Identify}" ToolTip="{loc:Tr Displays_IdentifyTip}" />
          <ui:Button Command="{Binding RefreshCommand}" Content="{loc:Tr Displays_Refresh}" />
        </StackPanel>
      </Grid>
      <TextBlock Margin="0,4,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Displays_Hint}" TextWrapping="Wrap" />

      <ui:InfoBar
        Margin="0,0,0,16"
        IsClosable="False"
        IsOpen="{Binding HasError, Mode=OneWay}"
        Message="{Binding ErrorMessage}"
        Severity="Error"
        controls:LiveRegion.IsLive="True" />

      <ui:InfoBar
        Margin="0,0,0,16"
        IsClosable="False"
        IsOpen="{Binding IsEmpty, Mode=OneWay}"
        Message="{loc:Tr Displays_Empty}"
        Severity="Informational" />

      <ItemsControl Focusable="False" ItemsSource="{Binding Displays}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Header>
                <Grid ToolTip="{Binding ProfilesText}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- The Windows number in place of an icon, as "Identify" shows it on the screen. -->
                  <Border
                    Width="28"
                    Height="28"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="14">
                    <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding NumberText}"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="{Binding NumberText}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding DetailsText}" />
                  </StackPanel>
                </Grid>
              </ui:CardControl.Header>
              <ui:TextBox
                Width="200"
                AutomationProperties.HelpText="{Binding ModelName}"
                AutomationProperties.Name="{loc:Tr Editor_CustomName}"
                KeyDown="OnNameKeyDown"
                LostFocus="OnNameLostFocus"
                MaxLength="40"
                PlaceholderText="{loc:Tr Editor_CustomNamePlaceholder}"
                Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
            </ui:CardControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>

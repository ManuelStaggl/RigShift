<Page
  x:Class="RigShift.App.Views.Pages.GamesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:GamesViewModel}"
  Title="{loc:Tr Nav_Games}"
  Background="{DynamicResource RigShift.Brush.Page}"
  FocusManager.IsFocusScope="False">
  <Page.InputBindings>
    <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding AddInstalledCommand}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding PlayCommand}" Gesture="Ctrl+Enter" />
  </Page.InputBindings>
  <Page.Resources>
    <!-- The game's symbol: a picked one, else its own icon, else the generic glyph (component ListRow). -->
    <DataTemplate x:Key="GameGlyph" DataType="{x:Type vm:GameItem}">
      <Grid>
        <controls:ProfileIcon
          IconKey="{Binding IconKey}"
          IsFilled="{Binding IsRunning}"
          TextElement.Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
          Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
        <Image
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="{Binding GameIcon}"
          Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisibility}}" />
        <ui:SymbolIcon
          FontSize="20"
          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
          Symbol="Games20"
          Visibility="{Binding HasFallbackIcon, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Master list (R-NAV-2, R-ACT-4, R-ACT-5) ===== -->
    <Border
      Grid.Column="0"
      BorderBrush="{DynamicResource RigShift.Brush.Line}"
      BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Column head (B-01): the list's title and a compact "New" with its menu. -->
        <DockPanel Height="52" Margin="16,0,12,0" DockPanel.Dock="Top">
          <Button
            x:Name="NewButton"
            Height="32"
            Padding="10,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{loc:Tr List_New}"
            Click="OnNewClick"
            DockPanel.Dock="Right"
            Style="{StaticResource RigShift.Button}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Symbol="Add16" />
              <TextBlock VerticalAlignment="Center" Text="{loc:Tr List_New}" />
              <ui:SymbolIcon Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource RigShift.Brush.TextSecondary}" Symbol="ChevronDown12" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding AddInstalledCommand}" Header="{loc:Tr List_NewInstalled}">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Search16" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding AddProgramCommand}" Header="{loc:Tr List_NewProgram}">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Apps16" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RigShift.Text.Section}"
            Text="{loc:Tr Nav_Games}" />
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource RigShift.Divider}" />
        <ListBox
          x:Name="List"
          AutomationProperties.Name="{loc:Tr Nav_Games}"
          ItemsSource="{Binding Items}"
          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
          Style="{StaticResource RigShift.List}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RigShift.ListRow}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GameItem}">
              <DockPanel>
                <ContentControl
                  Width="24"
                  Height="24"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Content="{Binding}"
                  ContentTemplate="{StaticResource GameGlyph}"
                  DockPanel.Dock="Left"
                  Focusable="False"
                  IsTabStop="False" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock
                    Style="{StaticResource RigShift.Text.BodyStrong}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                  <controls:StatusLine
                    Margin="0,2,0,0"
                    Kind="{Binding ListKind}"
                    Text="{Binding ListStatus}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Detail ===== -->
    <Grid Grid.Column="1">
      <!-- Empty (X-01): the games on this PC are one click away. -->
      <StackPanel
        MaxWidth="460"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
        <Border
          Width="96"
          Height="96"
          HorizontalAlignment="Center"
          Background="{DynamicResource RigShift.Brush.Chrome}"
          BorderBrush="{DynamicResource RigShift.Brush.Line}"
          BorderThickness="1"
          CornerRadius="48">
          <ui:SymbolIcon FontSize="44" Foreground="{DynamicResource RigShift.Brush.Accent}" Symbol="Games24" />
        </Border>
        <TextBlock
          Margin="0,20,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.Subtitle}"
          Text="{loc:Tr Games_EmptyTitle}" />
        <TextBlock
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.Body}"
          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
          Text="{loc:Tr Games_EmptyText}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <Button AutomationProperties.Name="{loc:Tr Games_Scan}" Command="{Binding AddInstalledCommand}" Style="{StaticResource RigShift.Button.Primary}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,8,0" FontSize="14" Symbol="Search16" />
              <TextBlock Text="{loc:Tr Games_Scan}" />
            </StackPanel>
          </Button>
          <Button
            Margin="8,0,0,0"
            Command="{Binding AddProgramCommand}"
            Content="{loc:Tr List_NewProgram}"
            Style="{StaticResource RigShift.Button.Ghost}" />
        </StackPanel>
      </StackPanel>

      <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:InfoBar
          Grid.Row="0"
          Margin="24,12,24,0"
          Kind="Warn"
          Text="{Binding Catalog.UnreadableMessage}"
          Visibility="{Binding Catalog.IsUnreadable, Converter={StaticResource BoolToVisibility}}" />

        <!-- Head (72): symbol 40, name (F2), hotkey chip, status line; actions right (R-ACT-1…3). -->
        <Border
          Grid.Row="1"
          BorderBrush="{DynamicResource RigShift.Brush.Line}"
          BorderThickness="0,0,0,1">
          <Grid Height="72" Margin="24,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
              x:Name="IconButton"
              Width="40"
              Height="40"
              Margin="0,0,16,0"
              Padding="0"
              VerticalAlignment="Center"
              AutomationProperties.Name="{loc:Tr Editor_Icon}"
              Click="OnIconClick"
              Style="{StaticResource RigShift.Button.Icon}"
              ToolTip="{loc:Tr Editor_Icon}">
              <Grid Width="28" Height="28">
                <controls:ProfileIcon
                  IconKey="{Binding Editor.SelectedIcon.Key}"
                  TextElement.Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
                  Visibility="{Binding SelectedItem.HasIcon, Converter={StaticResource BoolToVisibility}}" />
                <Image
                  RenderOptions.BitmapScalingMode="HighQuality"
                  Source="{Binding SelectedItem.GameIcon}"
                  Visibility="{Binding SelectedItem.HasGameIcon, Converter={StaticResource BoolToVisibility}}" />
                <ui:SymbolIcon
                  FontSize="24"
                  Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                  Symbol="Games24"
                  Visibility="{Binding SelectedItem.HasFallbackIcon, Converter={StaticResource BoolToVisibility}}" />
              </Grid>
              <Button.ContextMenu>
                <ContextMenu ItemsSource="{Binding IconChoices}">
                  <ContextMenu.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                      <Setter Property="Header" Value="{Binding Name}" />
                      <Setter Property="Command" Value="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                      <Setter Property="Icon">
                        <Setter.Value>
                          <controls:ProfileIcon Width="16" Height="16" IconKey="{Binding Key}" />
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ContextMenu.ItemContainerStyle>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <DockPanel LastChildFill="False">
                <ContentControl
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Content="{Binding Editor.HotkeyText}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource RigShift.Chip.Value}"
                  Visibility="{Binding Editor.HasHotkey, Converter={StaticResource BoolToVisibility}}" />
                <TextBox
                  x:Name="NameBox"
                  MinWidth="160"
                  MaxWidth="480"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{loc:Tr Editor_Name}"
                  DockPanel.Dock="Left"
                  MaxLength="60"
                  Style="{StaticResource RigShift.Field.Title}"
                  Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="{loc:Tr Editor_Name}"
                  controls:Interaction.IsInvalid="{Binding Editor.HasNameProblem}" />
                <!-- The name is a field: a pencil shows it on hover (P-02). -->
                <ui:SymbolIcon
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  DockPanel.Dock="Left"
                  FontSize="16"
                  Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                  IsHitTestVisible="False"
                  Symbol="Edit16">
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, ElementName=NameBox}" Value="True" />
                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=NameBox}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </DockPanel>
              <controls:StatusLine
                Margin="0,4,0,0"
                Kind="{Binding HeadStatusKind}"
                Text="{Binding HeadStatusText}"
                Visibility="{Binding Editor.HasNameProblem, Converter={StaticResource InverseBoolToVisibility}}"
                controls:LiveRegion.IsLive="True" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource RigShift.Text.FieldError}"
                Text="{Binding Editor.NameProblem}"
                Visibility="{Binding Editor.HasNameProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel
              Grid.Column="2"
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              Orientation="Horizontal">
              <!-- Save is the primary action while the save bar is visible; Play steps back (R-ACT-1). -->
              <Button
                Margin="0,0,8,0"
                Command="{Binding PlayCommand}"
                Content="{Binding PlayLabel}"
                Style="{StaticResource RigShift.Button.Primary}"
                ToolTip="{loc:Tr Detail_PlayTip}"
                Visibility="{Binding Editor.IsDirty, Converter={StaticResource InverseBoolToVisibility}}" />
              <Button
                Margin="0,0,8,0"
                Command="{Binding PlayCommand}"
                Content="{Binding PlayLabel}"
                Style="{StaticResource RigShift.Button}"
                ToolTip="{loc:Tr Detail_PlayTip}"
                Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
              <Button
                AutomationProperties.Name="{loc:Tr Profile_More}"
                Click="OnMoreClick"
                Style="{StaticResource RigShift.Button.IconOutlined}"
                ToolTip="{loc:Tr Profile_More}">
                <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal16" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding CreateShortcutCommand}" Header="{loc:Tr Profile_ShortcutMenu}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Link16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                      Command="{Binding DeleteCommand}"
                      Foreground="{DynamicResource RigShift.Brush.Error}"
                      Header="{loc:Tr Profile_Delete}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource RigShift.Brush.Error}" Symbol="Delete16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- The game changed on disk under unsaved changes (a learned process name): they stay, the saved version is one click away. -->
        <StackPanel Grid.Row="2">
          <controls:InfoBar
            Margin="24,12,24,0"
            Kind="Warn"
            Text="{loc:Tr Detail_ChangedElsewhere}"
            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}"
            controls:LiveRegion.IsLive="True">
            <controls:InfoBar.Action>
              <Button
                Height="28"
                Command="{Binding ReloadCommand}"
                Content="{loc:Tr Detail_Reload}"
                Style="{StaticResource RigShift.Button.Ghost}"
                ToolTip="{loc:Tr Detail_ReloadTip}" />
            </controls:InfoBar.Action>
          </controls:InfoBar>

          <!-- Session results and store errors (R-FLOW-2); after "not recognised" the bar leads to the Game tab. -->
          <controls:InfoBar
            Margin="24,12,24,0"
            Kind="{Binding DetailKind}"
            Text="{Binding DetailMessage}"
            Visibility="{Binding HasDetailMessage, Converter={StaticResource BoolToVisibility}}"
            controls:LiveRegion.IsLive="True">
            <controls:InfoBar.Action>
              <StackPanel Orientation="Horizontal">
                <Button
                  Height="28"
                  Margin="0,0,8,0"
                  Command="{Binding ShowGameTabCommand}"
                  Content="{loc:Tr Game_OpenGameTab}"
                  Style="{StaticResource RigShift.Button.Ghost}"
                  Visibility="{Binding DetailOffersGameTab, Converter={StaticResource BoolToVisibility}}" />
                <Button
                  Height="28"
                  Width="28"
                  AutomationProperties.Name="{loc:Tr Common_Close}"
                  Command="{Binding CloseDetailMessageCommand}"
                  Style="{StaticResource RigShift.Button.Icon}"
                  ToolTip="{loc:Tr Common_Close}">
                  <ui:SymbolIcon FontSize="12" Symbol="Dismiss12" />
                </Button>
              </StackPanel>
            </controls:InfoBar.Action>
          </controls:InfoBar>
        </StackPanel>

        <!-- Tabs = the run of a session, numbered with arrows (F5). -->
        <TabControl
          x:Name="Tabs"
          Grid.Row="3"
          Margin="0,4,0,0"
          AlternationCount="5"
          SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
          Style="{StaticResource RigShift.Tabs}">

          <!-- 1 Game -->
          <TabItem
            Header="{loc:Tr GameTab_Game}"
            Style="{StaticResource RigShift.Tab.Step}"
            Tag="1"
            controls:Interaction.IsInvalid="{Binding Editor.HasGameTabProblem}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Game_GameIntro}" />
                <!-- What starts: the picked game or program with "Choose…" in one card. -->
                <Border Padding="16,12">
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RigShift.Card}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLaunchProblem}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Error}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <DockPanel>
                    <Button
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      Command="{Binding DataContext.PickGameCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      Content="{loc:Tr Game_Choose}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource RigShift.Button}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource RigShift.Text.Body}" Text="{loc:Tr Game_Launch}" />
                      <DockPanel Margin="0,2,0,0" Visibility="{Binding HasLaunch, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Content="{Binding LaunchKindText}"
                          DockPanel.Dock="Left"
                          Style="{StaticResource RigShift.Chip}" />
                        <TextBlock
                          VerticalAlignment="Center"
                          Style="{StaticResource RigShift.Text.ValueSecondary}"
                          Text="{Binding LaunchText}"
                          TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding LaunchText}" />
                      </DockPanel>
                      <TextBlock
                        Style="{StaticResource RigShift.Text.Caption}"
                        Text="{loc:Tr Game_LaunchPlaceholder}"
                        Visibility="{Binding HasLaunch, Converter={StaticResource InverseBoolToVisibility}}" />
                      <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource RigShift.Text.FieldError}"
                        Text="{Binding LaunchProblem}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasLaunchProblem, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>

                <!-- How RigShift knows the session runs and when it ends. -->
                <Border Margin="0,8,0,0" Style="{StaticResource RigShift.Card.Group}">
                  <StackPanel>
                    <controls:SettingRow
                      Caption="{Binding ProcessHint}"
                      IsCaptionError="{Binding ProcessHintIsError}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Game_ProcessName}">
                      <TextBox
                        Width="240"
                        AutomationProperties.HelpText="{Binding ProcessHint}"
                        AutomationProperties.Name="{loc:Tr Game_ProcessName}"
                        Style="{StaticResource RigShift.Field.Value}"
                        Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{loc:Tr Game_ProcessLearned}"
                        controls:Interaction.IsInvalid="{Binding ProcessHintIsError}" />
                    </controls:SettingRow>
                    <Border Style="{StaticResource RigShift.Divider}" />
                    <controls:SettingRow Style="{StaticResource RigShift.SettingRow.Inner}" Title="{loc:Tr Game_EndsWith}">
                      <ComboBox
                        Width="240"
                        AutomationProperties.Name="{loc:Tr Game_EndsWith}"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding EndChoices}"
                        SelectedItem="{Binding SelectedEnd}"
                        Style="{StaticResource RigShift.Select}" />
                    </controls:SettingRow>
                    <StackPanel Visibility="{Binding NeedsLauncherProcess, Converter={StaticResource BoolToVisibility}}">
                      <Border Style="{StaticResource RigShift.Divider}" />
                      <controls:SettingRow
                        Caption="{loc:Tr Game_LauncherProcessHint}"
                        Style="{StaticResource RigShift.SettingRow.Inner}"
                        Title="{loc:Tr Game_LauncherProcess}">
                        <TextBox
                          Width="240"
                          AutomationProperties.HelpText="{loc:Tr Game_LauncherProcessHint}"
                          AutomationProperties.Name="{loc:Tr Game_LauncherProcess}"
                          Style="{StaticResource RigShift.Field.Value}"
                          Text="{Binding LauncherProcessName, UpdateSourceTrigger=PropertyChanged}" />
                      </controls:SettingRow>
                    </StackPanel>
                    <Border Style="{StaticResource RigShift.Divider}" />
                    <controls:SettingRow
                      Caption="{loc:Tr Game_StartWithGameHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Game_StartWithGame}">
                      <ui:ToggleSwitch
                        AutomationProperties.Name="{loc:Tr Game_StartWithGame}"
                        IsChecked="{Binding StartWithGame}"
                        Style="{StaticResource RigShift.Toggle}" />
                    </controls:SettingRow>
                  </StackPanel>
                </Border>

                <!-- Everything that starts the session, as on the profile's Triggers tab. -->
                <TextBlock Margin="0,24,0,8" Style="{StaticResource RigShift.Text.Section}" Text="{loc:Tr Tab_Triggers}" />
                <controls:SettingRow Title="{loc:Tr Editor_Hotkey}">
                  <controls:SettingRow.Style>
                    <Style TargetType="controls:SettingRow" BasedOn="{StaticResource {x:Type controls:SettingRow}}">
                      <Setter Property="Caption" Value="{Binding HotkeyHint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHotkeyProblem}" Value="True">
                          <Setter Property="Caption" Value="{Binding HotkeyProblem}" />
                          <Setter Property="IsCaptionError" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:SettingRow.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBox
                      Width="200"
                      AutomationProperties.HelpText="{loc:Tr Hotkey_RecordTip}"
                      AutomationProperties.Name="{loc:Tr Editor_Hotkey}"
                      controls:HotkeyBox.Field="{Binding}"
                      IsReadOnly="True"
                      IsReadOnlyCaretVisible="False"
                      Style="{StaticResource RigShift.Field.Value}"
                      Text="{Binding HotkeyText, Mode=OneWay}"
                      ToolTip="{loc:Tr Hotkey_RecordTip}"
                      controls:Interaction.IsInvalid="{Binding HasHotkeyProblem}" />
                    <Button
                      Margin="8,0,0,0"
                      AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
                      Command="{Binding ClearHotkeyCommand}"
                      IsEnabled="{Binding HasHotkey}"
                      Style="{StaticResource RigShift.Button.Icon}"
                      ToolTip="{loc:Tr Editor_HotkeyClear}">
                      <ui:SymbolIcon FontSize="16" Symbol="Dismiss16" />
                    </Button>
                  </StackPanel>
                </controls:SettingRow>
                <Border Margin="0,8,0,0" Style="{StaticResource RigShift.Card.Group}">
                  <StackPanel>
                    <controls:SettingRow
                      Caption="{loc:Tr Game_ShortcutHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Trigger_Shortcut}">
                      <Button
                        Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        Style="{StaticResource RigShift.Button}">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Link16" />
                          <TextBlock Text="{loc:Tr Trigger_ShortcutCreate}" />
                        </StackPanel>
                      </Button>
                    </controls:SettingRow>
                    <Border Style="{StaticResource RigShift.Divider}" />
                    <controls:SettingRow
                      Caption="{loc:Tr Trigger_CommandHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Trigger_Command}">
                      <StackPanel Orientation="Horizontal">
                        <TextBox
                          Width="240"
                          AutomationProperties.Name="{loc:Tr Trigger_Command}"
                          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                          IsReadOnly="True"
                          Style="{StaticResource RigShift.Field.Value}"
                          Text="{Binding CommandText, Mode=OneWay}"
                          ToolTip="{Binding CommandText, Mode=OneWay}" />
                        <Button
                          Margin="8,0,0,0"
                          AutomationProperties.Name="{loc:Tr Trigger_Copy}"
                          Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          Style="{StaticResource RigShift.Button.Icon}"
                          ToolTip="{loc:Tr Trigger_Copy}">
                          <ui:SymbolIcon FontSize="16" Symbol="Copy16" />
                        </Button>
                      </StackPanel>
                    </controls:SettingRow>
                  </StackPanel>
                </Border>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <!-- 2 Profile -->
          <TabItem Header="{loc:Tr GameTab_Profile}" Style="{StaticResource RigShift.Tab.Step}" Tag="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Game_ProfileIntro}" />
                <ListBox
                  AutomationProperties.Name="{loc:Tr GameTab_Profile}"
                  ItemsSource="{Binding ProfileOptions}"
                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                  Style="{StaticResource RigShift.OptionCards}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileOption}">
                      <StackPanel>
                        <!-- The arrangement as picture; "switch nothing" gets a symbol of its own in the same place. -->
                        <Grid Height="48" Margin="0,0,0,12">
                          <controls:DisplayTopology
                            Displays="{Binding Topology}"
                            Size="S"
                            Visibility="{Binding HasTopology, Converter={StaticResource BoolToVisibility}}" />
                          <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="32"
                            Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                            Symbol="Desktop24"
                            Visibility="{Binding HasTopology, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                        <TextBlock
                          Style="{StaticResource RigShift.Text.BodyStrong}"
                          Text="{Binding Name}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                        <TextBlock
                          Style="{StaticResource RigShift.Text.Caption}"
                          Text="{Binding Sub}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap"
                          ToolTip="{Binding Sub}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <!-- 3 Tools -->
          <TabItem
            Header="{loc:Tr GameTab_Tools}"
            Style="{StaticResource RigShift.Tab.Step}"
            Tag="3"
            controls:Interaction.IsInvalid="{Binding Editor.HasAppsProblem}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Game_ToolsIntro}"
                  TextWrapping="Wrap" />
                <ContentPresenter Content="{Binding AppList}" />
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <!-- 4 Windows -->
          <TabItem Header="{loc:Tr GameTab_Windows}" Style="{StaticResource RigShift.Tab.Step}" Tag="4">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Game_WindowsHint}"
                  TextWrapping="Wrap" />
                <controls:SettingRow Caption="{Binding WindowsText}" Title="{loc:Tr Game_WindowsTitle}">
                  <StackPanel Orientation="Horizontal">
                    <Button
                      Command="{Binding ClearWindowsCommand}"
                      Content="{loc:Tr Common_Clear}"
                      Style="{StaticResource RigShift.Button.Ghost}"
                      Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}" />
                    <Button
                      Margin="8,0,0,0"
                      Command="{Binding DataContext.CaptureWindowsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      Content="{loc:Tr Game_CaptureWindows}"
                      Style="{StaticResource RigShift.Button}" />
                  </StackPanel>
                </controls:SettingRow>

                <!-- What was captured, one line per window (G-05). -->
                <Border
                  Margin="0,8,0,0"
                  Padding="0"
                  ClipToBounds="True"
                  Style="{StaticResource RigShift.Card}"
                  Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl Focusable="False" ItemsSource="{Binding SavedWindows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:SavedWindowRow}">
                        <Border x:Name="Row" Height="52" Padding="16,0" BorderBrush="{DynamicResource RigShift.Brush.Line}" BorderThickness="0,1,0,0" ToolTip="{Binding Position}">
                          <DockPanel>
                            <ui:SymbolIcon
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              FontSize="16"
                              Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                              Symbol="Window16" />
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Style="{StaticResource RigShift.Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Style="{StaticResource RigShift.Text.Caption}" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                            <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <!-- 5 End -->
          <TabItem Header="{loc:Tr GameTab_End}" Style="{StaticResource RigShift.Tab.Step}" Tag="5">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Game_EndIntro}" />
                <controls:SettingRow Title="{loc:Tr Game_ExitLabel}">
                  <ComboBox
                    Width="260"
                    AutomationProperties.Name="{loc:Tr Game_ExitLabel}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding ExitChoices}"
                    SelectedItem="{Binding SelectedExit}"
                    Style="{StaticResource RigShift.Select}" />
                </controls:SettingRow>
                <controls:SettingRow
                  Margin="0,8,0,0"
                  Caption="{loc:Tr Game_StopAppsHint}"
                  Title="{loc:Tr Game_StopApps}">
                  <ui:ToggleSwitch
                    AutomationProperties.Name="{loc:Tr Game_StopApps}"
                    IsChecked="{Binding StopApps}"
                    Style="{StaticResource RigShift.Toggle}" />
                </controls:SettingRow>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- "'X' saved", three seconds. -->
        <TextBlock
          Grid.Row="4"
          Height="28"
          Margin="24,0"
          VerticalAlignment="Center"
          LineHeight="28"
          Style="{StaticResource RigShift.Text.Caption}"
          Text="{Binding StatusMessage}"
          Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"
          controls:LiveRegion.IsLive="True" />

        <controls:SaveBar
          Grid.Row="5"
          DiscardCommand="{Binding DiscardCommand}"
          ProblemCount="{Binding Editor.ProblemCount}"
          SaveCommand="{Binding SaveCommand}"
          Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>
  </Grid>
</Page>

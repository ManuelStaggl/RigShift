<Page
  x:Class="RigShift.App.Views.Pages.GamesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr Nav_Games}"
  ScrollViewer.CanContentScroll="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Style="{StaticResource PageContent}">
      <!-- Same header as the other pages: title left, actions right. -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr Nav_Games}" />
        <!-- Standard, not primary: the one accent per view belongs on "Play" (analysis findings G-03, G-04). -->
        <ui:Button Grid.Column="1" Command="{Binding AddCommand}" Content="{loc:Tr Games_Add}" />
      </Grid>

      <TextBlock
        Margin="0,0,0,16"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Games_Intro}"
        TextWrapping="Wrap" />

      <ui:InfoBar
        Margin="0,0,0,16"
        controls:LiveRegion.IsLive="True"
        IsClosable="True"
        IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
        Message="{Binding StatusMessage}"
        Severity="{Binding StatusSeverity}" />

      <ui:InfoBar
        Margin="0,0,0,16"
        Title="{loc:Tr Games_EmptyTitle}"
        IsClosable="False"
        IsOpen="{Binding Catalog.IsEmpty}"
        Message="{Binding Catalog.EmptyMessage}"
        Severity="Informational" />

      <ui:InfoBar
        Margin="0,0,0,16"
        Title="{loc:Tr Profiles_UnreadableTitle}"
        IsClosable="False"
        IsOpen="{Binding Catalog.IsUnreadable}"
        Message="{Binding Catalog.UnreadableMessage}"
        Severity="Warning" />

      <ItemsControl Focusable="False" ItemsSource="{Binding Catalog.Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- One action on the card, "Play"; everything else in the "…" menu, as on the profile page. -->
            <ui:Card Margin="0,0,0,4" Padding="16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:ProfileIcon
                  Width="24"
                  Height="24"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  IconKey="{Binding IconKey}"
                  IsFilled="{Binding IsRunning}"
                  TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ui:TextBlock
                    FontTypography="Subtitle"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Name}" />
                  <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SourceText}" />
                </StackPanel>

                <ui:Button
                  Grid.Column="2"
                  Margin="12,0,8,0"
                  VerticalAlignment="Center"
                  Appearance="Primary"
                  AutomationProperties.HelpText="{Binding Name}"
                  Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                  CommandParameter="{Binding}"
                  Content="{loc:Tr Game_Play}"
                  IsEnabled="{Binding CanPlay}" />
                <ui:Button
                  Grid.Column="3"
                  VerticalAlignment="Stretch"
                  AutomationProperties.HelpText="{Binding Name}"
                  AutomationProperties.Name="{loc:Tr Profile_More}"
                  Click="OnMoreClick"
                  Icon="{ui:SymbolIcon MoreHorizontal24}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                  ToolTip="{loc:Tr Profile_More}">
                  <ui:Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem
                        Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        CommandParameter="{Binding}"
                        Header="{loc:Tr Profile_Edit}"
                        Icon="{ui:SymbolIcon Edit24}" />
                      <MenuItem
                        Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        CommandParameter="{Binding}"
                        Header="{loc:Tr Profile_Duplicate}"
                        Icon="{ui:SymbolIcon Copy24}" />
                      <Separator />
                      <MenuItem
                        Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                        CommandParameter="{Binding}"
                        Header="{loc:Tr Profile_Delete}"
                        Icon="{ui:SymbolIcon Delete24}" />
                    </ContextMenu>
                  </ui:Button.ContextMenu>
                </ui:Button>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
                  <Grid Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl VerticalAlignment="Center" Focusable="False" ItemsSource="{Binding AppIcons}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Image Width="16" Height="16" Margin="0,0,6,0" Source="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                      Grid.Column="1"
                      AutomationProperties.Name="{loc:Tr Editor_Apps}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="{Binding AppsLine}"
                      TextWrapping="Wrap" />
                  </Grid>

                  <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon
                      Margin="0,0,6,0"
                      FontSize="16"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Symbol="WindowAd24" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding WindowsLine}" />
                  </StackPanel>

                  <TextBlock
                    Margin="0,8,0,0"
                    controls:LiveRegion.IsLive="True"
                    Style="{StaticResource StatusText}"
                    Text="{Binding StatusText}" />
                </StackPanel>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>

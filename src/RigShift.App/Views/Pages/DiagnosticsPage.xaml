<Page
  x:Class="RigShift.App.Views.Pages.DiagnosticsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="Diagnostics">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,8,24,24">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock VerticalAlignment="Center" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Nav_Diagnostics}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="{loc:Tr Diag_Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
          <ui:Button Command="{Binding OpenLogFolderCommand}" Content="{loc:Tr Settings_OpenLogs}" Icon="{ui:SymbolIcon FolderOpen24}" />
        </StackPanel>
      </Grid>

      <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />

      <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Diag_Displays}" />
      <DataGrid Margin="0,0,0,24" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding Displays}">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{loc:Tr Diag_Name}" />
          <DataGridTextColumn Binding="{Binding State}" Header="{loc:Tr Diag_State}" />
          <DataGridTextColumn Binding="{Binding Mode}" Header="{loc:Tr Diag_Mode}" />
          <DataGridTextColumn Binding="{Binding Edid}" Header="{loc:Tr Diag_Edid}" />
          <DataGridTextColumn Binding="{Binding TargetPath}" Header="{loc:Tr Diag_Path}" />
          <DataGridTextColumn Binding="{Binding AdapterPath}" Header="{loc:Tr Diag_Adapter}" />
        </DataGrid.Columns>
      </DataGrid>

      <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Diag_Audio}" />
      <DataGrid Margin="0,0,0,24" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding AudioDevices}">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Name}" Header="{loc:Tr Diag_Name}" />
          <DataGridTextColumn Binding="{Binding Direction}" Header="{loc:Tr Diag_Direction}" />
          <DataGridTextColumn Binding="{Binding State}" Header="{loc:Tr Diag_State}" />
        </DataGrid.Columns>
      </DataGrid>

      <ui:TextBlock Margin="0,0,0,8" FontTypography="Subtitle" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Diag_History}" />
      <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding History}">
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding At, StringFormat=HH:mm:ss}" Header="{loc:Tr Diag_Time}" />
          <DataGridTextColumn Binding="{Binding ProfileName}" Header="{loc:Tr Diag_Profile}" />
          <DataGridTextColumn Binding="{Binding OutcomeText}" Header="{loc:Tr Diag_Result}" />
          <DataGridTextColumn Binding="{Binding Duration.TotalSeconds, StringFormat={}{0:0.0} s}" Header="{loc:Tr Diag_Duration}" />
          <DataGridTextColumn Binding="{Binding Details}" Header="{loc:Tr Diag_Details}" />
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</Page>

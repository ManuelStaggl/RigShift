<Page
  x:Class="RigShift.App.Views.Pages.ProfilesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:ProfilesViewModel}"
  Title="{loc:Tr Nav_Profiles}"
  Background="{DynamicResource RigShift.Brush.Page}"
  FocusManager.IsFocusScope="False">
  <Page.InputBindings>
    <KeyBinding Command="{Binding SaveCommand}" Gesture="Ctrl+S" />
    <KeyBinding Command="{Binding NewFromCurrentCommand}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding SwitchCommand}" Gesture="Ctrl+Enter" />
  </Page.InputBindings>
  <Page.Resources>
    <!-- One-off texts are hidden while empty. -->
    <Style x:Key="OptionalCaption" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Caption}">
      <Setter Property="Margin" Value="0,8,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A device kind as a card: the device on top, its volume below as a switch with a slider (B-05). -->
    <DataTemplate x:Key="AudioSlotTemplate" DataType="{x:Type vm:AudioSlot}">
      <Border Margin="0,0,0,8" Style="{StaticResource RigShift.Card.Group}">
        <StackPanel>
          <controls:SettingRow Style="{StaticResource RigShift.SettingRow.Inner}" Title="{Binding Label}">
            <ComboBox
              Width="300"
              AutomationProperties.Name="{Binding Label}"
              DisplayMemberPath="Name"
              ItemsSource="{Binding Choices}"
              SelectedItem="{Binding Selected}"
              Style="{StaticResource RigShift.Select}" />
          </controls:SettingRow>
          <StackPanel IsEnabled="{Binding HasDevice}" Visibility="{Binding SupportsVolume, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource RigShift.Divider}" />
            <controls:SettingRow Style="{StaticResource RigShift.SettingRow.Inner}" Title="{loc:Tr Audio_SetVolume}">
              <StackPanel Orientation="Horizontal">
                <Slider
                  Width="200"
                  VerticalAlignment="Center"
                  AutomationProperties.HelpText="{Binding Label}"
                  AutomationProperties.Name="{loc:Tr Audio_SetVolume}"
                  IsEnabled="{Binding SetVolume}"
                  IsSnapToTickEnabled="True"
                  LargeChange="10"
                  Maximum="100"
                  Minimum="0"
                  SmallChange="1"
                  Style="{StaticResource RigShift.Slider}"
                  TickFrequency="1"
                  Value="{Binding Volume}" />
                <TextBlock
                  Width="48"
                  VerticalAlignment="Center"
                  Style="{StaticResource RigShift.Text.Body}"
                  Text="{Binding VolumeText}"
                  TextAlignment="Right"
                  Typography.NumeralAlignment="Tabular" />
                <ui:ToggleSwitch
                  Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  AutomationProperties.HelpText="{Binding Label}"
                  AutomationProperties.Name="{loc:Tr Audio_SetVolume}"
                  IsChecked="{Binding SetVolume}"
                  Style="{StaticResource RigShift.Toggle}" />
              </StackPanel>
            </controls:SettingRow>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Master list (R-NAV-2, R-ACT-4, R-ACT-5) ===== -->
    <Border
      Grid.Column="0"
      BorderBrush="{DynamicResource RigShift.Brush.Line}"
      BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Column head (B-01): the list's title and a compact "New" with its menu. -->
        <DockPanel Height="52" Margin="16,0,12,0" DockPanel.Dock="Top">
          <Button
            x:Name="NewButton"
            Height="32"
            Padding="10,0"
            VerticalAlignment="Center"
            AutomationProperties.Name="{loc:Tr List_New}"
            Click="OnNewClick"
            DockPanel.Dock="Right"
            Style="{StaticResource RigShift.Button}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="16" Symbol="Add16" />
              <TextBlock VerticalAlignment="Center" Text="{loc:Tr List_New}" />
              <ui:SymbolIcon Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource RigShift.Brush.TextSecondary}" Symbol="ChevronDown12" />
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding NewFromCurrentCommand}" Header="{loc:Tr List_NewFromCurrent}">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="DesktopArrowDown16" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding SetupAssistantCommand}" Header="{loc:Tr List_Assistant}">
                  <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Wand16" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource RigShift.Text.Section}"
            Text="{loc:Tr Nav_Profiles}" />
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource RigShift.Divider}" />
        <ListBox
          x:Name="List"
          AutomationProperties.Name="{loc:Tr Nav_Profiles}"
          ItemsSource="{Binding Items}"
          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
          Style="{StaticResource RigShift.List}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RigShift.ListRow}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileItem}">
              <DockPanel>
                <controls:DisplayTopology
                  Width="64"
                  Height="28"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Displays="{Binding Topology}"
                  DockPanel.Dock="Left"
                  Size="S" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock
                    Style="{StaticResource RigShift.Text.BodyStrong}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                  <controls:StatusLine
                    Margin="0,2,0,0"
                    Kind="{Binding ListKind}"
                    Text="{Binding ListStatus}" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Detail ===== -->
    <Grid Grid.Column="1">
      <!-- Empty (X-01): nothing selected only while there are no profiles – the displays of right now as the invitation. -->
      <StackPanel
        MaxWidth="460"
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
        <ContentControl Width="420" Height="170" Style="{StaticResource RigShift.TopologyPanel}">
          <controls:DisplayTopology Displays="{Binding CurrentTopology}" IsHitTestVisible="False" Size="M" />
        </ContentControl>
        <TextBlock
          Margin="0,20,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.Subtitle}"
          Text="{loc:Tr Profiles_EmptyTitle}" />
        <TextBlock
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.Body}"
          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
          Text="{loc:Tr Profiles_EmptyInvite}"
          TextAlignment="Center"
          TextWrapping="Wrap" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <Button Command="{Binding NewFromCurrentCommand}" Content="{loc:Tr Profiles_EmptySave}" Style="{StaticResource RigShift.Button.Primary}" />
          <Button
            Margin="8,0,0,0"
            Command="{Binding SetupAssistantCommand}"
            Content="{loc:Tr Overview_SetupStart}"
            Style="{StaticResource RigShift.Button.Ghost}" />
        </StackPanel>
      </StackPanel>

      <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:InfoBar
          Grid.Row="0"
          Margin="24,12,24,0"
          Kind="Warn"
          Text="{Binding Catalog.UnreadableFilesMessage}"
          Visibility="{Binding Catalog.HasUnreadableFiles, Converter={StaticResource BoolToVisibility}}" />

        <!-- Head (72): picture S, name (F2), chips, status line; actions right (R-ACT-1…3). -->
        <Border
          Grid.Row="1"
          BorderBrush="{DynamicResource RigShift.Brush.Line}"
          BorderThickness="0,0,0,1">
          <Grid Height="72" Margin="24,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <DockPanel LastChildFill="False">
                <Button
                  x:Name="IconButton"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{loc:Tr Editor_Icon}"
                  Click="OnIconClick"
                  DockPanel.Dock="Left"
                  Style="{StaticResource RigShift.Button.Icon}"
                  ToolTip="{loc:Tr Editor_Icon}">
                  <controls:ProfileIcon
                    Width="20"
                    Height="20"
                    IconKey="{Binding Editor.SelectedIcon.Key}"
                    TextElement.Foreground="{DynamicResource RigShift.Brush.TextSecondary}" />
                  <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding IconChoices}">
                      <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                          <Setter Property="Header" Value="{Binding Name}" />
                          <Setter Property="Command" Value="{Binding DataContext.ChooseIconCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                          <Setter Property="CommandParameter" Value="{Binding}" />
                          <Setter Property="Icon">
                            <Setter.Value>
                              <controls:ProfileIcon Width="16" Height="16" IconKey="{Binding Key}" />
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
                <TextBox
                  x:Name="NameBox"
                  MinWidth="160"
                  MaxWidth="480"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="{loc:Tr Editor_Name}"
                  DockPanel.Dock="Left"
                  MaxLength="60"
                  Style="{StaticResource RigShift.Field.Title}"
                  Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="{loc:Tr Editor_Name}"
                  controls:Interaction.IsInvalid="{Binding Editor.HasNameProblem}" />
                <!-- The name is a field: a pencil shows it on hover (P-02), the frame comes from the field style. -->
                <ui:SymbolIcon
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  DockPanel.Dock="Left"
                  FontSize="16"
                  Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                  IsHitTestVisible="False"
                  Symbol="Edit16">
                  <ui:SymbolIcon.Style>
                    <Style TargetType="ui:SymbolIcon">
                      <Setter Property="Opacity" Value="0" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, ElementName=NameBox}" Value="True" />
                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=NameBox}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
              </DockPanel>
              <controls:StatusLine
                Margin="0,4,0,0"
                Kind="{Binding HeadStatusKind}"
                Text="{Binding HeadStatusText}"
                Visibility="{Binding Editor.HasNameProblem, Converter={StaticResource InverseBoolToVisibility}}"
                controls:LiveRegion.IsLive="True" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource RigShift.Text.FieldError}"
                Text="{Binding Editor.NameProblem}"
                Visibility="{Binding Editor.HasNameProblem, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel
              Grid.Column="1"
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              Orientation="Horizontal">
              <Button
                Margin="0,0,8,0"
                Command="{Binding TestCommand}"
                Content="{loc:Tr Profile_Check}"
                Style="{StaticResource RigShift.Button.Ghost}"
                ToolTip="{loc:Tr Detail_TestTip}" />
              <!-- Accent only when switching would change something: Save leads while the save bar shows, and an active
                   profile offers "Apply again" as a plain button (R-ACT-1, B-03). -->
              <Button
                Margin="0,0,8,0"
                Command="{Binding SwitchCommand}"
                Content="{Binding SwitchLabel}"
                Style="{StaticResource RigShift.Button.Primary}"
                ToolTip="{loc:Tr Detail_SwitchTip}"
                Visibility="{Binding SwitchIsPrimary, Converter={StaticResource BoolToVisibility}}" />
              <Button
                Margin="0,0,8,0"
                Command="{Binding SwitchCommand}"
                Content="{Binding SwitchLabel}"
                Style="{StaticResource RigShift.Button}"
                ToolTip="{loc:Tr Detail_SwitchTip}"
                Visibility="{Binding SwitchIsPrimary, Converter={StaticResource InverseBoolToVisibility}}" />
              <Button
                AutomationProperties.Name="{loc:Tr Profile_More}"
                Click="OnMoreClick"
                Style="{StaticResource RigShift.Button.IconOutlined}"
                ToolTip="{loc:Tr Profile_More}">
                <ui:SymbolIcon FontSize="16" Symbol="MoreHorizontal16" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Command="{Binding DuplicateCommand}" Header="{loc:Tr Profile_Duplicate}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Copy16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                      Command="{Binding ToggleDefaultCommand}"
                      Header="{loc:Tr Profile_SetDefault}"
                      IsCheckable="False"
                      IsChecked="{Binding IsSelectedDefault, Mode=OneWay}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Star16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Command="{Binding CreateShortcutCommand}" Header="{loc:Tr Profile_ShortcutMenu}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Link16" />
                      </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem
                      Command="{Binding DeleteCommand}"
                      Foreground="{DynamicResource RigShift.Brush.Error}"
                      Header="{loc:Tr Profile_Delete}">
                      <MenuItem.Icon>
                        <ui:SymbolIcon Foreground="{DynamicResource RigShift.Brush.Error}" Symbol="Delete16" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <controls:ProgressLine Grid.Row="2" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Missing displays by name (P-01), then test and switch results and store errors (R-FLOW-2). -->
        <StackPanel Grid.Row="3">
          <controls:InfoBar
            Margin="24,12,24,0"
            Kind="Error"
            Text="{Binding BlockedMessage}"
            Visibility="{Binding HasBlockedMessage, Converter={StaticResource BoolToVisibility}}" />
          <controls:InfoBar
            Margin="24,12,24,0"
            Kind="{Binding DetailKind}"
            Text="{Binding DetailMessage}"
            Visibility="{Binding HasDetailMessage, Converter={StaticResource BoolToVisibility}}"
            controls:LiveRegion.IsLive="True">
            <controls:InfoBar.Action>
              <Button
                Height="28"
                Width="28"
                AutomationProperties.Name="{loc:Tr Common_Close}"
                Command="{Binding CloseDetailMessageCommand}"
                Style="{StaticResource RigShift.Button.Icon}"
                ToolTip="{loc:Tr Common_Close}">
                <ui:SymbolIcon FontSize="12" Symbol="Dismiss12" />
              </Button>
            </controls:InfoBar.Action>
          </controls:InfoBar>
        </StackPanel>

        <!-- Tabs in editing order (F4). -->
        <TabControl
          x:Name="Tabs"
          Grid.Row="4"
          Margin="0,4,0,0"
          Style="{StaticResource RigShift.Tabs}">
          <TabItem
            Header="{loc:Tr Tab_Displays}"
            Style="{StaticResource RigShift.Tab}"
            controls:Interaction.IsInvalid="{Binding Editor.HasDisplaysProblem}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <controls:InfoBar
                  Margin="0,0,0,12"
                  Kind="Error"
                  Text="{Binding DisplaysProblem}"
                  Visibility="{Binding HasDisplaysProblem, Converter={StaticResource BoolToVisibility}}" />
                <controls:InfoBar
                  Margin="0,0,0,12"
                  Kind="Warn"
                  Text="{Binding WarningText}"
                  Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />

                <!-- Toolbar above the picture, right-aligned; the hint sits in the panel under the displays. -->
                <StackPanel
                  Margin="0,0,0,8"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
                  <Button
                    Command="{Binding DataContext.OpenDisplaySettingsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    Style="{StaticResource RigShift.Button.Ghost}"
                    ToolTip="{loc:Tr Editor_DisplaysHint}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{loc:Tr Displays_OpenSettings}" />
                      <ui:SymbolIcon Margin="6,0,0,0" FontSize="14" Symbol="Open16" />
                    </StackPanel>
                  </Button>
                  <Button
                    Margin="8,0,0,0"
                    Command="{Binding TakeCurrentCommand}"
                    Style="{StaticResource RigShift.Button}"
                    ToolTip="{loc:Tr Editor_DisplaysHint}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Symbol="ArrowClockwise16" />
                      <AccessText Text="{loc:Tr Editor_TakeCurrent}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <ContentControl Style="{StaticResource RigShift.TopologyPanel}">
                  <StackPanel>
                    <controls:DisplayTopology
                      Height="190"
                      Displays="{Binding TopologyDisplays}"
                      SelectedKey="{Binding SelectedDisplayKey, Mode=TwoWay}"
                      Size="L" />
                    <TextBlock
                      Margin="0,8,0,0"
                      HorizontalAlignment="Center"
                      Style="{StaticResource RigShift.Text.Caption}"
                      Text="{loc:Tr Displays_ClickHint}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="NoWrap" />
                  </StackPanel>
                </ContentControl>
                <TextBlock
                  AutomationProperties.LiveSetting="Polite"
                  Style="{StaticResource OptionalCaption}"
                  Text="{Binding ArrangementNote}" />

                <!-- Properties of the chosen display. -->
                <Border
                  Margin="0,16,0,0"
                  Padding="16,12"
                  DataContext="{Binding SelectedDisplay}"
                  Style="{StaticResource RigShift.Card}"
                  Visibility="{Binding DataContext.HasSelectedDisplay, RelativeSource={RelativeSource AncestorType=StackPanel}, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <!-- Fixed rows: model and resolution with remove on top, the fields below. The two switches
                         share the fields' row while it fits and move as one block to a row of their own when not. -->
                    <DockPanel Margin="0,0,0,12">
                      <Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.HelpText="{Binding Name}"
                        AutomationProperties.Name="{loc:Tr Editor_Remove}"
                        Command="{Binding DataContext.Editor.RemoveDisplayCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        CommandParameter="{Binding}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RigShift.Button.IconDanger}"
                        ToolTip="{loc:Tr Editor_Remove}">
                        <ui:SymbolIcon FontSize="16" Symbol="Delete16" />
                      </Button>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock
                          Style="{StaticResource RigShift.Text.BodyStrong}"
                          Text="{Binding ModelName}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap" />
                        <TextBlock
                          Style="{StaticResource RigShift.Text.ValueSecondary}"
                          Text="{Binding ResolutionText}"
                          TextTrimming="CharacterEllipsis"
                          TextWrapping="NoWrap"
                          ToolTip="{Binding ModeText}" />
                      </StackPanel>
                    </DockPanel>
                    <controls:AdaptiveColumns Gap="24">
                      <Grid Width="480">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="104" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr Editor_CustomName}" />
                          <TextBox
                            AutomationProperties.Name="{loc:Tr Editor_CustomName}"
                            MaxLength="40"
                            Style="{StaticResource RigShift.Field}"
                            Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{loc:Tr Editor_CustomNamePlaceholder}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr Editor_RefreshRate}" />
                          <ComboBox
                            AutomationProperties.Name="{loc:Tr Editor_RefreshRate}"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding RefreshChoices}"
                            SelectedItem="{Binding SelectedRefresh}"
                            Style="{StaticResource RigShift.Select}"
                            ToolTip="{loc:Tr Editor_RefreshRateHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                          <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="HDR" />
                          <ComboBox
                            AutomationProperties.Name="HDR"
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding HdrChoices}"
                            SelectedItem="{Binding SelectedHdr}"
                            Style="{StaticResource RigShift.Select}"
                            ToolTip="{loc:Tr Editor_HdrHint}" />
                        </StackPanel>
                      </Grid>
                      <!-- Same height as a field and bottom-aligned, so the switches sit on the fields' centre line. -->
                      <StackPanel
                        Height="32"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal">
                        <RadioButton
                          VerticalAlignment="Center"
                          AutomationProperties.HelpText="{Binding Name}"
                          Content="{loc:Tr Editor_Primary}"
                          GroupName="PrimaryDisplay"
                          IsChecked="{Binding IsPrimary}"
                          Style="{StaticResource RigShift.Radio}" />
                        <CheckBox
                          Margin="24,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.HelpText="{Binding Name}"
                          Content="{loc:Tr Editor_Optional}"
                          IsChecked="{Binding IsOptional}"
                          IsEnabled="{Binding CanBeOptional}"
                          Style="{StaticResource RigShift.Check}" />
                      </StackPanel>
                    </controls:AdaptiveColumns>
                    <TextBlock
                      Margin="0,8,0,0"
                      Style="{StaticResource RigShift.Text.Caption}"
                      Text="{loc:Tr Editor_RefreshRatesUnknown}"
                      Visibility="{Binding RatesUnknown, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Switching HDR froze a test PC over HDMI, also from the Windows settings (finding HW-12). -->
                    <TextBlock
                      Margin="0,8,0,0"
                      Foreground="{DynamicResource RigShift.Brush.Warn}"
                      Style="{StaticResource RigShift.Text.Caption}"
                      Text="{loc:Tr Editor_HdrWarning}"
                      TextWrapping="Wrap"
                      Visibility="{Binding SwitchesHdr, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                </Border>
                <Border
                  MinHeight="56"
                  Margin="0,16,0,0"
                  Padding="16,12"
                  Style="{StaticResource RigShift.Card}"
                  Visibility="{Binding HasSelectedDisplay, Converter={StaticResource InverseBoolToVisibility}}">
                  <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource RigShift.Text.Caption}"
                    Text="{loc:Tr Displays_NoneSelected}"
                    TextWrapping="Wrap" />
                </Border>

                <!-- Hidden without an NVIDIA card: nothing here would mean anything then. -->
                <controls:SettingRow
                  Margin="0,8,0,0"
                  Caption="{Binding SurroundHint}"
                  IsCaptionError="{Binding SurroundHintIsError}"
                  Title="{loc:Tr Editor_Surround}"
                  Visibility="{Binding ShowSurround, Converter={StaticResource BoolToVisibility}, Mode=OneTime}">
                  <ListBox
                    Width="240"
                    AutomationProperties.Name="{loc:Tr Editor_Surround}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding SurroundChoices}"
                    SelectedItem="{Binding SelectedSurround}"
                    Style="{StaticResource RigShift.Segment}" />
                </controls:SettingRow>
                <!-- Desktop symbols: captured on demand, because they are only right while this profile's screens are
                     up. The caption is the saved state; how to use it is the tooltip. -->
                <controls:SettingRow
                  Margin="0,8,0,0"
                  Caption="{Binding DesktopIconsText}"
                  Title="{loc:Tr Editor_DesktopIcons}"
                  ToolTip="{loc:Tr Editor_DesktopIconsHint}">
                  <StackPanel Orientation="Horizontal">
                    <Button
                      Command="{Binding ClearDesktopIconsCommand}"
                      Content="{loc:Tr Editor_DesktopIconsClear}"
                      Style="{StaticResource RigShift.Button.Ghost}"
                      Visibility="{Binding HasDesktopIcons, Converter={StaticResource BoolToVisibility}}" />
                    <Button
                      Margin="8,0,0,0"
                      Command="{Binding CaptureDesktopIconsCommand}"
                      Content="{loc:Tr Editor_DesktopIconsCapture}"
                      Style="{StaticResource RigShift.Button}" />
                  </StackPanel>
                </controls:SettingRow>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{loc:Tr Tab_Audio}" Style="{StaticResource RigShift.Tab}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Audio_Intro}" />
                <!-- One card per device kind: playback, recording, calls (L-06). -->
                <ItemsControl
                  Focusable="False"
                  ItemTemplate="{StaticResource AudioSlotTemplate}"
                  ItemsSource="{Binding AudioSlots}" />
                <!-- Call devices follow playback and recording unless set here (analysis decision O-02). -->
                <Border Style="{StaticResource RigShift.Card.Group}">
                  <StackPanel>
                    <TextBlock
                      Margin="0,12,0,4"
                      Style="{StaticResource RigShift.Text.CardTitle}"
                      Text="{loc:Tr Editor_AudioAdvanced}" />
                    <ItemsControl Focusable="False" ItemsSource="{Binding CommunicationsAudioSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AudioSlot}">
                          <controls:SettingRow Style="{StaticResource RigShift.SettingRow.Inner}" Title="{Binding Label}">
                            <ComboBox
                              Width="300"
                              AutomationProperties.Name="{Binding Label}"
                              DisplayMemberPath="Name"
                              ItemsSource="{Binding Choices}"
                              SelectedItem="{Binding Selected}"
                              Style="{StaticResource RigShift.Select}" />
                          </controls:SettingRow>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Margin="0,4,0,0" Style="{StaticResource RigShift.Divider}" />
                    <controls:SettingRow
                      Caption="{loc:Tr Editor_DisableDuckingHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Editor_DisableDucking}">
                      <ui:ToggleSwitch
                        AutomationProperties.Name="{loc:Tr Editor_DisableDucking}"
                        IsChecked="{Binding DisableCommunicationsDucking}"
                        Style="{StaticResource RigShift.Toggle}" />
                    </controls:SettingRow>
                  </StackPanel>
                </Border>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <TabItem
            Header="{loc:Tr Tab_Apps}"
            Style="{StaticResource RigShift.Tab}"
            controls:Interaction.IsInvalid="{Binding Editor.HasAppsProblem}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Apps_ProfileIntro}" />
                <controls:SettingRow Caption="{loc:Tr Editor_AppsWaitHint}" Title="{loc:Tr Editor_AppsWaitDevice}">
                  <ComboBox
                    Width="260"
                    AutomationProperties.HelpText="{loc:Tr Editor_AppsWaitHint}"
                    AutomationProperties.Name="{loc:Tr Editor_AppsWaitDevice}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding AppsWaitDeviceChoices}"
                    SelectedItem="{Binding SelectedAppsWaitDevice}"
                    Style="{StaticResource RigShift.Select}" />
                </controls:SettingRow>
                <controls:InfoBar
                  Margin="0,16,0,0"
                  Kind="Error"
                  Text="{Binding AppsProblem}"
                  Visibility="{Binding HasAppsProblem, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl
                  Margin="0,16,0,0"
                  Focusable="False"
                  ItemsSource="{Binding Apps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppEditItem}">
                      <!-- Two rows so the name and path keep their room at the smallest window width: program and
                           card actions on top, the settings of the action below. -->
                      <Border
                        Margin="0,0,0,8"
                        Padding="16,12"
                        Style="{StaticResource RigShift.Card}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <!-- The program's own icon; a generic symbol while the path points to nothing with one. -->
                          <Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource RigShift.Brush.TextSecondary}" Symbol="Apps16">
                              <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                      <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <Image Source="{Binding Icon}" />
                          </Grid>
                          <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock
                              Style="{StaticResource RigShift.Text.BodyStrong}"
                              Text="{Binding DisplayName}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="NoWrap" />
                            <TextBlock
                              Text="{Binding Path}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="NoWrap"
                              ToolTip="{Binding Path}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.ValueSecondary}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding PathMissing}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.Error}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                          <Button
                            Grid.Column="2"
                            Height="28"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            AutomationProperties.HelpText="{Binding DisplayName}"
                            Click="OnBrowseApp"
                            Content="{loc:Tr App_Change}"
                            Style="{StaticResource RigShift.Button}"
                            ToolTip="{loc:Tr App_Browse}" />
                          <Button
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Tr App_MoveUp}"
                            Command="{Binding DataContext.Editor.MoveAppUpCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource RigShift.Button.Icon}"
                            ToolTip="{loc:Tr App_MoveUp}">
                            <ui:SymbolIcon FontSize="16" Symbol="ArrowUp16" />
                          </Button>
                          <Button
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Tr App_MoveDown}"
                            Command="{Binding DataContext.Editor.MoveAppDownCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource RigShift.Button.Icon}"
                            ToolTip="{loc:Tr App_MoveDown}">
                            <ui:SymbolIcon FontSize="16" Symbol="ArrowDown16" />
                          </Button>
                          <Button
                            Grid.Column="5"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Tr App_Remove}"
                            Command="{Binding DataContext.Editor.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=TabItem}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource RigShift.Button.IconDanger}"
                            ToolTip="{loc:Tr App_Remove}">
                            <ui:SymbolIcon FontSize="16" Symbol="Delete16" />
                          </Button>

                          <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="5"
                            Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                              <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr App_Action}" />
                              <ComboBox
                                Width="120"
                                AutomationProperties.Name="{loc:Tr App_Action}"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding KindChoices}"
                                SelectedItem="{Binding SelectedKind}"
                                Style="{StaticResource RigShift.Select}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                              <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr App_WaitShort}" />
                              <StackPanel Orientation="Horizontal">
                                <ui:NumberBox
                                  Width="64"
                                  AutomationProperties.Name="{loc:Tr App_Wait}"
                                  ClearButtonEnabled="False"
                                  MaxDecimalPlaces="0"
                                  Maximum="300"
                                  Minimum="0"
                                  PlaceholderText="0"
                                  SmallChange="1"
                                  SpinButtonPlacementMode="Hidden"
                                  Style="{StaticResource RigShift.Number}"
                                  ToolTip="{loc:Tr App_Wait}"
                                  Value="{Binding WaitSeconds, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                            </StackPanel>
                            <StackPanel
                              Grid.Column="3"
                              Margin="8,0,0,0"
                              Visibility="{Binding IsStart, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr App_Arguments}" />
                              <TextBox
                                AutomationProperties.Name="{loc:Tr App_Arguments}"
                                Style="{StaticResource RigShift.Field.Value}"
                                Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                  HorizontalAlignment="Left"
                  Click="OnAddApp"
                  Style="{StaticResource RigShift.Button}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add16" />
                    <TextBlock Text="{loc:Tr App_Path}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <TabItem
            Header="{loc:Tr Tab_Triggers}"
            Style="{StaticResource RigShift.Tab}"
            controls:Interaction.IsInvalid="{Binding Editor.HasHotkeyProblem}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Trigger_Intro}" />
                <!-- Three cards of one kind (L-06): USB devices, hotkey, shortcut and command. -->
                <Border DataContext="{Binding Rules}" Style="{StaticResource RigShift.Card.Group}">
                  <StackPanel>
                    <DockPanel Margin="0,12">
                      <Button
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding AddRuleCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RigShift.Button}">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Add16" />
                          <TextBlock Text="{loc:Tr Trigger_AddRule}" />
                        </StackPanel>
                      </Button>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RigShift.Text.CardTitle}" Text="{loc:Tr Trigger_UsbTitle}" />
                        <TextBlock
                          Style="{StaticResource RigShift.Text.Caption}"
                          Text="{loc:Tr Trigger_UsbCaption}"
                          TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                    <!-- USB rules of this profile (R-OBJ-1), saved with it; one section per rule. -->
                    <ItemsControl Focusable="False" ItemsSource="{Binding Rules}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RuleCard}">
                          <StackPanel>
                            <Border Style="{StaticResource RigShift.Divider}" />
                            <StackPanel Margin="0,12">
                              <DockPanel>
                                <Button
                                  AutomationProperties.HelpText="{Binding DevicesText}"
                                  AutomationProperties.Name="{loc:Tr Automation_Delete}"
                                  Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  DockPanel.Dock="Right"
                                  Style="{StaticResource RigShift.Button.IconDanger}"
                                  ToolTip="{loc:Tr Automation_Delete}">
                                  <ui:SymbolIcon FontSize="16" Symbol="Delete16" />
                                </Button>
                                <TextBlock
                                  VerticalAlignment="Center"
                                  Style="{StaticResource RigShift.Text.Label}"
                                  Text="{loc:Tr Trigger_RuleTitle}" />
                              </DockPanel>
                              <WrapPanel Margin="0,4,0,0">
                                <ItemsControl Focusable="False" ItemsSource="{Binding Devices}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RuleDeviceSlot}">
                                      <!-- Device chip (B-07): plug symbol with a status dot, name, remove. -->
                                      <Border
                                        Margin="0,0,8,8"
                                        Style="{StaticResource RigShift.DeviceChip}"
                                        Visibility="{Binding HasDevice, Converter={StaticResource BoolToVisibility}}">
                                        <Border.ToolTip>
                                          <ToolTip>
                                            <TextBlock>
                                              <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                  <Setter Property="Text" Value="{loc:Tr Automation_NameNotConnected}" />
                                                  <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                      <Setter Property="Text" Value="{loc:Tr Automation_NameConnected}" />
                                                    </DataTrigger>
                                                  </Style.Triggers>
                                                </Style>
                                              </TextBlock.Style>
                                            </TextBlock>
                                          </ToolTip>
                                        </Border.ToolTip>
                                        <StackPanel Orientation="Horizontal">
                                          <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <ui:SymbolIcon FontSize="16" Foreground="{DynamicResource RigShift.Brush.TextSecondary}" Symbol="UsbPlug20" />
                                            <Ellipse
                                              Width="8"
                                              Height="8"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Bottom"
                                              Stroke="{DynamicResource RigShift.Brush.LayerHover}"
                                              StrokeThickness="1.5">
                                              <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                  <Setter Property="Fill" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
                                                  <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                      <Setter Property="Fill" Value="{DynamicResource RigShift.Brush.Ok}" />
                                                    </DataTrigger>
                                                  </Style.Triggers>
                                                </Style>
                                              </Ellipse.Style>
                                            </Ellipse>
                                          </Grid>
                                          <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource RigShift.Text.Body}"
                                            Text="{Binding Name}" />
                                          <Button
                                            Width="24"
                                            Height="24"
                                            Margin="4,0,0,0"
                                            AutomationProperties.HelpText="{Binding Name}"
                                            AutomationProperties.Name="{loc:Tr Automation_RemoveDevice}"
                                            Command="{Binding Card.RemoveDeviceCommand}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource RigShift.Button.Icon}"
                                            ToolTip="{loc:Tr Automation_RemoveDevice}">
                                            <ui:SymbolIcon FontSize="10" Symbol="Dismiss12" />
                                          </Button>
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                  Margin="0,0,0,8"
                                  AutomationProperties.HelpText="{loc:Tr Automation_AddDeviceHint}"
                                  Click="OnAddDeviceClick"
                                  Style="{StaticResource RigShift.Button.AddChip}"
                                  ToolTip="{loc:Tr Automation_AddDeviceHint}">
                                  <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" VerticalAlignment="Center" FontSize="12" Symbol="Add12" />
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Tr Trigger_AddDevice}" />
                                  </StackPanel>
                                  <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding AvailableDevices}">
                                      <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                          <Setter Property="Header" Value="{Binding Name}" />
                                          <Setter Property="Command" Value="{Binding DataContext.AddDeviceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                          <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                      </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                  </Button.ContextMenu>
                                </Button>
                              </WrapPanel>
                              <controls:AdaptiveColumns Margin="0,4,0,0" Gap="12">
                                <!-- Labels stay on one line so both fields share their top edge; the long wording is the tooltip. -->
                                <StackPanel
                                  Width="300"
                                  ToolTip="{loc:Tr Automation_DeviceGone}">
                                  <TextBlock
                                    Style="{StaticResource RigShift.Text.Label}"
                                    Text="{loc:Tr Automation_DeviceGoneShort}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                  <ComboBox
                                    AutomationProperties.Name="{loc:Tr Automation_DeviceGone}"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Owner.ExitChoices}"
                                    SelectedItem="{Binding SelectedExit}"
                                    Style="{StaticResource RigShift.Select}" />
                                </StackPanel>
                                <StackPanel Width="140" ToolTip="{loc:Tr Automation_ExitDelayHint}">
                                  <TextBlock
                                    Style="{StaticResource RigShift.Text.Label}"
                                    Text="{loc:Tr Automation_ExitDelay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                  <ui:NumberBox
                                    AutomationProperties.HelpText="{loc:Tr Automation_ExitDelayHint}"
                                    AutomationProperties.Name="{loc:Tr Automation_ExitDelay}"
                                    ClearButtonEnabled="False"
                                    MaxDecimalPlaces="0"
                                    Maximum="600"
                                    Minimum="0"
                                    PlaceholderText="0"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Hidden"
                                    Style="{StaticResource RigShift.Number}"
                                    Value="{Binding ExitDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                              </controls:AdaptiveColumns>
                              <controls:SettingRow
                                Margin="0,8,0,0"
                                Caption="{loc:Tr Automation_SkipConfirmationHint}"
                                Style="{StaticResource RigShift.SettingRow.Inner}"
                                Title="{loc:Tr Automation_SkipConfirmation}">
                                <ui:ToggleSwitch
                                  AutomationProperties.Name="{loc:Tr Automation_SkipConfirmation}"
                                  IsChecked="{Binding SkipConfirmation}"
                                  Style="{StaticResource RigShift.Toggle}" />
                              </controls:SettingRow>
                              <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource RigShift.Brush.Warn}"
                                Style="{StaticResource RigShift.Text.Caption}"
                                Text="{loc:Tr Automation_DuplicateDevice}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasDuplicateDevice, Converter={StaticResource BoolToVisibility}}" />
                              <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource RigShift.Brush.Warn}"
                                Style="{StaticResource RigShift.Text.Caption}"
                                Text="{loc:Tr Automation_PowerSavingText}"
                                TextWrapping="Wrap"
                                ToolTip="{loc:Tr Automation_PowerSavingTitle}"
                                Visibility="{Binding HasPowerWarning, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <!-- Hotkey: the hint in the caption, the reason in red while it cannot be used. -->
                <controls:SettingRow Margin="0,8,0,0" Title="{loc:Tr Editor_Hotkey}">
                  <controls:SettingRow.Style>
                    <Style TargetType="controls:SettingRow" BasedOn="{StaticResource {x:Type controls:SettingRow}}">
                      <Setter Property="Caption" Value="{Binding HotkeyHint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasHotkeyProblem}" Value="True">
                          <Setter Property="Caption" Value="{Binding HotkeyProblem}" />
                          <Setter Property="IsCaptionError" Value="True" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:SettingRow.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBox
                      x:Name="HotkeyBox"
                      Width="200"
                      AutomationProperties.HelpText="{loc:Tr Hotkey_RecordTip}"
                      AutomationProperties.Name="{loc:Tr Editor_Hotkey}"
                      GotKeyboardFocus="OnHotkeyGotFocus"
                      IsReadOnly="True"
                      IsReadOnlyCaretVisible="False"
                      LostKeyboardFocus="OnHotkeyLostFocus"
                      PreviewKeyDown="OnHotkeyKeyDown"
                      Style="{StaticResource RigShift.Field.Value}"
                      Text="{Binding HotkeyText, Mode=OneWay}"
                      ToolTip="{loc:Tr Hotkey_RecordTip}"
                      controls:Interaction.IsInvalid="{Binding HasHotkeyProblem}" />
                    <Button
                      Margin="8,0,0,0"
                      AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
                      Command="{Binding ClearHotkeyCommand}"
                      IsEnabled="{Binding HasHotkey}"
                      Style="{StaticResource RigShift.Button.Icon}"
                      ToolTip="{loc:Tr Editor_HotkeyClear}">
                      <ui:SymbolIcon FontSize="16" Symbol="Dismiss16" />
                    </Button>
                  </StackPanel>
                </controls:SettingRow>

                <Border Margin="0,8,0,0" Style="{StaticResource RigShift.Card.Group}">
                  <StackPanel>
                    <controls:SettingRow
                      Caption="{loc:Tr Trigger_ShortcutHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Trigger_Shortcut}">
                      <Button
                        Command="{Binding DataContext.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                        Style="{StaticResource RigShift.Button}">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Link16" />
                          <TextBlock Text="{loc:Tr Trigger_ShortcutCreate}" />
                        </StackPanel>
                      </Button>
                    </controls:SettingRow>
                    <Border Style="{StaticResource RigShift.Divider}" />
                    <controls:SettingRow
                      Caption="{loc:Tr Trigger_CommandHint}"
                      Style="{StaticResource RigShift.SettingRow.Inner}"
                      Title="{loc:Tr Trigger_Command}">
                      <StackPanel Orientation="Horizontal">
                        <TextBox
                          Width="240"
                          AutomationProperties.Name="{loc:Tr Trigger_Command}"
                          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                          IsReadOnly="True"
                          Style="{StaticResource RigShift.Field.Value}"
                          Text="{Binding CommandText, Mode=OneWay}"
                          ToolTip="{Binding CommandText, Mode=OneWay}" />
                        <Button
                          Margin="8,0,0,0"
                          AutomationProperties.Name="{loc:Tr Trigger_Copy}"
                          Command="{Binding DataContext.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                          Style="{StaticResource RigShift.Button.Icon}"
                          ToolTip="{loc:Tr Trigger_Copy}">
                          <ui:SymbolIcon FontSize="16" Symbol="Copy16" />
                        </Button>
                      </StackPanel>
                    </controls:SettingRow>
                  </StackPanel>
                </Border>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="{loc:Tr Tab_Behavior}" Style="{StaticResource RigShift.Tab}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <!-- Detail content: full width up to 960 px, left-aligned beyond. -->
              <controls:ContentColumn MaxContentWidth="1008">
              <StackPanel Margin="24" DataContext="{Binding Editor}">
                <TextBlock
                  Margin="0,0,0,16"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Behavior_Intro}" />
                <!-- Seconds come from the settings only (analysis decision O-01). Off in the settings, the switch changes
                     nothing; the caption says where the setting is (finding HW-02). -->
                <controls:SettingRow Title="{loc:Tr Editor_SwitchWithoutAsking}">
                  <controls:SettingRow.Style>
                    <Style TargetType="controls:SettingRow" BasedOn="{StaticResource {x:Type controls:SettingRow}}">
                      <Setter Property="Caption" Value="{loc:Tr Editor_SwitchWithoutAskingHint}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfirmationDisabled}" Value="True">
                          <Setter Property="Caption" Value="{loc:Tr Editor_ConfirmationOff}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </controls:SettingRow.Style>
                  <ui:ToggleSwitch
                    AutomationProperties.Name="{loc:Tr Editor_SwitchWithoutAsking}"
                    IsChecked="{Binding SwitchWithoutAsking}"
                    IsEnabled="{Binding ConfirmationEnabled}"
                    Style="{StaticResource RigShift.Toggle}" />
                </controls:SettingRow>
                <controls:SettingRow
                  Margin="0,8,0,0"
                  Caption="{loc:Tr Editor_KeepAwakeHint}"
                  Title="{loc:Tr Editor_KeepAwake}">
                  <ui:ToggleSwitch
                    AutomationProperties.Name="{loc:Tr Editor_KeepAwake}"
                    IsChecked="{Binding KeepAwake}"
                    Style="{StaticResource RigShift.Toggle}" />
                </controls:SettingRow>
              </StackPanel>
              </controls:ContentColumn>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- "'X' saved", three seconds (F3 step 4). -->
        <TextBlock
          Grid.Row="5"
          Height="28"
          Margin="24,0"
          VerticalAlignment="Center"
          LineHeight="28"
          Style="{StaticResource RigShift.Text.Caption}"
          Text="{Binding StatusMessage}"
          Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"
          controls:LiveRegion.IsLive="True" />

        <controls:SaveBar
          Grid.Row="6"
          DiscardCommand="{Binding DiscardCommand}"
          ProblemCount="{Binding Editor.ProblemCount}"
          SaveCommand="{Binding SaveCommand}"
          Visibility="{Binding Editor.IsDirty, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Grid>
  </Grid>
</Page>

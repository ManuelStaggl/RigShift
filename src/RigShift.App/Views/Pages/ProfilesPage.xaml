<Page
  x:Class="RigShift.App.Views.Pages.ProfilesPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="Profiles">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,8,24,24">
      <!-- Title and buttons wrap onto two lines in a narrow window instead of overlapping (analysis finding I-01). -->
      <WrapPanel Margin="0,0,0,8">
        <ui:TextBlock Margin="0,0,24,8" VerticalAlignment="Center" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Nav_Profiles}" />
        <WrapPanel VerticalAlignment="Center">
          <ui:Button Margin="0,0,8,8" Appearance="Primary" Content="{loc:Tr Profiles_SaveCurrent}" Icon="{ui:SymbolIcon Add24}" Command="{Binding SaveCurrentCommand}" />
          <ui:Button Margin="0,0,8,8" Content="{loc:Tr Profiles_Reload}" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ReloadCommand}" />
          <ui:Button Margin="0,0,0,8" Content="{loc:Tr Profiles_OpenFolder}" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" />
        </WrapPanel>
      </WrapPanel>

      <!-- TwoWay: InfoBar.IsOpen does not bind two-way by default, and closing with X must reach the view model. -->
      <ui:InfoBar
        Margin="0,0,0,16"
        IsClosable="True"
        IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
        Message="{Binding StatusMessage}"
        Severity="{Binding StatusSeverity}"
        AutomationProperties.LiveSetting="Polite" />

      <ui:InfoBar
        Margin="0,0,0,16"
        Title="{loc:Tr Profiles_EmptyTitle}"
        Message="{Binding EmptyMessage}"
        IsOpen="{Binding Catalog.IsEmpty}"
        IsClosable="False"
        Severity="Informational" />

      <ui:InfoBar
        Margin="0,0,0,16"
        Title="{loc:Tr Profiles_UnreadableTitle}"
        Message="{Binding Catalog.UnreadableFilesMessage}"
        IsOpen="{Binding Catalog.HasUnreadableFiles}"
        IsClosable="False"
        Severity="Warning" />

      <ItemsControl ItemsSource="{Binding Catalog.Items}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="0,0,0,12">
              <!-- Text on top, buttons below: a narrow window squeezes neither into single characters (analysis finding I-01). -->
              <StackPanel>
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:ProfileIcon
                      Width="28"
                      Height="28"
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      IconKey="{Binding IconKey}"
                      IsFilled="{Binding IsActive}"
                      TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      FontTypography="Subtitle"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Name}" />
                    <Border
                      Grid.Column="2"
                      Margin="12,0,0,0"
                      Padding="8,2"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{loc:Tr Profile_Active}" />
                    </Border>
                    <Border
                      Grid.Column="3"
                      Margin="8,0,0,0"
                      Padding="8,2"
                      VerticalAlignment="Center"
                      BorderBrush="{DynamicResource TextFillColorSecondaryBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Profile_Default}" />
                    </Border>
                  </Grid>

                  <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DisplayLines}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Margin="0,8,0,0" Text="{Binding CheckMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CheckMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>

                <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                  <ui:Button
                    Margin="0,0,8,0"
                    Content="{loc:Tr Profile_Check}"
                    Icon="{ui:SymbolIcon DocumentSearch24}"
                    AutomationProperties.HelpText="{Binding Name}"
                    Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.Coordinator.IsIdle, RelativeSource={RelativeSource AncestorType=Page}}" />
                  <ui:Button
                    Margin="0,0,8,0"
                    Appearance="Primary"
                    Content="{loc:Tr Profile_Apply}"
                    Icon="{ui:SymbolIcon Play24}"
                    AutomationProperties.HelpText="{Binding Name}"
                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}"
                    IsEnabled="{Binding DataContext.Coordinator.IsIdle, RelativeSource={RelativeSource AncestorType=Page}}" />
                  <ui:Button
                    Margin="0,0,8,0"
                    Content="{loc:Tr Profile_Edit}"
                    Icon="{ui:SymbolIcon Edit24}"
                    AutomationProperties.HelpText="{Binding Name}"
                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                    CommandParameter="{Binding}" />
                  <ui:Button
                    Click="OnMoreClick"
                    Icon="{ui:SymbolIcon MoreHorizontal24}"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                    ToolTip="{loc:Tr Profile_More}"
                    AutomationProperties.HelpText="{Binding Name}"
                    AutomationProperties.Name="{loc:Tr Profile_More}">
                    <ui:Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem
                          Command="{Binding PlacementTarget.Tag.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"
                          Header="{loc:Tr Profile_Duplicate}"
                          Icon="{ui:SymbolIcon Copy24}" />
                        <MenuItem
                          Command="{Binding PlacementTarget.Tag.CreateShortcutCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"
                          Header="{loc:Tr Profile_Shortcut}"
                          Icon="{ui:SymbolIcon Link24}" />
                        <Separator />
                        <MenuItem
                          Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"
                          Header="{loc:Tr Profile_Delete}"
                          Icon="{ui:SymbolIcon Delete24}" />
                      </ContextMenu>
                    </ui:Button.ContextMenu>
                  </ui:Button>
                </WrapPanel>
              </StackPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>

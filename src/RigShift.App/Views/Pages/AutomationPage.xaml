<Page
  x:Class="RigShift.App.Views.Pages.AutomationPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="Automation">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,8,24,24">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:TextBlock VerticalAlignment="Center" FontTypography="Title" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Nav_Automation}" />
        <ui:Button Grid.Column="1" Appearance="Primary" Command="{Binding AddRuleCommand}" Content="{loc:Tr Automation_Add}" Icon="{ui:SymbolIcon Add24}" />
      </Grid>
      <TextBlock Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Automation_Hint}" TextWrapping="Wrap" />

      <ui:CardControl Margin="0,0,0,16" Header="{loc:Tr Automation_Pause}" Icon="{ui:SymbolIcon Pause24}">
        <ui:ToggleSwitch AutomationProperties.Name="{loc:Tr Automation_Pause}" IsChecked="{Binding IsPaused}" />
      </ui:CardControl>

      <ui:InfoBar Margin="0,0,0,16" IsClosable="False" IsOpen="{Binding IsPaused, Mode=OneWay}" Message="{loc:Tr Automation_Paused}" Severity="Warning" />
      <ui:InfoBar Margin="0,0,0,16" IsClosable="False" IsOpen="{Binding HasNoProfiles, Mode=OneWay}" Message="{loc:Tr Automation_NoProfiles}" Severity="Informational" />
      <ui:InfoBar Margin="0,0,0,16" IsClosable="False" IsOpen="{Binding IsEmpty, Mode=OneWay}" Message="{loc:Tr Automation_Empty}" Severity="Informational" />
      <ui:InfoBar
        Margin="0,0,0,16"
        IsClosable="False"
        IsOpen="{Binding HasError, Mode=OneWay}"
        Message="{Binding ErrorMessage}"
        Severity="Error"
        AutomationProperties.LiveSetting="Polite" />

      <ItemsControl Focusable="False" ItemsSource="{Binding Rules}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="0,0,0,8" Padding="16,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Hint only: RigShift reads the power settings but never changes them (docs/usb-power-saving.md). -->
                <StackPanel
                  Grid.Row="3"
                  Grid.ColumnSpan="2"
                  Margin="0,4,0,0"
                  Visibility="{Binding HasPowerWarning, Converter={StaticResource BoolToVisibility}}">
                  <ui:InfoBar
                    Title="{loc:Tr Automation_PowerSavingTitle}"
                    IsClosable="False"
                    IsOpen="{Binding HasPowerWarning, Mode=OneWay}"
                    Message="{loc:Tr Automation_PowerSavingText}"
                    Severity="Warning" />
                  <ui:Button
                    Margin="0,8,0,0"
                    AutomationProperties.HelpText="{Binding SelectedDevice.Name}"
                    Command="{Binding Owner.OpenUsbPowerHelpCommand}"
                    Content="{loc:Tr Automation_PowerSavingHelp}"
                    Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>

                <!-- Line one: the device, full width so its name stays readable. Line two wraps: profile, end action, delay,
                     confirmation (analysis finding I-03). -->
                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Automation_DeviceConnects}" TextWrapping="Wrap" />
                <Grid Grid.Row="1" Margin="0,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox
                    AutomationProperties.Name="{loc:Tr Automation_Device}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Owner.DeviceChoices}"
                    SelectedItem="{Binding SelectedDevice}"
                    ToolTip="{Binding SelectedDevice.Name}" />
                  <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{loc:Tr Automation_RefreshDevices}"
                    Command="{Binding Owner.RefreshDevicesCommand}"
                    Icon="{ui:SymbolIcon ArrowClockwise24}"
                    ToolTip="{loc:Tr Automation_RefreshDevices}" />
                </Grid>

                <ui:Button
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="16,4,0,0"
                  VerticalAlignment="Stretch"
                  AutomationProperties.HelpText="{Binding SelectedDevice.Name}"
                  AutomationProperties.Name="{loc:Tr Automation_Delete}"
                  Command="{Binding Owner.DeleteRuleCommand}"
                  CommandParameter="{Binding}"
                  Icon="{ui:SymbolIcon Delete24}"
                  ToolTip="{loc:Tr Automation_Delete}" />

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                  <StackPanel MinWidth="200" Margin="0,0,24,8">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Automation_Profile}" />
                    <ComboBox
                      Margin="0,4,0,0"
                      AutomationProperties.HelpText="{Binding SelectedDevice.Name}"
                      AutomationProperties.Name="{loc:Tr Automation_Profile}"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Owner.ProfileChoices}"
                      SelectedItem="{Binding SelectedProfile}" />
                  </StackPanel>
                  <StackPanel MinWidth="240" Margin="0,0,24,8">
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Automation_DeviceGone}" />
                    <ComboBox
                      Margin="0,4,0,0"
                      AutomationProperties.HelpText="{Binding SelectedDevice.Name}"
                      AutomationProperties.Name="{loc:Tr Automation_DeviceGone}"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Owner.ExitChoices}"
                      SelectedItem="{Binding SelectedExit}" />
                  </StackPanel>
                  <StackPanel Margin="0,0,24,8" VerticalAlignment="Bottom" Orientation="Horizontal" ToolTip="{loc:Tr Automation_ExitDelayHint}">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Automation_ExitDelay}" />
                    <ui:NumberBox
                      Width="130"
                      AutomationProperties.HelpText="{loc:Tr Automation_ExitDelayHint}"
                      AutomationProperties.Name="{loc:Tr Automation_ExitDelay}"
                      MaxDecimalPlaces="0"
                      Maximum="600"
                      Minimum="0"
                      SmallChange="5"
                      Value="{Binding ExitDelaySeconds, UpdateSourceTrigger=LostFocus}" />
                  </StackPanel>
                  <CheckBox
                    Margin="0,0,0,12"
                    VerticalAlignment="Bottom"
                    AutomationProperties.HelpText="{Binding SelectedDevice.Name}"
                    Content="{loc:Tr Automation_SkipConfirmation}"
                    IsChecked="{Binding SkipConfirmation}" />
                </WrapPanel>
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>

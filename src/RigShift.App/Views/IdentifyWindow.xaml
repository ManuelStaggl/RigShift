<Window
  x:Class="RigShift.App.Views.IdentifyWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="RigShift"
  AllowsTransparency="True"
  Background="Transparent"
  Focusable="False"
  Opacity="0"
  ResizeMode="NoResize"
  ShowActivated="False"
  ShowInTaskbar="False"
  SizeToContent="WidthAndHeight"
  Topmost="True"
  WindowStartupLocation="Manual"
  WindowStyle="None">
  <!-- Fixed colors on purpose: the overlay must read well on any wallpaper, independent of the app theme. -->
  <Border
    MinWidth="260"
    Padding="48,20,48,28"
    Background="#E61B1B1F"
    BorderBrush="#FF60CDFF"
    BorderThickness="3"
    CornerRadius="16">
    <StackPanel>
      <TextBlock
        x:Name="NumberText"
        HorizontalAlignment="Center"
        FontSize="120"
        FontWeight="SemiBold"
        Foreground="White" />
      <TextBlock
        x:Name="NameText"
        MaxWidth="480"
        HorizontalAlignment="Center"
        FontSize="22"
        Foreground="White"
        TextAlignment="Center"
        TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>

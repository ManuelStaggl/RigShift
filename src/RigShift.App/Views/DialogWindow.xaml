<ui:FluentWindow
  x:Class="RigShift.App.Views.DialogWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="460"
  Background="{DynamicResource RigShift.Brush.Page}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  MinWidth="0"
  MinHeight="0"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner"
>
  <!-- No title bar: the question is the heading (mockup DialogLoeschen / DialogUngespeichert). -->
  <StackPanel Margin="24,24,24,24">
    <TextBlock
      x:Name="TitleText"
      Style="{StaticResource RigShift.Text.Subtitle}"
      TextWrapping="Wrap" />
    <TextBlock
      x:Name="MessageText"
      Margin="0,12,0,0"
      Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
      Style="{StaticResource RigShift.Text.Body}"
      TextWrapping="Wrap" />
    <!-- Windows order: the action first, the way out last (R-ACT-3). -->
    <StackPanel
      x:Name="Buttons"
      Margin="0,24,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal" />
  </StackPanel>
</ui:FluentWindow>

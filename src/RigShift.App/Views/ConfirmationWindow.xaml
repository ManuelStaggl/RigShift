<ui:FluentWindow
  x:Class="RigShift.App.Views.ConfirmationWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="520"
  SizeToContent="Height"
  Background="{DynamicResource RigShift.Brush.Page}"
  ExtendsContentIntoTitleBar="True"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  MinWidth="0"
  MinHeight="0"
  ResizeMode="NoResize"
  ShowInTaskbar="True"
  Topmost="True"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="Manual">
  <Grid Margin="28,24,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Question and the countdown as a ring: the seconds are the one number that matters here. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock
        VerticalAlignment="Center"
        Style="{StaticResource RigShift.Text.Subtitle}"
        Text="{loc:Tr Confirm_Title}"
        TextWrapping="Wrap" />
      <controls:CountdownRing
        x:Name="Ring"
        Grid.Column="1"
        Width="72"
        Height="72"
        Margin="16,0,0,0" />
    </Grid>

    <!-- Before → after, the same picture the profile cards use (spec 7.5, size S without labels). -->
    <Grid Grid.Row="1" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Border
          Width="176"
          Height="72"
          Background="{DynamicResource RigShift.Brush.Layer}"
          BorderBrush="{DynamicResource RigShift.Brush.Line}"
          BorderThickness="1"
          CornerRadius="4"
          SnapsToDevicePixels="True">
          <controls:DisplayTopology
            x:Name="BeforeTopology"
            Width="160"
            Height="60"
            Size="S" />
        </Border>
        <TextBlock
          x:Name="BeforeName"
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.Caption}"
          TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <ui:SymbolIcon
        Grid.Column="2"
        Margin="20,0,20,20"
        VerticalAlignment="Center"
        FontSize="20"
        Foreground="{DynamicResource RigShift.Brush.Accent}"
        Symbol="ArrowRight24" />

      <StackPanel Grid.Column="3" VerticalAlignment="Center">
        <Border
          Width="176"
          Height="72"
          Background="{DynamicResource RigShift.Brush.Layer}"
          BorderBrush="{DynamicResource RigShift.Brush.Accent}"
          BorderThickness="2"
          CornerRadius="4"
          SnapsToDevicePixels="True">
          <controls:DisplayTopology
            x:Name="AfterTopology"
            Width="160"
            Height="60"
            Size="S" />
        </Border>
        <TextBlock
          x:Name="AfterName"
          Margin="0,8,0,0"
          HorizontalAlignment="Center"
          Style="{StaticResource RigShift.Text.BodyStrong}"
          TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <!-- The countdown sentence, then the keys as keycaps (D-04), one per row so a key never wraps away from its meaning. -->
    <StackPanel Grid.Row="2" Margin="0,20,0,0">
      <TextBlock
        x:Name="HintText"
        AutomationProperties.LiveSetting="Assertive"
        Style="{StaticResource RigShift.Text.Caption}"
        TextWrapping="Wrap" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl HorizontalAlignment="Left" Content="Enter" Style="{StaticResource RigShift.Keycap}" />
        <TextBlock
          Grid.Column="1"
          Margin="8,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource RigShift.Text.Caption}"
          Text="{loc:Tr Confirm_KeyKeep}"
          TextWrapping="Wrap" />
        <ContentControl
          Grid.Row="1"
          Margin="0,6,0,0"
          HorizontalAlignment="Left"
          Content="Esc"
          Style="{StaticResource RigShift.Keycap}" />
        <TextBlock
          Grid.Row="1"
          Grid.Column="1"
          Margin="8,6,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource RigShift.Text.Caption}"
          Text="{loc:Tr Confirm_KeyRevert}"
          TextWrapping="Wrap" />
      </Grid>
    </StackPanel>

    <!-- Windows order, as in its own "Keep these display settings?" dialog: the action first, the way back second. -->
    <StackPanel
      Grid.Row="3"
      Margin="0,16,0,0"
      HorizontalAlignment="Right"
      Orientation="Horizontal">
      <Button
        x:Name="KeepButton"
        MinWidth="110"
        Margin="0,0,8,0"
        Click="OnKeep"
        Content="{loc:Tr Confirm_Keep}"
        IsDefault="True"
        Style="{StaticResource RigShift.Button.Primary}" />
      <Button
        x:Name="RevertButton"
        MinWidth="110"
        Click="OnRevert"
        Content="{loc:Tr Confirm_Revert}"
        IsCancel="True"
        Style="{StaticResource RigShift.Button}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>

<ui:FluentWindow
  x:Class="RigShift.App.Views.ConfirmationWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="RigShift"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  ExtendsContentIntoTitleBar="True"
  MinWidth="0"
  MinHeight="0"
  ResizeMode="NoResize"
  ShowInTaskbar="True"
  SizeToContent="WidthAndHeight"
  Topmost="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="Manual">
  <!-- No bottom margin: FluentWindow keeps the hidden caption height (about 40 px) below the content. -->
  <StackPanel MinWidth="420" MaxWidth="560" Margin="32,32,32,0">
    <ui:TextBlock FontTypography="Subtitle" Text="{loc:Tr Confirm_Title}" TextWrapping="Wrap" />
    <ui:TextBlock x:Name="ProfileText" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    <ui:TextBlock
      x:Name="CountdownText"
      Margin="0,16,0,0"
      AutomationProperties.LiveSetting="Assertive"
      FontTypography="BodyStrong"
      TextWrapping="Wrap" />
    <ui:TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Confirm_Hint}" TextWrapping="Wrap" />
    <!-- Windows order, as in its own "Keep these display settings?" dialog: the action first, the way back second. -->
    <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <ui:Button
        x:Name="KeepButton"
        MinWidth="120"
        Margin="0,0,8,0"
        Appearance="Primary"
        Click="OnKeep"
        Content="{loc:Tr Confirm_Keep}"
        IsDefault="True" />
      <ui:Button
        x:Name="RevertButton"
        MinWidth="120"
        Click="OnRevert"
        Content="{loc:Tr Confirm_Revert}"
        IsCancel="True" />
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>

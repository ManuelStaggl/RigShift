<ui:FluentWindow
  x:Class="RigShift.App.Views.AppPickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr App_Browse}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  Height="640"
  MinWidth="420"
  MinHeight="400"
  Background="{DynamicResource RigShift.Brush.Page}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <!-- D-01: title in the content, 48 px rows with the programs' own icons, a foot on the chrome surface. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Height="32" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,0,24,12">
      <TextBlock Style="{StaticResource RigShift.Text.Subtitle}" Text="{loc:Tr App_Browse}" />
      <TextBox
        x:Name="SearchBox"
        Margin="0,14,0,0"
        AutomationProperties.Name="{loc:Tr AppPicker_Search}"
        PreviewKeyDown="OnSearchKeyDown"
        Style="{StaticResource RigShift.Field.Search}"
        Tag="{loc:Tr AppPicker_Search}"
        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="16,0">
      <ListBox
        x:Name="AppList"
        AutomationProperties.Name="{loc:Tr App_Browse}"
        Background="Transparent"
        BorderThickness="0"
        HorizontalContentAlignment="Stretch"
        ItemContainerStyle="{StaticResource RigShift.PickerRow}"
        ItemsSource="{Binding Apps}"
        MouseDoubleClick="OnListDoubleClick"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- A generic symbol until the icon is loaded, or for programs without one. -->
              <ui:SymbolIcon FontSize="22" Foreground="{DynamicResource RigShift.Brush.TextSecondary}" Symbol="Apps24">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
              <Image Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RigShift.Text.Body}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource RigShift.Text.Caption}" Text="{Binding ShownPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShownPath}" />
              </StackPanel>
              <ContentControl
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="{loc:Tr AppPicker_Running}"
                Style="{StaticResource RigShift.Chip}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Style="{StaticResource RigShift.Text.Caption}"
        Text="{loc:Tr AppPicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource RigShift.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            Click="OnChoose"
            Content="{loc:Tr AppPicker_Choose}"
            IsDefault="True"
            IsEnabled="{Binding CanChoose}"
            Style="{StaticResource RigShift.Button.Primary}" />
          <Button Content="{loc:Tr Common_Cancel}" IsCancel="True" Style="{StaticResource RigShift.Button}" />
        </StackPanel>
        <Button HorizontalAlignment="Left" Click="OnBrowseFile" Content="{loc:Tr AppPicker_BrowseFile}" Style="{StaticResource RigShift.Button.Ghost}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

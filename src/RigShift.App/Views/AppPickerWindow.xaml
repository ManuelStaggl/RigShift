<ui:FluentWindow
  x:Class="RigShift.App.Views.AppPickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr App_Browse}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  Height="640"
  MinWidth="420"
  MinHeight="400"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Tr App_Browse}" ShowMaximize="False" ShowMinimize="False" />

    <ui:TextBox
      x:Name="SearchBox"
      Grid.Row="1"
      Margin="24,8,24,12"
      AutomationProperties.Name="{loc:Tr AppPicker_Search}"
      Icon="{ui:SymbolIcon Search24}"
      PlaceholderText="{loc:Tr AppPicker_Search}"
      PreviewKeyDown="OnSearchKeyDown"
      Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

    <Grid Grid.Row="2" Margin="24,0">
      <ListBox
        x:Name="AppList"
        AutomationProperties.Name="{loc:Tr App_Browse}"
        ItemsSource="{Binding Apps}"
        MouseDoubleClick="OnListDoubleClick"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- A generic symbol until the icon is loaded, or for programs without one. -->
              <Border Width="32" Height="32" VerticalAlignment="Center">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <ui:SymbolIcon FontSize="26" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Apps24" />
              </Border>
              <Image Width="32" Height="32" VerticalAlignment="Center" Source="{Binding Icon}" />
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border
                Grid.Column="3"
                Margin="12,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="4"
                Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr AppPicker_Running}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr AppPicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    </Grid>

    <Grid Grid.Row="3" Margin="24,16,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button HorizontalAlignment="Left" Click="OnBrowseFile" Content="{loc:Tr AppPicker_BrowseFile}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Appearance="Primary" Click="OnChoose" Content="{loc:Tr AppPicker_Choose}" IsDefault="True" IsEnabled="{Binding CanChoose}" />
        <ui:Button Content="{loc:Tr Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>

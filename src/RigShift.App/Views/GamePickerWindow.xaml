<ui:FluentWindow
  x:Class="RigShift.App.Views.GamePickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{Binding WindowTitle}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  Height="600"
  MinWidth="420"
  MinHeight="380"
  Background="{DynamicResource RigShift.Brush.Page}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <!-- D-01: title in the content, 48 px rows with the games' own icons, a foot on the chrome surface. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Height="32" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,0,24,12">
      <TextBlock Style="{StaticResource RigShift.Text.Subtitle}" Text="{Binding WindowTitle}" />
      <TextBlock
        Margin="0,6,0,0"
        Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
        Style="{StaticResource RigShift.Text.Body}"
        Text="{Binding Intro}"
        TextWrapping="Wrap" />
      <TextBox
        x:Name="SearchBox"
        Margin="0,14,0,0"
        AutomationProperties.Name="{loc:Tr GamePicker_Search}"
        PreviewKeyDown="OnSearchKeyDown"
        Style="{StaticResource RigShift.Field.Search}"
        Tag="{loc:Tr GamePicker_Search}"
        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="16,0">
      <ListBox
        x:Name="GameList"
        AutomationProperties.Name="{loc:Tr GamePicker_Title}"
        Background="Transparent"
        BorderThickness="0"
        HorizontalContentAlignment="Stretch"
        ItemContainerStyle="{StaticResource RigShift.PickerRow}"
        ItemsSource="{Binding Games}"
        MouseDoubleClick="OnListDoubleClick"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}"
        VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Name}"
                IsChecked="{Binding IsChecked}"
                Style="{StaticResource RigShift.Check}"
                Visibility="{Binding DataContext.IsMultiple, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}" />
              <!-- The game's own icon: it says more about the game than any symbol we could pick for it. -->
              <Border
                Grid.Column="1"
                Width="28"
                Height="28"
                Margin="0,0,12,0"
                Background="{DynamicResource RigShift.Brush.HoverOverlay}"
                ClipToBounds="True"
                CornerRadius="6">
                <Grid>
                  <ui:SymbolIcon
                    FontSize="16"
                    Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                    Symbol="Games20"
                    Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                  <Image
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="{Binding Icon}"
                    Stretch="UniformToFill"
                    Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Border>
              <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource RigShift.Text.Body}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <ContentControl
                Grid.Column="3"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="{Binding Source}"
                Style="{StaticResource RigShift.Chip}"
                Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Style="{StaticResource RigShift.Text.Caption}"
        Text="{loc:Tr GamePicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource RigShift.DialogFooter}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button
            Margin="0,0,8,0"
            Click="OnChoose"
            Content="{Binding ChooseText}"
            IsDefault="True"
            IsEnabled="{Binding CanChoose}"
            Style="{StaticResource RigShift.Button.Primary}" />
          <Button Content="{loc:Tr Common_Cancel}" IsCancel="True" Style="{StaticResource RigShift.Button}" />
        </StackPanel>
        <Button
          HorizontalAlignment="Left"
          Click="OnBrowseFile"
          Content="{loc:Tr GamePicker_BrowseFile}"
          Style="{StaticResource RigShift.Button.Ghost}"
          Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}" />
      </DockPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

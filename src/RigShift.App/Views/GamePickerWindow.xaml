<ui:FluentWindow
  x:Class="RigShift.App.Views.GamePickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{loc:Tr GamePicker_Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  Height="600"
  MinWidth="420"
  MinHeight="380"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{loc:Tr GamePicker_Title}" ShowMaximize="False" ShowMinimize="False" />

    <TextBlock
      Grid.Row="1"
      Margin="24,8,24,12"
      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
      Text="{loc:Tr GamePicker_Intro}"
      TextWrapping="Wrap" />

    <Grid Grid.Row="2" Margin="24,0">
      <ListBox
        x:Name="GameList"
        AutomationProperties.Name="{loc:Tr GamePicker_Title}"
        ItemsSource="{Binding Games}"
        MouseDoubleClick="OnListDoubleClick"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}"
        VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="4">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr GamePicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    </Grid>

    <Grid Grid.Row="3" Margin="24,16,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button HorizontalAlignment="Left" Click="OnBrowseFile" Content="{loc:Tr GamePicker_BrowseFile}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Appearance="Primary"
          Click="OnChoose"
          Content="{loc:Tr AppPicker_Choose}"
          IsDefault="True"
          IsEnabled="{Binding CanChoose}" />
        <ui:Button Content="{loc:Tr Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>

<ui:FluentWindow
  x:Class="RigShift.App.Views.GamePickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{Binding WindowTitle}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="620"
  Height="600"
  MinWidth="420"
  MinHeight="380"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding WindowTitle}" ShowMaximize="False" ShowMinimize="False" />

    <StackPanel Grid.Row="1" Margin="24,8,24,12">
      <TextBlock
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding Intro}"
        TextWrapping="Wrap" />
      <ui:TextBox
        x:Name="SearchBox"
        Margin="0,12,0,0"
        AutomationProperties.Name="{loc:Tr GamePicker_Search}"
        Icon="{ui:SymbolIcon Search24}"
        PlaceholderText="{loc:Tr GamePicker_Search}"
        PreviewKeyDown="OnSearchKeyDown"
        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="24,0">
      <ListBox
        x:Name="GameList"
        AutomationProperties.Name="{loc:Tr GamePicker_Title}"
        ItemsSource="{Binding Games}"
        MouseDoubleClick="OnListDoubleClick"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        SelectedItem="{Binding Selected}"
        VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Name}"
                IsChecked="{Binding IsChecked}"
                Visibility="{Binding DataContext.IsMultiple, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Visible}}" />
              <!-- The game's own icon: it says more about the game than any symbol we could pick for it. -->
              <Image
                Grid.Column="1"
                Width="20"
                Height="20"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="{Binding Icon}"
                Visibility="{Binding HasIcon, Converter={StaticResource Visible}}" />
              <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis" />
              <Border
                Grid.Column="3"
                Margin="12,0,0,0"
                Padding="8,2"
                VerticalAlignment="Center"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="4">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Source}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
      <TextBlock
        Margin="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr GamePicker_Empty}"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
    </Grid>

    <Grid Grid.Row="3" Margin="24,16,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button
        HorizontalAlignment="Left"
        Click="OnBrowseFile"
        Content="{loc:Tr GamePicker_BrowseFile}"
        Visibility="{Binding IsSingle, Converter={StaticResource Visible}}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ui:Button
          Margin="0,0,8,0"
          Appearance="Primary"
          Click="OnChoose"
          Content="{Binding ChooseText}"
          IsDefault="True"
          IsEnabled="{Binding CanChoose}" />
        <ui:Button Content="{loc:Tr Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</ui:FluentWindow>

<ui:FluentWindow
  x:Class="RigShift.App.Views.SetupWizardWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  d:DataContext="{d:DesignInstance vm:SetupWizardViewModel}"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="{loc:Tr Setup_Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="880"
  Height="600"
  MinWidth="720"
  MinHeight="560"
  Background="{DynamicResource RigShift.Brush.Chrome}"
  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
  FontFamily="{DynamicResource RigShift.Font.Text}"
  FontSize="14"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="True"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner"
  TextOptions.TextFormattingMode="Display">
  <ui:FluentWindow.Resources>
    <!-- A 22 px numbered circle: filled once the step is done, outlined in the accent while it is the current one. -->
    <Style x:Key="StepCircle" TargetType="Border">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Line}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Mono}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource RigShift.Brush.TextSecondary}" />
    </Style>

    <!-- One entry of the step list on the left. -->
    <DataTemplate x:Key="StepRow" DataType="{x:Type vm:WizardStepItem}">
      <Grid Height="36">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Circle" Style="{StaticResource StepCircle}">
          <Grid>
            <TextBlock
              x:Name="Number"
              Style="{StaticResource StepNumber}"
              Text="{Binding Number}"
              Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:SymbolIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource RigShift.Brush.OnAccent}"
              Symbol="Checkmark24"
              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Border>
        <TextBlock
          x:Name="Label"
          Grid.Column="1"
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource RigShift.Text.Body}"
          Text="{Binding Text}"
          TextTrimming="CharacterEllipsis" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="Circle" Property="Background" Value="{DynamicResource RigShift.Brush.Accent}" />
          <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource RigShift.Brush.Accent}" />
          <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource RigShift.Brush.TextPrimary}" />
          <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsAhead}" Value="True">
          <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource RigShift.Brush.TextDisabled}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: symbol, name and what this window is for (R-BRAND-1). -->
    <Grid Grid.Row="0">
      <ui:TitleBar
        Height="40"
        Title="RigShift"
        FontWeight="SemiBold"
        Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
        ShowMaximize="False"
        ShowMinimize="False">
        <ui:TitleBar.Icon>
          <ui:ImageIcon
            Width="18"
            Height="18"
            Source="pack://application:,,,/Assets/Brand/rigshift-app-light.ico" />
        </ui:TitleBar.Icon>
      </ui:TitleBar>
      <!-- What this window is for, beside the name; the title bar itself takes no second line of text. -->
      <TextBlock
        Margin="108,0,0,0"
        HorizontalAlignment="Left"
        VerticalAlignment="Center"
        IsHitTestVisible="False"
        Style="{StaticResource RigShift.Text.Caption}"
        Text="{loc:Tr Setup_Subtitle}" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Step list: where the user is, and how much is left. -->
      <DockPanel Grid.Column="0" Margin="16,24,16,16">
        <Button
          Command="{Binding SkipCommand}"
          Content="{loc:Tr Setup_SkipAll}"
          DockPanel.Dock="Bottom"
          HorizontalAlignment="Left"
          Style="{StaticResource RigShift.Button.Ghost}" />
        <ItemsControl
          DockPanel.Dock="Top"
          Focusable="False"
          ItemTemplate="{StaticResource StepRow}"
          ItemsSource="{Binding StepList}" />
        <Border />
      </DockPanel>

      <!-- Page surface: lighter than the chrome, rounded at the top left, like the main window. -->
      <Border
        Grid.Column="1"
        Background="{DynamicResource RigShift.Brush.Page}"
        BorderBrush="{DynamicResource RigShift.Brush.Line}"
        BorderThickness="1,1,0,0"
        ClipToBounds="True"
        CornerRadius="8,0,0,0"
        SnapsToDevicePixels="True">
        <Grid Margin="32,24,32,20">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- Welcome: the horizontal logo with the slogan, once in the whole app (R-BRAND-1). One block, centred. -->
          <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
            <Image
              Width="400"
              HorizontalAlignment="Center"
              RenderOptions.BitmapScalingMode="HighQuality"
              Source="pack://application:,,,/Assets/Brand/rigshift-horizontal-tagline.png"
              Stretch="Uniform" />
            <TextBlock
              MaxWidth="440"
              Margin="0,28,0,0"
              HorizontalAlignment="Center"
              Style="{StaticResource RigShift.Text.Caption}"
              Text="{loc:Tr Setup_Tagline}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
            <ItemsControl
              Width="400"
              Margin="0,28,0,0"
              HorizontalAlignment="Center"
              Focusable="False"
              ItemTemplate="{StaticResource StepRow}"
              ItemsSource="{Binding WelcomeList}" />
          </StackPanel>

          <ScrollViewer
            Grid.Row="0"
            Margin="0,0,-12,0"
            Padding="0,0,12,0"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsWelcome, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel>
              <!-- Heading of every step but the welcome one. -->
              <StackPanel>
                <ui:TextBlock
                  x:Name="StepHeading"
                  controls:LiveRegion.IsLive="True"
                  FontTypography="Title"
                  Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
                  Text="{Binding StepTitle}"
                  TextWrapping="Wrap" />
                <TextBlock
                  Margin="0,6,0,0"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{Binding StepText}"
                  TextWrapping="Wrap" />
              </StackPanel>

              <controls:InfoBar
                Margin="0,20,0,0"
                Kind="Error"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

              <!-- Profile steps: the live picture, a name and the playback device. -->
              <StackPanel Visibility="{Binding IsProfileStep, Converter={StaticResource BoolToVisibility}}">
                <controls:InfoBar
                  Margin="0,20,0,0"
                  controls:LiveRegion.IsLive="True"
                  Kind="Warn"
                  Text="{loc:Tr Setup_SameText}"
                  Visibility="{Binding MatchesFirst, Converter={StaticResource BoolToVisibility}}" />
                <controls:InfoBar
                  Margin="0,20,0,0"
                  Kind="Info"
                  Text="{Binding DifferentText}"
                  Visibility="{Binding IsDifferent, Converter={StaticResource BoolToVisibility}}" />

                <ContentControl Margin="0,20,0,0" Style="{StaticResource RigShift.TopologyPanel}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                      <TextBlock
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        Style="{StaticResource RigShift.Text.Caption}"
                        Text="{loc:Tr Setup_Now}" />
                      <Button
                        Height="28"
                        Command="{Binding OpenDisplaySettingsCommand}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource RigShift.Button.Ghost}">
                        <StackPanel Orientation="Horizontal">
                          <ui:SymbolIcon Margin="0,0,8,0" FontSize="16" Symbol="Open16" />
                          <TextBlock Text="{loc:Tr Setup_OpenDisplaySettings}" />
                        </StackPanel>
                      </Button>
                    </DockPanel>
                    <controls:DisplayTopology
                      Grid.Row="1"
                      Height="115"
                      Margin="0,12,0,0"
                      Displays="{Binding Topology}"
                      Size="M"
                      Visibility="{Binding HasDisplays, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Style="{StaticResource RigShift.Text.Body}"
                      Text="{loc:Tr Setup_NoDisplays}"
                      Visibility="{Binding HasNoDisplays, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </ContentControl>

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="260" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr Editor_Name}" />
                    <TextBox
                      x:Name="NameBox"
                      AutomationProperties.Name="{loc:Tr Editor_Name}"
                      MaxLength="60"
                      Style="{StaticResource RigShift.Field}"
                      Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                      Margin="0,4,0,0"
                      Style="{StaticResource RigShift.Text.FieldError}"
                      Text="{Binding NameProblem}"
                      Visibility="{Binding HasNameProblem, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{Binding Playback.Label}" />
                    <ComboBox
                      AutomationProperties.Name="{Binding Playback.Label}"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Playback.Choices}"
                      SelectedItem="{Binding Playback.Selected}"
                      Style="{StaticResource RigShift.Select}" />
                  </StackPanel>
                </Grid>
                <TextBlock
                  Margin="0,12,0,0"
                  Style="{StaticResource RigShift.Text.Caption}"
                  Text="{loc:Tr Setup_DetailsLater}"
                  TextWrapping="Wrap" />
              </StackPanel>

              <!-- Trigger step: turn the device on, RigShift picks it. -->
              <StackPanel Visibility="{Binding IsTrigger, Converter={StaticResource BoolToVisibility}}">
                <controls:InfoBar
                  Margin="0,20,0,0"
                  controls:LiveRegion.IsLive="True"
                  Kind="Info"
                  Text="{Binding DetectedMessage}"
                  Visibility="{Binding HasDetected, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Width="360" Margin="0,20,0,0" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource RigShift.Text.Label}" Text="{loc:Tr Automation_Device}" />
                  <ComboBox
                    AutomationProperties.Name="{loc:Tr Automation_Device}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding DeviceChoices}"
                    SelectedItem="{Binding SelectedDevice}"
                    Style="{StaticResource RigShift.Select}" />
                </StackPanel>

                <Border Margin="0,16,0,0" Style="{StaticResource RigShift.Card}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,12,0"
                      VerticalAlignment="Top"
                      FontSize="16"
                      Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                      Symbol="UsbPlug24" />
                    <TextBlock
                      MaxWidth="520"
                      Style="{StaticResource RigShift.Text.Body}"
                      Text="{Binding RuleText}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <controls:InfoBar
                  Margin="0,16,0,0"
                  Kind="Warn"
                  Text="{loc:Tr Automation_PowerSavingText}"
                  ToolTip="{loc:Tr Automation_PowerSavingTitle}"
                  Visibility="{Binding HasPowerWarning, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <!-- Done: the two profiles as cards and the rule as a sentence. -->
              <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl Margin="0,20,0,0" Focusable="False" ItemsSource="{Binding Summary}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="280" Margin="0,0,12,0" Style="{StaticResource RigShift.Card}">
                        <StackPanel>
                          <Border
                            Height="60"
                            Background="{DynamicResource RigShift.Brush.Chrome}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <controls:DisplayTopology
                              Width="200"
                              Height="52"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Displays="{Binding Topology}"
                              Size="S" />
                          </Border>
                          <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource RigShift.Text.BodyStrong}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                          <ItemsControl Margin="0,2,0,0" Focusable="False" ItemsSource="{Binding DisplayLines}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock
                                  Style="{StaticResource RigShift.Text.Caption}"
                                  Text="{Binding}"
                                  TextTrimming="CharacterEllipsis" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border
                  Margin="0,12,0,0"
                  Padding="16,12"
                  Style="{StaticResource RigShift.Card}"
                  Visibility="{Binding HasRuleSummary, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                      Margin="0,0,12,0"
                      VerticalAlignment="Top"
                      FontSize="16"
                      Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
                      Symbol="UsbPlug24" />
                    <TextBlock
                      MaxWidth="520"
                      Style="{StaticResource RigShift.Text.Body}"
                      Text="{Binding RuleSummary}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- One row of actions: back on the left, the step's primary on the right (R-ACT-1). -->
          <Grid Grid.Row="1" Margin="0,20,0,0">
            <Button
              HorizontalAlignment="Left"
              Command="{Binding BackCommand}"
              Content="{loc:Tr Common_Back}"
              Style="{StaticResource RigShift.Button.Ghost}"
              Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button
                x:Name="StartButton"
                MinWidth="120"
                Command="{Binding StartCommand}"
                Content="{loc:Tr Setup_Start}"
                Style="{StaticResource RigShift.Button.Primary}"
                Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}" />
              <Button
                MinWidth="120"
                Command="{Binding SaveProfileCommand}"
                Content="{loc:Tr Setup_SaveContinue}"
                Style="{StaticResource RigShift.Button.Primary}"
                Visibility="{Binding IsProfileStep, Converter={StaticResource BoolToVisibility}}" />
              <Button
                Margin="0,0,8,0"
                Command="{Binding SkipTriggerCommand}"
                Content="{loc:Tr Setup_NoTrigger}"
                Style="{StaticResource RigShift.Button}"
                Visibility="{Binding IsTrigger, Converter={StaticResource BoolToVisibility}}" />
              <Button
                MinWidth="120"
                Command="{Binding CreateRuleCommand}"
                Content="{loc:Tr Setup_CreateRule}"
                Style="{StaticResource RigShift.Button.Primary}"
                Visibility="{Binding IsTrigger, Converter={StaticResource BoolToVisibility}}" />
              <Button
                MinWidth="120"
                Command="{Binding SkipCommand}"
                Content="{loc:Tr Setup_Finish}"
                Style="{StaticResource RigShift.Button.Primary}"
                Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ui:FluentWindow>

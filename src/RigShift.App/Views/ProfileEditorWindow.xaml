<ui:FluentWindow
  x:Class="RigShift.App.Views.ProfileEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{Binding Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="760"
  Height="720"
  MinWidth="560"
  MinHeight="420"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

    <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,8,24,16">
        <ui:InfoBar
          Margin="0,0,0,16"
          Title="{loc:Tr Editor_ProblemsTitle}"
          IsClosable="False"
          IsOpen="{Binding HasProblems, Mode=OneWay}"
          Message="{Binding Problems}"
          Severity="Error"
          AutomationProperties.LiveSetting="Assertive" />

        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Name}" />
        <ui:TextBox
          x:Name="NameBox"
          Margin="0,4,0,16"
          AutomationProperties.Name="{loc:Tr Editor_Name}"
          Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Same column grid as the audio rows below: labels/left controls 220, gap 24, rest. -->
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Icon}" />
          <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_ConfirmTime}" />
          <ComboBox
              Grid.Row="1"
              Margin="0,4,0,0"
              VerticalAlignment="Center"
              AutomationProperties.Name="{loc:Tr Editor_Icon}"
              ItemsSource="{Binding IconChoices}"
              SelectedItem="{Binding SelectedIcon}"
              TextSearch.TextPath="Name">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <controls:ProfileIcon Width="20" Height="20" VerticalAlignment="Center" IconKey="{Binding Key}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" VerticalAlignment="Center" Orientation="Horizontal">
            <CheckBox VerticalAlignment="Center" Content="{loc:Tr Editor_OwnTimeoutShort}" IsChecked="{Binding UseOwnTimeout}" />
            <ui:NumberBox
              Width="140"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              AutomationProperties.Name="{loc:Tr Editor_OwnTimeout}"
              IsEnabled="{Binding UseOwnTimeout}"
              MaxDecimalPlaces="0"
              Maximum="120"
              Minimum="0"
              SmallChange="1"
              Value="{Binding OwnTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TimeoutHint}" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Hotkey}" />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox
            x:Name="HotkeyBox"
            AutomationProperties.HelpText="{Binding HotkeyHint}"
            AutomationProperties.Name="{loc:Tr Editor_Hotkey}"
            ClearButtonEnabled="False"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            PlaceholderText="{loc:Tr Editor_HotkeyPlaceholder}"
            PreviewKeyDown="OnHotkeyKeyDown"
            Text="{Binding HotkeyText, Mode=OneWay}" />
          <ui:Button
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
            Command="{Binding ClearHotkeyCommand}"
            Icon="{ui:SymbolIcon Dismiss24}"
            IsEnabled="{Binding HasHotkey}"
            ToolTip="{loc:Tr Editor_HotkeyClear}" />
        </Grid>
        <TextBlock
          Margin="0,4,0,0"
          AutomationProperties.LiveSetting="Polite"
          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
          Text="{Binding HotkeyHint}"
          TextWrapping="Wrap" />

        <Grid Margin="0,24,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Displays}" />
          <ui:Button Grid.Column="1" Command="{Binding TakeCurrentCommand}" Content="{loc:Tr Editor_TakeCurrent}" Icon="{ui:SymbolIcon ArrowSync24}" />
        </Grid>
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Editor_DisplaysHint}" TextWrapping="Wrap" />
        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ArrangementNote}" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <!-- No empty line between the hint and the list while there is no note. -->
                <DataTrigger Binding="{Binding ArrangementNote}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ItemsControl Margin="0,12,0,0" Focusable="False" ItemsSource="{Binding Displays}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,0,8" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ModeText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <RadioButton
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding Name}"
                    Content="{loc:Tr Editor_Primary}"
                    GroupName="PrimaryDisplay"
                    IsChecked="{Binding IsPrimary}" />
                  <CheckBox
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding Name}"
                    Content="{loc:Tr Editor_Optional}"
                    IsChecked="{Binding IsOptional}"
                    IsEnabled="{Binding CanBeOptional}" />
                  <ui:Button
                    Grid.Column="3"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding Name}"
                    AutomationProperties.Name="{loc:Tr Editor_Remove}"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{loc:Tr Editor_Remove}" />
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,16,0,8" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Audio}" />
        <ItemsControl Focusable="False" ItemsSource="{Binding AudioSlots}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Label}" TextWrapping="Wrap" />
                <ComboBox
                  Grid.Column="2"
                  AutomationProperties.Name="{Binding Label}"
                  DisplayMemberPath="Name"
                  ItemsSource="{Binding Choices}"
                  SelectedItem="{Binding Selected}" />
                <Grid
                  Grid.Row="1"
                  Grid.Column="2"
                  Margin="0,6,0,4"
                  IsEnabled="{Binding HasDevice}"
                  Visibility="{Binding SupportsVolume, Converter={StaticResource BoolToVisibility}}">
                  <Grid.Resources>
                    <!-- WPF-UI draws a disabled slider like an enabled one; dim it so "off" is visible. -->
                    <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
                      <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Grid.Resources>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                  </Grid.ColumnDefinitions>
                  <CheckBox
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding Label}"
                    Content="{loc:Tr Audio_SetVolume}"
                    IsChecked="{Binding SetVolume}" />
                  <Slider
                    x:Name="VolumeSlider"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="{Binding Label}"
                    AutomationProperties.Name="{loc:Tr Audio_SetVolume}"
                    IsEnabled="{Binding SetVolume}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Volume}" />
                  <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding VolumeText}"
                    TextAlignment="Right">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsEnabled, ElementName=VolumeSlider}" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,24,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Editor_Apps}" />
          <ui:Button Grid.Column="1" Command="{Binding AddAppCommand}" Content="{loc:Tr Editor_AddApp}" Icon="{ui:SymbolIcon Add24}" />
        </Grid>
        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Editor_AppsHint}" TextWrapping="Wrap" />

        <ItemsControl Margin="0,12,0,0" Focusable="False" ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,0,8" Padding="16,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ComboBox
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Tr App_Action}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding KindChoices}"
                    SelectedItem="{Binding SelectedKind}" />
                  <ui:TextBox
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Tr App_Path}"
                    PlaceholderText="{loc:Tr App_PathPlaceholder}"
                    Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{loc:Tr App_Browse}"
                    Click="OnBrowseApp"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="{loc:Tr App_Browse}" />
                  <ui:Button
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{loc:Tr App_Remove}"
                    Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{loc:Tr App_Remove}" />
                  <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{loc:Tr App_Arguments}"
                      IsEnabled="{Binding IsStart}"
                      PlaceholderText="{loc:Tr App_Arguments}"
                      Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr App_Wait}" />
                      <ui:NumberBox
                        Width="120"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:Tr App_Wait}"
                        MaxDecimalPlaces="0"
                        Maximum="300"
                        Minimum="0"
                        SmallChange="1"
                        Value="{Binding WaitSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="{loc:Tr Common_Cancel}" IsCancel="True" />
        <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="{loc:Tr Editor_Save}" Icon="{ui:SymbolIcon Save24}" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

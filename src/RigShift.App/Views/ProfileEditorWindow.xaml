<ui:FluentWindow
  x:Class="RigShift.App.Views.ProfileEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  Title="{Binding Title}"
  Icon="pack://application:,,,/Assets/Brand/rigshift-app-light.ico"
  Width="900"
  Height="720"
  MinWidth="560"
  MinHeight="420"
  ExtendsContentIntoTitleBar="True"
  ShowInTaskbar="False"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round"
  WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

    <!-- Sections General, Displays, Audio, Behavior, Apps; labels above every field. -->
    <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,0,24,16">
        <ui:InfoBar
          Margin="0,8,0,0"
          Title="{loc:Tr Editor_ProblemsTitle}"
          IsClosable="False"
          IsOpen="{Binding HasProblems, Mode=OneWay}"
          Message="{Binding Problems}"
          Severity="Error"
          AutomationProperties.LiveSetting="Assertive" />

        <ui:TextBlock Margin="0,8,0,8" Style="{StaticResource SectionHeader}" Text="{loc:Tr Editor_General}" />
        <!-- Two columns that wrap below each other in a narrow window. -->
        <WrapPanel>
          <StackPanel Width="360" Margin="0,0,24,12">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Editor_Name}" />
            <ui:TextBox
              x:Name="NameBox"
              AutomationProperties.Name="{loc:Tr Editor_Name}"
              MaxLength="60"
              Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Width="220" Margin="0,0,24,12">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Editor_Icon}" />
            <ComboBox
              AutomationProperties.Name="{loc:Tr Editor_Icon}"
              ItemsSource="{Binding IconChoices}"
              SelectedItem="{Binding SelectedIcon}"
              TextSearch.TextPath="Name">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <controls:ProfileIcon Width="20" Height="20" VerticalAlignment="Center" IconKey="{Binding Key}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </WrapPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Editor_Hotkey}" />
        <StackPanel Orientation="Horizontal">
          <ui:TextBox
            x:Name="HotkeyBox"
            Width="360"
            AutomationProperties.HelpText="{loc:Tr Hotkey_RecordTip}"
            AutomationProperties.Name="{loc:Tr Editor_Hotkey}"
            ClearButtonEnabled="False"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            PlaceholderText="{loc:Tr Editor_HotkeyPlaceholder}"
            PreviewKeyDown="OnHotkeyKeyDown"
            Text="{Binding HotkeyText, Mode=OneWay}"
            ToolTip="{loc:Tr Hotkey_RecordTip}" />
          <ui:Button
            Margin="8,0,0,0"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="{loc:Tr Editor_HotkeyClear}"
            Command="{Binding ClearHotkeyCommand}"
            Icon="{ui:SymbolIcon Dismiss24}"
            IsEnabled="{Binding HasHotkey}"
            ToolTip="{loc:Tr Editor_HotkeyClear}" />
        </StackPanel>
        <TextBlock Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Caption}" Text="{Binding HotkeyHint}" />

        <Grid Margin="0,24,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <ui:TextBlock Margin="0" Style="{StaticResource SectionHeader}" Text="{loc:Tr Editor_Displays}" />
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr Editor_DisplaysHint}" />
          </StackPanel>
          <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Command="{Binding TakeCurrentCommand}" Content="{loc:Tr Editor_TakeCurrent}" />
        </Grid>
        <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ArrangementNote}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <!-- No empty line between the header and the list while there is no note. -->
                <DataTrigger Binding="{Binding ArrangementNote}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ItemsControl Focusable="False" ItemsSource="{Binding Displays}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,0,4" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding ModeText}" />
                    <!-- Display names are edited on the Displays page only (analysis decision O-05). -->
                    <WrapPanel Margin="0,8,0,0">
                      <ComboBox
                        MinWidth="120"
                        Margin="0,0,8,0"
                        AutomationProperties.HelpText="{Binding Name}"
                        AutomationProperties.Name="{loc:Tr Editor_RefreshRate}"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding RefreshChoices}"
                        SelectedItem="{Binding SelectedRefresh}"
                        ToolTip="{loc:Tr Editor_RefreshRateHint}" />
                      <ComboBox
                        MinWidth="150"
                        Margin="0,0,24,0"
                        AutomationProperties.HelpText="{Binding Name}"
                        AutomationProperties.Name="HDR"
                        DisplayMemberPath="Text"
                        ItemsSource="{Binding HdrChoices}"
                        SelectedItem="{Binding SelectedHdr}"
                        ToolTip="{loc:Tr Editor_HdrHint}" />
                      <!-- Wrap below the selections in a narrow window instead of cutting them off (analysis finding I-08). -->
                      <RadioButton
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="{Binding Name}"
                        Content="{loc:Tr Editor_Primary}"
                        GroupName="PrimaryDisplay"
                        IsChecked="{Binding IsPrimary}" />
                      <CheckBox
                        VerticalAlignment="Center"
                        AutomationProperties.HelpText="{Binding Name}"
                        Content="{loc:Tr Editor_Optional}"
                        IsChecked="{Binding IsOptional}"
                        IsEnabled="{Binding CanBeOptional}" />
                    </WrapPanel>
                    <TextBlock
                      Margin="0,4,0,0"
                      Style="{StaticResource Caption}"
                      Text="{loc:Tr Editor_RefreshRatesUnknown}"
                      Visibility="{Binding RatesUnknown, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Switching HDR froze a test PC over HDMI, also from the Windows settings (finding HW-12). -->
                    <TextBlock
                      Margin="0,4,0,0"
                      Foreground="{DynamicResource SystemFillColorCautionBrush}"
                      Text="{loc:Tr Editor_HdrWarning}"
                      TextWrapping="Wrap"
                      Visibility="{Binding SwitchesHdr, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <ui:Button
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    AutomationProperties.HelpText="{Binding Name}"
                    AutomationProperties.Name="{loc:Tr Editor_Remove}"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{loc:Tr Editor_Remove}" />
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Editor_Audio}" />
        <ItemsControl x:Name="AudioItems" Focusable="False" ItemsSource="{Binding AudioSlots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="360" Margin="0,0,0,12" HorizontalAlignment="Left">
                  <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                  <ComboBox
                    AutomationProperties.Name="{Binding Label}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Choices}"
                    SelectedItem="{Binding Selected}" />
                  <Grid Margin="0,8,0,0" IsEnabled="{Binding HasDevice}" Visibility="{Binding SupportsVolume, Converter={StaticResource BoolToVisibility}}">
                    <Grid.Resources>
                      <!-- WPF-UI draws a disabled slider like an enabled one; dim it so "off" is visible. -->
                      <Style BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
                        <Style.Triggers>
                          <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="{Binding Label}"
                      Content="{loc:Tr Audio_SetVolume}"
                      IsChecked="{Binding SetVolume}" />
                    <Slider
                      x:Name="VolumeSlider"
                      Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      AutomationProperties.HelpText="{Binding Label}"
                      AutomationProperties.Name="{loc:Tr Audio_SetVolume}"
                      IsEnabled="{Binding SetVolume}"
                      IsSnapToTickEnabled="True"
                      LargeChange="10"
                      Maximum="100"
                      Minimum="0"
                      SmallChange="1"
                      TickFrequency="1"
                      Value="{Binding Volume}" />
                    <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                      Text="{Binding VolumeText}"
                      TextAlignment="Right">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=VolumeSlider}" Value="False">
                              <Setter Property="Opacity" Value="0.4" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        <!-- Call devices follow playback and recording unless set here (analysis decision O-02). -->
        <Expander
          HorizontalAlignment="Stretch"
          Header="{loc:Tr Editor_AudioAdvanced}"
          IsExpanded="{Binding ShowCommunicationsAudio, Mode=OneTime}">
          <ItemsControl
            Margin="0,8,0,0"
            Focusable="False"
            ItemTemplate="{Binding ItemTemplate, ElementName=AudioItems}"
            ItemsSource="{Binding CommunicationsAudioSlots}" />
        </Expander>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Tr Editor_Behavior}" />
        <!-- Seconds come from the settings only (analysis decision O-01). -->
        <CheckBox Content="{loc:Tr Editor_SwitchWithoutAsking}" IsChecked="{Binding SwitchWithoutAsking}" IsEnabled="{Binding ConfirmationEnabled}" />
        <!-- Off in the settings, the checkbox changes nothing; say where the setting is (finding HW-02). -->
        <TextBlock
          Margin="28,0,0,4"
          Style="{StaticResource Caption}"
          Text="{loc:Tr Editor_ConfirmationOff}"
          Visibility="{Binding ConfirmationDisabled, Converter={StaticResource BoolToVisibility}}" />
        <CheckBox Content="{loc:Tr Editor_DisableDucking}" IsChecked="{Binding DisableCommunicationsDucking}" ToolTip="{loc:Tr Editor_DisableDuckingHint}" />
        <CheckBox Content="{loc:Tr Editor_KeepAwake}" IsChecked="{Binding KeepAwake}" ToolTip="{loc:Tr Editor_KeepAwakeHint}" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{loc:Tr Editor_PowerHint}" />

        <Grid Margin="0,24,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <ui:TextBlock Margin="0" Style="{StaticResource SectionHeader}" Text="{loc:Tr Editor_Apps}" />
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr Editor_AppsHint}" />
          </StackPanel>
          <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnAddApp" Content="{loc:Tr Editor_AddApp}" />
        </Grid>

        <!-- Fixed wait of 30 s, no field (analysis decision O-04). -->
        <StackPanel Width="360" Margin="0,0,0,12" HorizontalAlignment="Left" ToolTip="{loc:Tr Editor_AppsWaitHint}">
          <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Editor_AppsWaitDevice}" />
          <ComboBox
            AutomationProperties.HelpText="{loc:Tr Editor_AppsWaitHint}"
            AutomationProperties.Name="{loc:Tr Editor_AppsWaitDevice}"
            DisplayMemberPath="Name"
            ItemsSource="{Binding AppsWaitDeviceChoices}"
            SelectedItem="{Binding SelectedAppsWaitDevice}" />
        </StackPanel>

        <ItemsControl Focusable="False" ItemsSource="{Binding Apps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Margin="0,0,0,4" Padding="16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <!-- The program's own icon; a generic symbol while the path points to nothing with one. -->
                  <Grid Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                    <ui:SymbolIcon FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Symbol="Apps24">
                      <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <Image Source="{Binding Icon}" />
                  </Grid>
                  <ComboBox
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Tr App_Action}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding KindChoices}"
                    SelectedItem="{Binding SelectedKind}" />
                  <ui:TextBox
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Tr App_Path}"
                    PlaceholderText="{loc:Tr App_PathPlaceholder}"
                    Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{loc:Tr App_Browse}"
                    Click="OnBrowseApp"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    ToolTip="{loc:Tr App_Browse}" />
                  <ui:Button
                    Grid.Column="5"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    Appearance="Transparent"
                    AutomationProperties.Name="{loc:Tr App_Remove}"
                    Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="{loc:Tr App_Remove}" />
                  <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,8,0,0">
                    <StackPanel Width="280" Margin="0,0,16,0">
                      <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr App_Arguments}" />
                      <ui:TextBox AutomationProperties.Name="{loc:Tr App_Arguments}" IsEnabled="{Binding IsStart}" Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr App_Wait}" />
                      <ui:NumberBox
                        Width="120"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{loc:Tr App_Wait}"
                        ClearButtonEnabled="False"
                        MaxDecimalPlaces="0"
                        Maximum="300"
                        Minimum="0"
                        SmallChange="1"
                        Value="{Binding WaitSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </WrapPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Windows order: the action first, Cancel last (finding E-06). -->
    <Border Grid.Row="2" Padding="24,12" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ui:Button MinWidth="120" Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveCommand}" Content="{loc:Tr Editor_Save}" IsDefault="True" />
        <ui:Button MinWidth="120" Command="{Binding CancelCommand}" Content="{loc:Tr Common_Cancel}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>

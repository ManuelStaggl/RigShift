<UserControl
  x:Class="RigShift.App.Views.TrayPopupView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization"
  xmlns:vm="clr-namespace:RigShift.App.ViewModels"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:TrayPopupViewModel}">
  <!--
    The daily face of RigShift: profiles with their pictures, then the games, then the three actions. No header and
    no settings – everything that is not switching or starting belongs in the window.
  -->
  <UserControl.Resources>
    <!-- The active profile keeps its surface while the pointer is elsewhere; the check mark says it, not the color. -->
    <Style x:Key="ProfileRow" TargetType="Button" BasedOn="{StaticResource RigShift.TrayRow}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Background" Value="{DynamicResource RigShift.Brush.Selected}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.Body}">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource RigShift.Text.ValueSecondary}">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The game's symbol: a picked one, else its own icon, else the generic glyph. -->
    <DataTemplate x:Key="GameGlyph" DataType="{x:Type vm:GameItem}">
      <Grid Width="20" Height="20">
        <controls:ProfileIcon
          IconKey="{Binding IconKey}"
          IsFilled="{Binding IsRunning}"
          TextElement.Foreground="{DynamicResource RigShift.Brush.TextPrimary}"
          Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
        <Image
          RenderOptions.BitmapScalingMode="HighQuality"
          Source="{Binding GameIcon}"
          Visibility="{Binding HasGameIcon, Converter={StaticResource BoolToVisibility}}" />
        <ui:SymbolIcon
          FontSize="20"
          Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
          Symbol="Games20"
          Visibility="{Binding HasFallbackIcon, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The margin carries the shadow (spec 7.3); without it the effect would be clipped at the popup's edge. -->
  <Border
    Width="320"
    Margin="12"
    Padding="6"
    Background="{DynamicResource RigShift.Brush.Chrome}"
    BorderBrush="{DynamicResource RigShift.Brush.Line}"
    BorderThickness="1"
    CornerRadius="{DynamicResource RigShift.Radius.Card}">
    <Border.Effect>
      <DropShadowEffect
        BlurRadius="24"
        Direction="270"
        Opacity="0.5"
        ShadowDepth="8"
        Color="Black" />
    </Border.Effect>
    <StackPanel>
      <!-- A running switch: where it goes, the one moving element of the popup, and every row disabled below. -->
      <StackPanel Visibility="{Binding Coordinator.IsSwitching, Converter={StaticResource BoolToVisibility}}">
        <TextBlock
          Height="32"
          Margin="10,0"
          VerticalAlignment="Center"
          controls:LiveRegion.IsLive="True"
          Style="{StaticResource RigShift.Text.Caption}"
          Text="{Binding SwitchingText}"
          TextTrimming="CharacterEllipsis" />
        <controls:ProgressLine
          Height="2"
          Margin="10,0,10,6"
          BarBrush="{DynamicResource RigShift.Brush.Accent}"
          TrackBrush="{DynamicResource RigShift.Brush.Line}" />
      </StackPanel>

      <TextBlock
        Margin="10,10"
        Style="{StaticResource RigShift.Text.Caption}"
        Text="{Binding StatusText}"
        TextWrapping="Wrap"
        Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibility}}" />

      <!-- Scrolls instead of growing past the screen with many profiles (analysis finding I-05); MaxHeight set in code. -->
      <ScrollViewer
        x:Name="ProfileList"
        Focusable="False"
        HorizontalScrollBarVisibility="Disabled"
        IsEnabled="{Binding Coordinator.IsIdle}"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl Focusable="False" ItemsSource="{Binding Catalog.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileItem}">
              <Button
                AutomationProperties.Name="{Binding AccessibleName}"
                Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Style="{StaticResource ProfileRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:DisplayTopology
                    Width="56"
                    Height="24"
                    VerticalAlignment="Center"
                    Displays="{Binding Topology}"
                    Size="XS" />
                  <TextBlock Text="{Binding Name}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="FontWeight" Value="{DynamicResource RigShift.Type.Weight.Strong}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Style="{StaticResource RowValue}" Text="{Binding HotkeyText}" />
                  <ui:SymbolIcon
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource RigShift.Brush.Accent}"
                    Symbol="Checkmark24"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Games: starting a race is the second thing the tray is for; a running one says so instead of its hotkey. -->
      <StackPanel IsEnabled="{Binding Coordinator.IsIdle}" Visibility="{Binding Games.HasGames, Converter={StaticResource BoolToVisibility}}">
        <Border Margin="10,6" Style="{StaticResource RigShift.Divider}" />
        <ItemsControl Focusable="False" ItemsSource="{Binding Games.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GameItem}">
              <Button
                AutomationProperties.Name="{Binding PlayText}"
                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding CanPlay}"
                Style="{StaticResource RigShift.TrayRow.Small}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource GameGlyph}" />
                  <TextBlock Style="{StaticResource RowText}" Text="{Binding PlayText}" />
                  <TextBlock
                    Style="{StaticResource RowValue}"
                    Text="{Binding HotkeyText}"
                    Visibility="{Binding ShowsHotkey, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource RigShift.Brush.Accent}"
                    Style="{StaticResource RigShift.Text.Caption}"
                    Text="{loc:Tr Game_Running}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border Margin="10,6" Style="{StaticResource RigShift.Divider}" />
      <Button Command="{Binding SaveCurrentCommand}" Style="{StaticResource RigShift.TrayRow.Small}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
            Symbol="Add24" />
          <TextBlock Style="{StaticResource RowText}" Text="{loc:Tr Tray_SaveCurrent}" />
        </Grid>
      </Button>
      <Button Command="{Binding OpenCommand}" Style="{StaticResource RigShift.TrayRow.Small}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
            Symbol="Open24" />
          <TextBlock Style="{StaticResource RowText}" Text="{loc:Tr Tray_Open}" />
        </Grid>
      </Button>
      <Button Command="{Binding ExitCommand}" Style="{StaticResource RigShift.TrayRow.Small}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Foreground="{DynamicResource RigShift.Brush.TextSecondary}"
            Symbol="Power24" />
          <TextBlock Style="{StaticResource RowText}" Text="{loc:Tr Tray_Exit}" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</UserControl>

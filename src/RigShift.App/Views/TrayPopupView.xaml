<UserControl
  x:Class="RigShift.App.Views.TrayPopupView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:RigShift.App.Controls"
  xmlns:loc="clr-namespace:RigShift.App.Localization">
  <!-- Built like the Windows flyouts: the list starts at the top, rows are flat, the active row is marked by accent text and a check mark. -->
  <UserControl.Resources>
    <Style x:Key="TrayRowButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
  </UserControl.Resources>

  <Border
    Width="320"
    Padding="4,12,4,4"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8">
    <StackPanel>
      <ui:TextBlock Margin="12,0,12,4" FontTypography="BodyStrong" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="RigShift" />

      <TextBlock
        Margin="12,0,12,4"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{Binding StatusText}"
        TextWrapping="Wrap"
        Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibility}}" />

      <!-- Scrolls instead of growing past the screen with many profiles (analysis finding I-05); MaxHeight set in code. -->
      <ScrollViewer x:Name="ProfileList" Margin="0,4,0,0" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl Focusable="False" ItemsSource="{Binding Catalog.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Button
                AutomationProperties.Name="{Binding AccessibleName}"
                Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding DataContext.Coordinator.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ui:Button.Style>
                  <Style TargetType="ui:Button" BasedOn="{StaticResource TrayRowButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:Button.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <controls:ProfileIcon Width="20" Height="20" VerticalAlignment="Center" IconKey="{Binding IconKey}" IsFilled="{Binding IsActive}" />
                  <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                  <ui:SymbolIcon
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Symbol="Checkmark24"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </ui:Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock
        Margin="12,6,12,0"
        controls:LiveRegion.IsLive="True"
        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
        Text="{loc:Tr Tray_Switching}"
        Visibility="{Binding Coordinator.IsSwitching, Converter={StaticResource BoolToVisibility}}" />

      <Separator Margin="4,8" />
      <ui:Button Command="{Binding OpenCommand}" Content="{loc:Tr Tray_Open}" Icon="{ui:SymbolIcon Window24}" Style="{StaticResource TrayRowButton}" HorizontalContentAlignment="Left" />
      <ui:Button Command="{Binding SettingsCommand}" Content="{loc:Tr Tray_Settings}" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource TrayRowButton}" HorizontalContentAlignment="Left" />
      <ui:Button Command="{Binding ExitCommand}" Content="{loc:Tr Tray_Exit}" Icon="{ui:SymbolIcon Power24}" Style="{StaticResource TrayRowButton}" HorizontalContentAlignment="Left" />
    </StackPanel>
  </Border>
</UserControl>

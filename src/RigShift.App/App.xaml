<Application
  x:Class="RigShift.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Replaced at startup by the Windows theme (light, dark or high contrast). -->
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
        <!-- Brand tokens; BrandTheme swaps the Light dictionary for Dark or high contrast. -->
        <ResourceDictionary Source="/Assets/Brand/RigShift.Shared.xaml" />
        <ResourceDictionary Source="/Assets/Brand/RigShift.Light.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>

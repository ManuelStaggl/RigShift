<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF tray application: UI, DI host, CLI entry point, single-instance, Velopack updates. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>RigShift.App</RootNamespace>
    <AssemblyName>RigShift</AssemblyName>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>Assets\Brand\rigshift-app-light.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- Publish defaults (see docs/PLAN.md, section Verteilung). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigShift.Core\RigShift.Core.csproj" />
    <ProjectReference Include="..\RigShift.Windows\RigShift.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RigShift.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Brand package 1.0: only the assets the app uses (docs/PLAN.md, section 4.8). -->
    <Resource Include="Assets\Brand\*.ico;Assets\Brand\*.png" />
  </ItemGroup>

</Project>

<Page
  x:Class="RigShift.UI.Pages.GamesLibraryPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:tk="using:CommunityToolkit.WinUI.Controls"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- Prototype B "Library": games as large tiles on top, the selected one as a sheet below with sections that open in
       place, like the profiles page. Section contents are demo data; tiles, icon and header are live. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="32,24,32,32" Spacing="16">
      <Grid>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <Button HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="12" Glyph="&#xE710;" /><TextBlock Text="Add games" /></StackPanel></Button>
      </Grid>

      <GridView
        x:Name="Tiles"
        ItemsSource="{x:Bind Catalog.Items}"
        SelectionChanged="OnSelected"
        SelectionMode="Single">
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="vm:GameItem">
            <StackPanel Width="164" Height="132" Padding="12" Background="{ThemeResource BrandSurfaceBrush}" CornerRadius="{StaticResource CardRadius}" Spacing="8">
              <Grid Width="48" Height="48" HorizontalAlignment="Center">
                <Border Background="{ThemeResource BrandSurfaceAltBrush}" CornerRadius="{StaticResource BayRadius}" Visibility="{x:Bind s:Bindings.CollapsedIf(HasGameIcon), Mode=OneWay}">
                  <FontIcon FontSize="24" Glyph="{x:Bind s:ProfileGlyphs.ForGame(IconKey)}" />
                </Border>
                <Image Source="{x:Bind s:WinUiIcons.Image(GameIcon), Mode=OneWay}" Visibility="{x:Bind HasGameIcon, Mode=OneWay}" />
              </Grid>
              <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SourceText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <StackPanel Padding="24" Background="{ThemeResource BrandSurfaceBrush}" CornerRadius="{StaticResource CardRadius}" Spacing="16">
        <Grid ColumnSpacing="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="HeadIcon" Width="40" Height="40" />
          <FontIcon x:Name="HeadGlyph" FontSize="28" />
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="HeadName" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Ready · switches to Sim Rig · back to Desk afterwards" />
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontSize="12" Glyph="&#xE768;" /><TextBlock Text="{l:Tr Key=Game_Play}" /></StackPanel></Button>
          <Button Grid.Column="3" AutomationProperties.Name="More"><FontIcon FontSize="14" Glyph="&#xE712;" /></Button>
        </Grid>

        <StackPanel Spacing="4">
          <tk:SettingsCard Background="{ThemeResource BrandBackgroundBrush}" Description="Steam · AC2-Win64-Shipping" Header="Game">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></tk:SettingsCard.HeaderIcon>
            <Button Content="Choose…" />
          </tk:SettingsCard>
          <tk:SettingsCard Background="{ThemeResource BrandBackgroundBrush}" Description="Switches before the game starts" Header="Profile">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsCard.HeaderIcon>
            <ComboBox MinWidth="180" SelectedIndex="0"><x:String>Sim Rig</x:String></ComboBox>
          </tk:SettingsCard>
          <tk:SettingsExpander Background="{ThemeResource BrandBackgroundBrush}" Description="Fanatec App before · SimHub, Crew Chief V4 after" Header="Tools">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE71D;" /></tk:SettingsExpander.HeaderIcon>
          </tk:SettingsExpander>
          <tk:SettingsExpander Background="{ThemeResource BrandBackgroundBrush}" Description="3 windows remembered" Header="Windows">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE737;" /></tk:SettingsExpander.HeaderIcon>
          </tk:SettingsExpander>
          <tk:SettingsExpander Background="{ThemeResource BrandBackgroundBrush}" Description="Graphics for monitor and VR · settings.json" Header="Game settings">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;" /></tk:SettingsExpander.HeaderIcon>
          </tk:SettingsExpander>
          <tk:SettingsExpander Background="{ThemeResource BrandBackgroundBrush}" Description="With the game · close tools · back to Desk" Header="End">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></tk:SettingsExpander.HeaderIcon>
          </tk:SettingsExpander>
          <tk:SettingsExpander Background="{ThemeResource BrandBackgroundBrush}" Description="Ctrl+Alt+F5 · desktop shortcut · rigshift://play/…" Header="Triggers">
            <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE945;" /></tk:SettingsExpander.HeaderIcon>
          </tk:SettingsExpander>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

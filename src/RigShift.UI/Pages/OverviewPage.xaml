<Page
  x:Class="RigShift.UI.Pages.OverviewPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- The profiles are the positions of one switch, the active one lit; a click on another switches. Brand surfaces,
       borderless panels, the active profile on the selected surface with an accent edge. Games sit below as a launcher. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="32,24,32,32" Spacing="24">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Tr Key=Nav_Overview}" />

      <InfoBar
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error"
        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

      <StackPanel
        x:Name="EmptyState"
        Padding="24"
        Background="{ThemeResource BrandSurfaceBrush}"
        CornerRadius="{StaticResource CardRadius}"
        Spacing="12"
        Visibility="Collapsed">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Overview_SetupTitle}" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Tr Key=Overview_SetupText}" TextWrapping="Wrap" />
        <!-- shortcut: "Start setup" joins once the wizard is built (#95). -->
        <Button
          Command="{x:Bind ViewModel.SetupManuallyCommand}"
          Content="{l:Tr Key=Overview_SetupManual}"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog.Items}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                ItemsStretch="Fill"
                MaximumRowsOrColumns="4"
                MinColumnSpacing="12"
                MinItemWidth="260"
                MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItem">
                <Grid>
                  <Button
                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                    Background="{x:Bind s:Bindings.BrushIf(IsActive, 'BrandSelectedBrush', 'BrandSurfaceBrush'), Mode=OneWay}"
                    BorderThickness="0"
                    Click="OnSwitch"
                    Padding="20,18"
                    Style="{StaticResource TileButtonStyle}"
                    Tag="{x:Bind}">
                    <Grid RowSpacing="14">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="104" />
                      </Grid.RowDefinitions>
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                          VerticalAlignment="Top"
                          Data="{x:Bind s:ProfileGlyphs.Drawing(IconKey)}"
                          Stroke="{x:Bind s:Bindings.BrushIf(IsActive, 'AccentTextFillColorPrimaryBrush', 'TextFillColorSecondaryBrush'), Mode=OneWay}"
                          Style="{StaticResource ProfileSymbolStyle}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind IsActive, Mode=OneWay}"><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE73E;" /><Run Text=" " /><Run Text="{l:Tr Key=Profile_Active}" /></TextBlock>
                          <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ReadyText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ReadyTip, Mode=OneWay}"
                            Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
                          <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind HotkeyText}"
                            Visibility="{x:Bind ShowsHotkeyLine, Mode=OneWay}" />
                        </StackPanel>
                      </Grid>
                      <Border Grid.Row="1" Padding="12" Background="{ThemeResource BrandSurfaceAltBrush}" CornerRadius="{StaticResource BayRadius}">
                        <c:DisplayTopology Displays="{x:Bind Topology}" Size="Card" />
                      </Border>
                    </Grid>
                  </Button>
                  <!-- The accent edge marks the switch position that is on. -->
                  <Border
                    Width="4"
                    Margin="0,16"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="0,2,2,0"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsActive, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>

        <Grid x:Name="NowLine" Padding="4,0" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:DisplayTopology
            Width="56"
            Height="24"
            Displays="{x:Bind ViewModel.LiveTopology, Mode=OneWay}"
            Size="Tray" />
          <TextBlock
            x:Name="NowText"
            Grid.Column="1"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
          <HyperlinkButton Grid.Column="2" Command="{x:Bind ViewModel.IdentifyCommand}" Content="{l:Tr Key=Displays_Identify}" />
          <HyperlinkButton
            x:Name="ReapplyButton"
            Grid.Column="3"
            Click="OnReapply"
            Content="{l:Tr Key=Profile_Reapply}" />
        </Grid>
        <StackPanel x:Name="SwitchingLine" Spacing="6" Visibility="Collapsed">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock x:Name="SwitchingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
      </StackPanel>

      <!-- Games as wide tiles: the whole tile starts the game, Play sits on the right in the accent. -->
      <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
        <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games.Items}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                ItemsStretch="Fill"
                MinColumnSpacing="12"
                MinItemWidth="320"
                MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Button
                  AutomationProperties.Name="{x:Bind PlayText}"
                  Background="{ThemeResource BrandSurfaceBrush}"
                  BorderThickness="0"
                  Click="OnPlay"
                  IsEnabled="{x:Bind CanPlay, Mode=OneWay}"
                  Padding="16,14"
                  Style="{StaticResource TileButtonStyle}"
                  Tag="{x:Bind}">
                  <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44">
                      <Border Background="{ThemeResource BrandSurfaceAltBrush}" CornerRadius="{StaticResource BayRadius}" Visibility="{x:Bind s:Bindings.CollapsedIf(HasGameIcon), Mode=OneWay}">
                        <FontIcon FontSize="22" Glyph="{x:Bind s:ProfileGlyphs.ForGame(IconKey)}" />
                      </Border>
                      <Image Source="{x:Bind s:WinUiIcons.Image(GameIcon), Mode=OneWay}" Visibility="{x:Bind HasGameIcon, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SourceText}" />
                    </StackPanel>
                    <FontIcon
                      Grid.Column="2"
                      FontSize="16"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      Glyph="&#xE768;" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

<Page
  x:Class="RigShift.UI.Pages.OverviewPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- The profiles are the positions of one switch, the active one lit; a click on another switches. Games sit below
       as a launcher. Everything else about displays lives on its own pages. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="36,24,36,36" Spacing="24">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Tr Key=Nav_Overview}" />

      <InfoBar
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error" />

      <!-- No profile yet: one way in. -->
      <StackPanel
        x:Name="EmptyState"
        Padding="24"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Spacing="12"
        Visibility="Collapsed">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Overview_SetupTitle}" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Tr Key=Overview_SetupText}" TextWrapping="Wrap" />
        <!-- shortcut: "Start setup" joins once the wizard is built (#95). -->
        <Button
          Command="{x:Bind ViewModel.SetupManuallyCommand}"
          Content="{l:Tr Key=Overview_SetupManual}"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
        <!-- Nothing to start while a switch runs. -->
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog.Items}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                ItemsStretch="Fill"
                MaximumRowsOrColumns="4"
                MinColumnSpacing="8"
                MinItemWidth="240"
                MinRowSpacing="8" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItem">
                <Grid>
                  <Button
                    Padding="16,14"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                    Click="OnSwitch"
                    Tag="{x:Bind}">
                    <Grid RowSpacing="10">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="120" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <c:DisplayTopology Displays="{x:Bind Topology}" Size="Card" />
                      <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ReadyText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ReadyTip, Mode=OneWay}"
                            Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
                          <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind HotkeyText}"
                            Visibility="{x:Bind ShowsHotkeyLine, Mode=OneWay}" />
                        </StackPanel>
                        <Border
                          Grid.Column="1"
                          Padding="8,2"
                          VerticalAlignment="Top"
                          Background="{ThemeResource AccentFillColorDefaultBrush}"
                          CornerRadius="10"
                          Visibility="{x:Bind IsActive, Mode=OneWay}">
                          <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{l:Tr Key=Profile_Active}" />
                        </Border>
                      </Grid>
                    </Grid>
                  </Button>
                  <!-- The lit position of the switch. -->
                  <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsActive, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>

        <!-- Under the switch: what is on screen now, or the switch that is running. -->
        <Grid x:Name="NowLine" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:DisplayTopology
            Width="72"
            Height="28"
            Displays="{x:Bind ViewModel.LiveTopology, Mode=OneWay}"
            Size="Tray" />
          <TextBlock
            x:Name="NowText"
            Grid.Column="1"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
          <HyperlinkButton
            Grid.Column="2"
            Command="{x:Bind ViewModel.IdentifyCommand}"
            Content="{l:Tr Key=Displays_Identify}"
            ToolTipService.ToolTip="{l:Tr Key=Displays_IdentifyTip}" />
          <HyperlinkButton
            x:Name="ReapplyButton"
            Grid.Column="3"
            Click="OnReapply"
            Content="{l:Tr Key=Profile_Reapply}" />
        </Grid>
        <StackPanel x:Name="SwitchingLine" Spacing="6" Visibility="Collapsed">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock x:Name="SwitchingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
      </StackPanel>

      <!-- Games as a launcher: a click switches to the game's profile and starts it. -->
      <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <!-- Nothing to start while a switch runs. -->
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games.Items}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                ItemsStretch="Fill"
                MinColumnSpacing="12"
                MinItemHeight="150"
                MinItemWidth="170"
                MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Button
                  Padding="12"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                  Click="OnPlay"
                  IsEnabled="{x:Bind CanPlay, Mode=OneWay}"
                  Tag="{x:Bind}"
                  ToolTipService.ToolTip="{x:Bind PlayText}">
                  <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Grid
                      Width="56"
                      Height="56"
                      HorizontalAlignment="Center">
                      <!-- The game's own icon when there is one, else its chosen symbol or the generic game glyph. -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Visibility="{x:Bind s:Bindings.CollapsedIf(HasGameIcon), Mode=OneWay}">
                        <FontIcon FontSize="28" Glyph="{x:Bind s:ProfileGlyphs.ForGame(IconKey)}" />
                      </Border>
                      <Image Source="{x:Bind s:WinUiIcons.Image(GameIcon), Mode=OneWay}" Visibility="{x:Bind HasGameIcon, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                      HorizontalAlignment="Center"
                      Style="{StaticResource BodyStrongTextBlockStyle}"
                      Text="{x:Bind Name}"
                      TextAlignment="Center"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock
                      HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Style="{StaticResource CaptionTextBlockStyle}"
                      Text="{x:Bind SourceText}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

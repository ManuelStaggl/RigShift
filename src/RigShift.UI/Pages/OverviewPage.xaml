<Page
  x:Class="RigShift.UI.Pages.OverviewPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- Style 1 "Calm": Windows Settings rhythm on Mica, cards only for profiles and games, the brand blue only on the
       active profile. Structure: profile switch, current layout, games. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="32,24,32,32" Spacing="24">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Tr Key=Nav_Overview}" />

      <InfoBar
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error"
        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

      <StackPanel
        x:Name="EmptyState"
        Padding="24"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource CardRadius}"
        Spacing="12"
        Visibility="Collapsed">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Overview_SetupTitle}" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Tr Key=Overview_SetupText}" TextWrapping="Wrap" />
        <!-- shortcut: "Start setup" joins once the wizard is built (#95). -->
        <Button
          Command="{x:Bind ViewModel.SetupManuallyCommand}"
          Content="{l:Tr Key=Overview_SetupManual}"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
        <!-- Nothing to start while a switch runs. -->
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog.Items}">
            <ItemsRepeater.Layout>
              <UniformGridLayout
                ItemsStretch="Fill"
                MaximumRowsOrColumns="4"
                MinColumnSpacing="12"
                MinItemWidth="260"
                MinRowSpacing="12" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItem">
                <Grid>
                  <Button
                    AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                    Click="OnSwitch"
                    Style="{StaticResource TileButtonStyle}"
                    Tag="{x:Bind}">
                    <Grid RowSpacing="12">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="112" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="{x:Bind s:ProfileGlyphs.Drawing(IconKey)}" Style="{StaticResource ProfileSymbolStyle}" />
                        <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Style="{StaticResource BodyStrongTextBlockStyle}"
                          Text="{x:Bind Name}"
                          TextTrimming="CharacterEllipsis" />
                        <TextBlock
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Text="{x:Bind HotkeyText}" />
                      </Grid>
                      <!-- The displays sit in a recessed bay, like a screen in its bezel. -->
                      <Border Grid.Row="1" Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource BayRadius}">
                        <c:DisplayTopology Displays="{x:Bind Topology}" Size="Card" />
                      </Border>
                      <Grid Grid.Row="2" MinHeight="20">
                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind IsActive, Mode=OneWay}"><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE73E;" /><Run Text=" " /><Run Text="{l:Tr Key=Profile_Active}" /></TextBlock>
                        <TextBlock
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Text="{x:Bind ReadyText, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind ReadyTip, Mode=OneWay}"
                          Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
                      </Grid>
                    </Grid>
                  </Button>
                  <Border
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource CardRadius}"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind IsActive, Mode=OneWay}" />
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>

        <Grid x:Name="NowLine" Padding="4,0" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <c:DisplayTopology
            Width="56"
            Height="24"
            Displays="{x:Bind ViewModel.LiveTopology, Mode=OneWay}"
            Size="Tray" />
          <TextBlock
            x:Name="NowText"
            Grid.Column="1"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
          <HyperlinkButton
            Grid.Column="2"
            Command="{x:Bind ViewModel.IdentifyCommand}"
            Content="{l:Tr Key=Displays_Identify}"
            ToolTipService.ToolTip="{l:Tr Key=Displays_IdentifyTip}" />
          <HyperlinkButton
            x:Name="ReapplyButton"
            Grid.Column="3"
            Click="OnReapply"
            Content="{l:Tr Key=Profile_Reapply}" />
        </Grid>
        <StackPanel x:Name="SwitchingLine" Spacing="6" Visibility="Collapsed">
          <ProgressBar IsIndeterminate="True" />
          <TextBlock x:Name="SwitchingText" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </StackPanel>
      </StackPanel>

      <!-- Games as Settings-style rows: icon, name, where it starts and with which profile, one Play. -->
      <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
        <TextBlock Margin="0,8,0,4" Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games.Items}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="4" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Grid
                  Padding="16,12"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  ColumnSpacing="16"
                  CornerRadius="{StaticResource BayRadius}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="40" Height="40">
                    <FontIcon FontSize="22" Glyph="{x:Bind s:ProfileGlyphs.ForGame(IconKey)}" Visibility="{x:Bind s:Bindings.CollapsedIf(HasGameIcon), Mode=OneWay}" />
                    <Image Source="{x:Bind s:WinUiIcons.Image(GameIcon), Mode=OneWay}" Visibility="{x:Bind HasGameIcon, Mode=OneWay}" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SourceText}" />
                  </StackPanel>
                  <Button
                    Grid.Column="2"
                    MinWidth="96"
                    AutomationProperties.Name="{x:Bind PlayText}"
                    Click="OnPlay"
                    IsEnabled="{x:Bind CanPlay, Mode=OneWay}"
                    Tag="{x:Bind}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon FontSize="12" Glyph="&#xE768;" />
                      <TextBlock Text="{l:Tr Key=Game_Play}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

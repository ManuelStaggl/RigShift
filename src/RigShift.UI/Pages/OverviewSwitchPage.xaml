<Page
  x:Class="RigShift.UI.Pages.OverviewSwitchPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- Prototype B "Switch": the profiles are the positions of one big switch; games are a launcher grid. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="36,24,36,36" Spacing="28">
      <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{l:Tr Key=Nav_Overview}" />

      <!-- The switch: one segment per profile, the active one lit. A click on another segment switches. -->
      <StackPanel Spacing="10">
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog.Items}">
          <ItemsRepeater.Layout>
            <UniformGridLayout
              ItemsStretch="Fill"
              MaximumRowsOrColumns="4"
              MinColumnSpacing="8"
              MinItemWidth="220"
              MinRowSpacing="8" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItem">
              <Button
                Padding="16,14"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Click="OnSwitch"
                Tag="{x:Bind}">
                <Grid RowSpacing="10">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <c:DisplayTopology Displays="{x:Bind Topology}" Size="Card" />
                  <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ReadyText, Mode=OneWay}"
                        Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
                      <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind HotkeyText}"
                        Visibility="{x:Bind ShowsHotkeyLine, Mode=OneWay}" />
                    </StackPanel>
                    <Border
                      x:Name="ActiveBadge"
                      Grid.Column="1"
                      Padding="8,2"
                      VerticalAlignment="Top"
                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                      CornerRadius="10"
                      Visibility="{x:Bind IsActive, Mode=OneWay}">
                      <TextBlock Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{l:Tr Key=Profile_Active}" />
                    </Border>
                  </Grid>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!-- Under the switch: what is on screen, or the steps while a switch runs (#131). -->
        <Grid x:Name="IdleLine" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Name="ActiveSummary"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis" />
          <HyperlinkButton Grid.Column="1" Click="OnReapply" Content="{l:Tr Key=Profile_Reapply}" />
          <HyperlinkButton Grid.Column="2" Content="Identify" />
          <HyperlinkButton Grid.Column="3" Command="{x:Bind ViewModel.SaveCurrentCommand}" Content="{l:Tr Key=Overview_SaveCurrent}" />
        </Grid>
        <StackPanel x:Name="Steps" Spacing="8" Visibility="Collapsed">
          <ProgressBar IsIndeterminate="True" />
          <StackPanel Orientation="Horizontal" Spacing="20">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Switching to Sim Rig" />
            <TextBlock><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE73E;" /><Run Text="  Displays" /></TextBlock>
            <TextBlock><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE73E;" /><Run Text="  Audio" /></TextBlock>
            <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE916;" /><Run Text="  Apps: SimHub, Fanatec" /></TextBlock>
            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}"><Run FontFamily="{ThemeResource SymbolThemeFontFamily}" Text="&#xE823;" /><Run Text="  Desktop icons" /></TextBlock>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Games as a launcher: one click switches to the game's profile and starts it. -->
      <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games.Items}">
          <ItemsRepeater.Layout>
            <UniformGridLayout
              ItemsStretch="Fill"
              MinColumnSpacing="12"
              MinItemHeight="150"
              MinItemWidth="170"
              MinRowSpacing="12" />
          </ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:GameItem">
              <Button
                Padding="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind PlayText}"
                Click="OnPlay"
                Tag="{x:Bind}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <Border
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <FontIcon FontSize="28" Glyph="&#xE7FC;" />
                  </Border>
                  <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Name}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                  <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind SourceText}"
                    TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

<Page
  x:Class="RigShift.UI.Pages.OverviewInstrumentPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:vm="using:RigShift.App.ViewModels">

  <!-- Style 3 "Instrument": type and space instead of boxes. The active profile is the headline; the profiles are the
       segments of one switch bar; games are a plain list with dividers. -->
  <ScrollViewer>
    <StackPanel MaxWidth="1100" Padding="32,24,32,32" Spacing="28">
      <InfoBar
        IsClosable="False"
        IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Severity="Error"
        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

      <StackPanel x:Name="EmptyState" Spacing="12" Visibility="Collapsed">
        <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{l:Tr Key=Overview_SetupTitle}" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Tr Key=Overview_SetupText}" TextWrapping="Wrap" />
        <Button
          Command="{x:Bind ViewModel.SetupManuallyCommand}"
          Content="{l:Tr Key=Overview_SetupManual}"
          Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>

      <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.HasProfiles, Mode=OneWay}">
        <!-- Headline: what is on screen. -->
        <StackPanel Spacing="4">
          <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.ActiveName, Mode=OneWay}" />
          <Grid x:Name="NowLine" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="NowText"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton Grid.Column="1" Padding="4,2" Command="{x:Bind ViewModel.IdentifyCommand}" Content="{l:Tr Key=Displays_Identify}" />
            <HyperlinkButton
              x:Name="ReapplyButton"
              Grid.Column="2"
              Padding="4,2"
              Click="OnReapply"
              Content="{l:Tr Key=Profile_Reapply}" />
          </Grid>
          <StackPanel x:Name="SwitchingLine" Spacing="6" Visibility="Collapsed">
            <TextBlock x:Name="SwitchingText" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
        </StackPanel>

        <!-- The switch bar: one segment per profile inside one surface; the lit segment carries the accent rail. -->
        <Border
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource CardRadius}">
          <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Catalog.Items}">
              <ItemsRepeater.Layout>
                <UniformGridLayout
                  ItemsStretch="Fill"
                  MaximumRowsOrColumns="4"
                  MinItemWidth="240" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileItem">
                  <Grid>
                    <Button
                      AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="OnSwitch"
                      CornerRadius="{StaticResource CardRadius}"
                      Padding="20,18,20,22"
                      Style="{StaticResource TileButtonStyle}"
                      Tag="{x:Bind}">
                      <StackPanel Spacing="14">
                        <c:DisplayTopology Height="96" Displays="{x:Bind Topology}" Size="Card" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <Path
                            Data="{x:Bind s:ProfileGlyphs.Drawing(IconKey)}"
                            Stroke="{x:Bind s:Bindings.BrushIf(IsActive, 'AccentTextFillColorPrimaryBrush', 'TextFillColorSecondaryBrush'), Mode=OneWay}"
                            Style="{StaticResource ProfileSymbolStyle}" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{x:Bind s:Bindings.BrushIf(IsActive, 'AccentTextFillColorPrimaryBrush', 'TextFillColorPrimaryBrush'), Mode=OneWay}"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind HotkeyText}" />
                        </StackPanel>
                        <TextBlock
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Text="{x:Bind ReadyText, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
                      </StackPanel>
                    </Button>
                    <Border
                      Height="3"
                      Margin="20,0,20,8"
                      VerticalAlignment="Bottom"
                      Background="{ThemeResource AccentFillColorDefaultBrush}"
                      CornerRadius="2"
                      IsHitTestVisible="False"
                      Visibility="{x:Bind IsActive, Mode=OneWay}" />
                  </Grid>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ContentControl>
        </Border>
      </StackPanel>

      <!-- Games: a plain list with dividers, Play as a quiet link at the end of each line. -->
      <StackPanel Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
        <TextBlock Margin="0,0,0,8" Style="{StaticResource SubtitleTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}" IsTabStop="False">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Games.Items}">
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:GameItem">
                <Grid
                  Padding="4,12"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1"
                  ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Grid Width="32" Height="32">
                    <FontIcon FontSize="20" Glyph="{x:Bind s:ProfileGlyphs.ForGame(IconKey)}" Visibility="{x:Bind s:Bindings.CollapsedIf(HasGameIcon), Mode=OneWay}" />
                    <Image Source="{x:Bind s:WinUiIcons.Image(GameIcon), Mode=OneWay}" Visibility="{x:Bind HasGameIcon, Mode=OneWay}" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SourceText}" />
                  </StackPanel>
                  <HyperlinkButton
                    Grid.Column="2"
                    AutomationProperties.Name="{x:Bind PlayText}"
                    Click="OnPlay"
                    IsEnabled="{x:Bind CanPlay, Mode=OneWay}"
                    Tag="{x:Bind}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon FontSize="12" Glyph="&#xE768;" />
                      <TextBlock Text="{l:Tr Key=Game_Play}" />
                    </StackPanel>
                  </HyperlinkButton>
                </Grid>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

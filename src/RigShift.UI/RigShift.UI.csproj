<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 app that replaces RigShift.App: unpackaged and self-contained, so Velopack installs it like the WPF app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>RigShift.UI</RootNamespace>
    <AssemblyName>RigShift.UI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it dotnet publish leaves out RigShift.UI.pri, and the app dies at its first XAML resource. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main runs Velopack and the command line before any XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>..\RigShift.App\Assets\Brand\rigshift-app-light.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigShift.Core\RigShift.Core.csproj" />
    <ProjectReference Include="..\RigShift.Windows\RigShift.Windows.csproj" />
    <ProjectReference Include="..\RigShift.Presentation\RigShift.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not the Microsoft.WindowsAppSDK metapackage: its AI, ML and search parts (ONNX Runtime, DirectML) add 60 MB. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <!-- The UI-free core: H.NotifyIcon.WinUI would pull in the Windows App SDK metapackage 1.6. -->
    <PackageReference Include="H.NotifyIcon" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Title bar and taskbar icon; the brand package lives with the WPF app until the switch-over. -->
    <Content Include="..\RigShift.App\Assets\Brand\rigshift-app-light.ico" Link="Assets\rigshift.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\RigShift.App\Assets\Brand\rigshift-tray-*.ico" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Screenshot helpers stay out of release builds. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Page Remove="Debug\**" />
    <Compile Remove="Debug\**" />
  </ItemGroup>
</Project>

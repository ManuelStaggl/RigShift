<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 app that replaces RigShift.App: unpackaged and self-contained, so Velopack installs it like the WPF app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RootNamespace>RigShift.UI</RootNamespace>
    <AssemblyName>RigShift.UI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it dotnet publish leaves out RigShift.UI.pri, and the app dies at its first XAML resource. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Program.Main runs Velopack and the command line before any XAML. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>..\RigShift.App\Assets\Brand\rigshift-app-light.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigShift.Core\RigShift.Core.csproj" />
    <ProjectReference Include="..\RigShift.Windows\RigShift.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- shortcut: the WPF app's start-up services, shared as source until they move to a UI-free library (#86). -->
  <ItemGroup>
    <Compile Include="..\RigShift.App\Services\AppLogging.cs" Link="Shared\AppLogging.cs" />
    <Compile Include="..\RigShift.App\Services\AppPaths.cs" Link="Shared\AppPaths.cs" />
    <Compile Include="..\RigShift.App\Services\CommandLineClient.cs" Link="Shared\CommandLineClient.cs" />
    <Compile Include="..\RigShift.App\Services\CrashHandling.cs" Link="Shared\CrashHandling.cs" />
    <Compile Include="..\RigShift.App\Services\LogFileFormat.cs" Link="Shared\LogFileFormat.cs" />
    <Compile Include="..\RigShift.App\Services\PipeTrust.cs" Link="Shared\PipeTrust.cs" />
  </ItemGroup>

</Project>

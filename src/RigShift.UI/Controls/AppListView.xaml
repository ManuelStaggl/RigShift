<UserControl
  x:Class="RigShift.UI.Controls.AppListView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:s="using:RigShift.UI.Services"
  xmlns:vm="using:RigShift.App.ViewModels">
  <!-- The programs a profile or game starts and ends: one card each, in order, and the device they may wait for. -->
  <StackPanel Spacing="8">
    <ItemsRepeater ItemsSource="{x:Bind List.Items, Mode=OneWay}">
      <ItemsRepeater.Layout>
        <StackLayout Spacing="8" />
      </ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate>
        <DataTemplate x:DataType="vm:AppEditItem">
          <Grid
            Padding="16,12"
            Background="{ThemeResource BrandBackgroundBrush}"
            ColumnSpacing="12"
            CornerRadius="{StaticResource BayRadius}"
            RowSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Width="32" Height="32">
              <FontIcon FontSize="20" Glyph="&#xE7AC;" Visibility="{x:Bind s:Bindings.CollapsedIfSet(Icon), Mode=OneWay}" />
              <Image Source="{x:Bind s:WinUiIcons.Image(Icon), Mode=OneWay}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
              <TextBlock
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind PathNote, Mode=OneWay}"
                Visibility="{x:Bind HasPathNote, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
              <Button Click="OnBrowse" Content="{l:Tr Key=App_Change}" Tag="{x:Bind}" />
              <Button AutomationProperties.Name="{l:Tr Key=App_MoveUp}" Click="OnMoveUp" Tag="{x:Bind}" ToolTipService.ToolTip="{l:Tr Key=App_MoveUp}">
                <FontIcon FontSize="12" Glyph="&#xE70E;" />
              </Button>
              <Button AutomationProperties.Name="{l:Tr Key=App_MoveDown}" Click="OnMoveDown" Tag="{x:Bind}" ToolTipService.ToolTip="{l:Tr Key=App_MoveDown}">
                <FontIcon FontSize="12" Glyph="&#xE70D;" />
              </Button>
              <Button AutomationProperties.Name="{l:Tr Key=App_Remove}" Click="OnRemove" Tag="{x:Bind}" ToolTipService.ToolTip="{l:Tr Key=App_Remove}">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
              </Button>
            </StackPanel>

            <!-- What, when, how long to wait, with which options. -->
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ComboBox
                MinWidth="120"
                Header="{l:Tr Key=App_Action}"
                ItemsSource="{x:Bind KindChoices}"
                SelectedItem="{x:Bind SelectedKind, Mode=TwoWay}" />
              <ComboBox
                Grid.Column="1"
                MinWidth="150"
                Header="{l:Tr Key=App_When}"
                ItemsSource="{x:Bind WhenChoices}"
                SelectedItem="{x:Bind SelectedWhen, Mode=TwoWay}"
                Visibility="{x:Bind ShowWhen, Mode=OneWay}" />
              <StackPanel Grid.Column="2" Spacing="4" Visibility="{x:Bind IsStart, Mode=OneWay}">
                <NumberBox
                  Width="110"
                  Header="{l:Tr Key=App_WaitShort}"
                  Minimum="0"
                  SpinButtonPlacementMode="Compact"
                  ToolTipService.ToolTip="{l:Tr Key=App_Wait}"
                  Tag="{x:Bind}"
                  ValueChanged="OnWaitChanged"
                  Value="{x:Bind s:Bindings.Number(WaitSeconds), Mode=OneWay}" />
                <CheckBox Content="{l:Tr Key=App_WaitForWindow}" IsChecked="{x:Bind WaitForWindow, Mode=TwoWay}" ToolTipService.ToolTip="{l:Tr Key=App_WaitForWindowTip}" />
              </StackPanel>
              <TextBox
                Grid.Column="3"
                Header="{l:Tr Key=App_Arguments}"
                VerticalAlignment="Top"
                Text="{x:Bind Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{x:Bind IsStart, Mode=OneWay}" />
            </Grid>
          </Grid>
        </DataTemplate>
      </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>

    <TextBlock
      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
      Text="{x:Bind List.Problem, Mode=OneWay}"
      TextWrapping="Wrap"
      Visibility="{x:Bind List.HasProblem, Mode=OneWay}" />

    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button AutomationProperties.Name="{x:Bind List.AddText, Mode=OneWay}" Command="{x:Bind List.AddPickedCommand, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon FontSize="12" Glyph="&#xE710;" />
          <TextBlock Text="{x:Bind List.AddText, Mode=OneWay}" />
        </StackPanel>
      </Button>
      <ComboBox
        Grid.Column="1"
        MinWidth="240"
        HorizontalAlignment="Right"
        Header="{l:Tr Key=Editor_AppsWaitDevice}"
        ItemsSource="{x:Bind List.WaitDevice.Choices, Mode=OneWay}"
        SelectedItem="{x:Bind s:Bindings.Same(List.WaitDevice.Selected), Mode=TwoWay, BindBack=SetWaitDevice}"
        ToolTipService.ToolTip="{l:Tr Key=Editor_AppsWaitHint}" />
    </Grid>
  </StackPanel>
</UserControl>

<UserControl
  x:Class="RigShift.UI.Shell"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="using:RigShift.UI.Localization">

  <NavigationView
    x:Name="Navigation"
    IsBackButtonVisible="Collapsed"
    IsSettingsVisible="False"
    SelectionChanged="OnSelectionChanged">
    <!-- Pane and content sit on the window's brand surface: no separate pane colour, no content frame. -->
    <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    </NavigationView.Resources>
    <NavigationView.MenuItems>
      <NavigationViewItem Content="{l:Tr Key=Nav_Overview}" Tag="Overview">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE80F;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="{l:Tr Key=Nav_Profiles}" Tag="Profiles">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE7F4;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="{l:Tr Key=Nav_Games}" Tag="Games">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE7FC;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="{l:Tr Key=Nav_Fov}" Tag="FieldOfView">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE890;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <NavigationView.FooterMenuItems>
      <NavigationViewItem Content="{l:Tr Key=Nav_Settings}" Tag="Settings">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE713;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="{l:Tr Key=Nav_About}" Tag="Help">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE897;" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.FooterMenuItems>
    <Frame x:Name="ContentFrame" />
  </NavigationView>
</UserControl>

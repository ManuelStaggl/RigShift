<Window
  x:Class="RigShift.UI.Tray.TrayPopupWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:RigShift.UI.Controls"
  xmlns:l="using:RigShift.UI.Localization"
  xmlns:vm="using:RigShift.App.ViewModels"
  Title="RigShift">
  <Window.SystemBackdrop>
    <DesktopAcrylicBackdrop />
  </Window.SystemBackdrop>

  <StackPanel x:Name="Root" Padding="12" Spacing="8" KeyDown="OnKeyDown">
    <TextBlock
      Text="{x:Bind ViewModel.SwitchingText, Mode=OneWay}"
      TextWrapping="Wrap"
      Visibility="{x:Bind ViewModel.Coordinator.IsSwitching, Mode=OneWay}" />
    <TextBlock
      Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
      TextWrapping="Wrap"
      Visibility="{x:Bind ViewModel.HasStatusText, Mode=OneWay}" />

    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Tr Key=Nav_Profiles}" />
    <ListView
      x:Name="ProfileList"
      IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}"
      IsItemClickEnabled="True"
      ItemClick="OnProfileClick"
      ItemsSource="{x:Bind ViewModel.Catalog.Items}"
      SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:ProfileItem">
          <Grid Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
              FontSize="14"
              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
              Glyph="&#xE73E;"
              Visibility="{x:Bind IsActive, Mode=OneWay}" />
            <c:DisplayTopology
              Grid.Column="1"
              Width="56"
              Height="24"
              VerticalAlignment="Center"
              Displays="{x:Bind Topology}"
              Size="Tray" />
            <StackPanel Grid.Column="2">
              <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ReadyText, Mode=OneWay}"
                Visibility="{x:Bind ShowsReadiness, Mode=OneWay}" />
              <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind HotkeyText}"
                Visibility="{x:Bind ShowsHotkeyLine, Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Games.HasGames, Mode=OneWay}">
      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{l:Tr Key=Nav_Games}" />
      <ListView
        IsEnabled="{x:Bind ViewModel.Coordinator.IsIdle, Mode=OneWay}"
        IsItemClickEnabled="True"
        ItemClick="OnGameClick"
        ItemsSource="{x:Bind ViewModel.Games.Items}"
        SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:GameItem">
            <Grid Padding="0,6" AutomationProperties.Name="{x:Bind PlayText}" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon FontSize="14" Glyph="&#xE768;" />
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>

    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button
        HorizontalAlignment="Stretch"
        Command="{x:Bind ViewModel.OpenCommand}"
        Content="{l:Tr Key=Tray_Open}"
        Style="{StaticResource AccentButtonStyle}" />
      <ToggleButton
        Grid.Column="1"
        AutomationProperties.Name="{x:Bind ViewModel.PauseTip, Mode=OneWay}"
        Command="{x:Bind ViewModel.TogglePauseCommand}"
        IsChecked="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind ViewModel.PauseTip, Mode=OneWay}"
        Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}">
        <FontIcon FontSize="16" Glyph="&#xE769;" />
      </ToggleButton>
      <Button Grid.Column="2" AutomationProperties.Name="{l:Tr Key=Profile_More}">
        <FontIcon FontSize="16" Glyph="&#xE712;" />
        <Button.Flyout>
          <MenuFlyout Placement="TopEdgeAlignedRight">
            <MenuFlyoutItem Command="{x:Bind ViewModel.SaveCurrentCommand}" Text="{l:Tr Key=Tray_SaveCurrent}" />
            <MenuFlyoutItem Command="{x:Bind ViewModel.ExitCommand}" Text="{l:Tr Key=Tray_Exit}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>
  </StackPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure domain logic: profiles, topology planning, switch orchestration. No Win32, no UI. Fully unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RigShift.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game templates for the automation, one file per game so pull requests do not collide. -->
    <EmbeddedResource Include="..\..\templates\games\*.json" LogicalName="RigShift.Templates.Games.%(Filename).json" />
  </ItemGroup>

</Project>

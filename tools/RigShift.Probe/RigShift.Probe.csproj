<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual check tool for the Windows layer (M2): prints the live snapshot, audio devices and a dry legacy import.
       Read-only – it never calls SetDisplayConfig or changes a default device. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>RigShift.Probe</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RigShift.Windows\RigShift.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>

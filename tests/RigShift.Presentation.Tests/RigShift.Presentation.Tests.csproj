<Project Sdk="Microsoft.NET.Sdk">

  <!-- View models and app services (settings, coordinator, automation, pipe, diagnostics) without a UI framework. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>RigShift.App.Tests</RootNamespace>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RigShift.Presentation\RigShift.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The core fakes and fixtures, shared as source: they are internal to the core test assembly. -->
    <Compile Include="..\RigShift.Core.Tests\Fakes\*.cs" Link="Fakes\%(Filename)%(Extension)" />
    <Compile Include="..\RigShift.Core.Tests\TestDisplays.cs" Link="TestDisplays.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

</Project>

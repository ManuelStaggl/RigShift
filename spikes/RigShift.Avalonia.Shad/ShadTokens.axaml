<!-- ShadUI comparison: the same Rs* palette as the Semi spike, mapped onto ShadUI's Color keys. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="RsRailColor">#1F1E1D</Color>
      <Color x:Key="RsContentColor">#262624</Color>
      <Color x:Key="RsRaisedColor">#30302E</Color>
      <Color x:Key="RsDeepColor">#141413</Color>
      <Color x:Key="RsAccentColor">#D97757</Color>
      <SolidColorBrush x:Key="RsRail" Color="#1F1E1D" />
      <SolidColorBrush x:Key="RsContent" Color="#262624" />
      <SolidColorBrush x:Key="RsRaised" Color="#30302E" />
      <SolidColorBrush x:Key="RsRaisedHover" Color="#383835" />
      <SolidColorBrush x:Key="RsRaisedPressed" Color="#3E3D3A" />
      <SolidColorBrush x:Key="RsDeep" Color="#141413" />
      <SolidColorBrush x:Key="RsText" Color="#FAF9F5" />
      <SolidColorBrush x:Key="RsText2" Color="#C2C0B6" />
      <SolidColorBrush x:Key="RsText3" Color="#9C9A92" />
      <SolidColorBrush x:Key="RsDivider" Color="#26DEDCD1" />
      <SolidColorBrush x:Key="RsOutline" Color="#4DDEDCD1" />
      <SolidColorBrush x:Key="RsAccent" Color="#D97757" />
      <SolidColorBrush x:Key="RsAccentHover" Color="#C6613F" />
      <SolidColorBrush x:Key="RsAccentText" Color="#D97757" />
      <SolidColorBrush x:Key="RsAccentSoft" Color="#29D97757" />
      <SolidColorBrush x:Key="RsOnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RsSuccess" Color="#A8D166" />
      <SolidColorBrush x:Key="RsWarning" Color="#FAB319" />
      <SolidColorBrush x:Key="RsDanger" Color="#F4A9A9" />
      <SolidColorBrush x:Key="RsWarningSoft" Color="#24B87700" />
      <SolidColorBrush x:Key="RsDangerSoft" Color="#24E34A4A" />
      <SolidColorBrush x:Key="RsTileFill" Color="#3A3936" />
      <SolidColorBrush x:Key="RsTileStroke" Color="#6B6A64" />
      <SolidColorBrush x:Key="RsBay" Color="#1F1E1D" />
      <!-- ShadUI -->
      <Color x:Key="ForegroundColor">#FAF9F5</Color>
      <Color x:Key="ForegroundLeadColor">#C2C0B6</Color>
      <Color x:Key="MutedColor">#9C9A92</Color>
      <Color x:Key="BorderColor">#33DEDCD1</Color>
      <Color x:Key="BorderColor60">#26DEDCD1</Color>
      <Color x:Key="BorderColor30">#14DEDCD1</Color>
      <Color x:Key="OutlineColor">#4DDEDCD1</Color>
      <Color x:Key="GhostColor">#30302E</Color>
      <Color x:Key="GhostHoverColor">#383835</Color>
      <Color x:Key="GhostHoverColor50">#1A383835</Color>
      <Color x:Key="SelectionColor">#14FAF9F5</Color>
      <Color x:Key="PrimaryColor">#D97757</Color>
      <Color x:Key="PrimaryColor75">#BFD97757</Color>
      <Color x:Key="PrimaryColor50">#80D97757</Color>
      <Color x:Key="PrimaryColor10">#1AD97757</Color>
      <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
      <Color x:Key="SecondaryColor">#30302E</Color>
      <Color x:Key="SecondaryColor75">#BF30302E</Color>
      <Color x:Key="SecondaryColor50">#8030302E</Color>
      <Color x:Key="SecondaryForegroundColor">#FAF9F5</Color>
      <Color x:Key="DestructiveColor">#E34A4A</Color>
      <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
      <Color x:Key="SuccessColor">#639900</Color>
      <Color x:Key="WarningColor">#B87700</Color>
      <Color x:Key="ErrorColor">#E34A4A</Color>
      <Color x:Key="CardBackgroundColor">#1F1E1D</Color>
      <Color x:Key="DialogBackgroundColor">#262624</Color>
      <Color x:Key="TitleBarBackgroundColor">#262624</Color>
      <Color x:Key="WindowBackgroundColor">#262624</Color>
      <Color x:Key="SidebarBackgroundColor">#1F1E1D</Color>
      <Color x:Key="SwitchBackgroundColor">#30302E</Color>
      <Color x:Key="SwitchForegroundColor">#FAF9F5</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="RsRailColor">#F4F4F1</Color>
      <Color x:Key="RsContentColor">#F8F8F6</Color>
      <Color x:Key="RsRaisedColor">#FFFFFF</Color>
      <Color x:Key="RsDeepColor">#E6E5E0</Color>
      <Color x:Key="RsAccentColor">#C6613F</Color>
      <SolidColorBrush x:Key="RsRail" Color="#F4F4F1" />
      <SolidColorBrush x:Key="RsContent" Color="#F8F8F6" />
      <SolidColorBrush x:Key="RsRaised" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RsRaisedHover" Color="#EFEEEB" />
      <SolidColorBrush x:Key="RsRaisedPressed" Color="#E6E5E0" />
      <SolidColorBrush x:Key="RsDeep" Color="#E6E5E0" />
      <SolidColorBrush x:Key="RsText" Color="#121212" />
      <SolidColorBrush x:Key="RsText2" Color="#373734" />
      <SolidColorBrush x:Key="RsText3" Color="#7B7974" />
      <SolidColorBrush x:Key="RsDivider" Color="#1F1F1F1E" />
      <SolidColorBrush x:Key="RsOutline" Color="#401F1F1E" />
      <SolidColorBrush x:Key="RsAccent" Color="#C6613F" />
      <SolidColorBrush x:Key="RsAccentHover" Color="#B5573A" />
      <SolidColorBrush x:Key="RsAccentText" Color="#B5573A" />
      <SolidColorBrush x:Key="RsAccentSoft" Color="#1FC6613F" />
      <SolidColorBrush x:Key="RsOnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RsSuccess" Color="#4F7A00" />
      <SolidColorBrush x:Key="RsWarning" Color="#8F5C00" />
      <SolidColorBrush x:Key="RsDanger" Color="#C23434" />
      <SolidColorBrush x:Key="RsWarningSoft" Color="#1FB87700" />
      <SolidColorBrush x:Key="RsDangerSoft" Color="#1AE34A4A" />
      <SolidColorBrush x:Key="RsTileFill" Color="#E6E5E0" />
      <SolidColorBrush x:Key="RsTileStroke" Color="#A3A19A" />
      <SolidColorBrush x:Key="RsBay" Color="#EFEEEB" />
      <!-- ShadUI -->
      <Color x:Key="ForegroundColor">#121212</Color>
      <Color x:Key="ForegroundLeadColor">#373734</Color>
      <Color x:Key="MutedColor">#7B7974</Color>
      <Color x:Key="BorderColor">#261F1F1E</Color>
      <Color x:Key="BorderColor60">#1A1F1F1E</Color>
      <Color x:Key="BorderColor30">#0D1F1F1E</Color>
      <Color x:Key="OutlineColor">#4D1F1F1E</Color>
      <Color x:Key="GhostColor">#EFEEEB</Color>
      <Color x:Key="GhostHoverColor">#E6E5E0</Color>
      <Color x:Key="GhostHoverColor50">#80E6E5E0</Color>
      <Color x:Key="SelectionColor">#14121212</Color>
      <Color x:Key="PrimaryColor">#C6613F</Color>
      <Color x:Key="PrimaryColor75">#BFC6613F</Color>
      <Color x:Key="PrimaryColor50">#80C6613F</Color>
      <Color x:Key="PrimaryColor10">#1AC6613F</Color>
      <Color x:Key="PrimaryForegroundColor">#FFFFFF</Color>
      <Color x:Key="SecondaryColor">#EFEEEB</Color>
      <Color x:Key="SecondaryColor75">#BFEFEEEB</Color>
      <Color x:Key="SecondaryColor50">#80EFEEEB</Color>
      <Color x:Key="SecondaryForegroundColor">#121212</Color>
      <Color x:Key="DestructiveColor">#C23434</Color>
      <Color x:Key="DestructiveForegroundColor">#FFFFFF</Color>
      <Color x:Key="SuccessColor">#639900</Color>
      <Color x:Key="WarningColor">#B87700</Color>
      <Color x:Key="ErrorColor">#E34A4A</Color>
      <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
      <Color x:Key="DialogBackgroundColor">#FFFFFF</Color>
      <Color x:Key="TitleBarBackgroundColor">#F8F8F6</Color>
      <Color x:Key="WindowBackgroundColor">#F8F8F6</Color>
      <Color x:Key="SidebarBackgroundColor">#F4F4F1</Color>
      <Color x:Key="SwitchBackgroundColor">#E6E5E0</Color>
      <Color x:Key="SwitchForegroundColor">#FFFFFF</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="RsFont">avares://RigShift.Avalonia.Shad/Assets/Fonts#Mona Sans</FontFamily>
</ResourceDictionary>

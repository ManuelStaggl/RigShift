<Window
  x:Class="RigShift.Avalonia.ShadWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  xmlns:v="using:RigShift.Avalonia.Views"
  Title="RigShift (ShadUI)"
  Width="1280"
  Height="780"
  Background="{DynamicResource RsContent}"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaTitleBarHeightHint="40"
  FontFamily="{DynamicResource RsFont}"
  Foreground="{DynamicResource RsText}"
  WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <StyleInclude Source="avares://RigShift.Avalonia.Shad/ShadStyles.axaml" />
  </Window.Styles>
  <Grid>
    <v:ShadProfileSheetView />
    <Border Height="40" VerticalAlignment="Top" Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar" />
  </Grid>
</Window>

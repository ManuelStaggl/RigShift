<Window
  x:Class="RigShift.Avalonia.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:chrome="using:Avalonia.Controls.Chrome"
  xmlns:v="using:RigShift.Avalonia.Views"
  Title="RigShift"
  Width="1280"
  Height="780"
  MinWidth="900"
  MinHeight="560"
  Background="{DynamicResource RsContent}"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaTitleBarHeightHint="40"
  WindowStartupLocation="CenterScreen">
  <!-- Own title bar: the window content runs to the top edge, a 40 px strip is the drag area, the caption buttons are
       Avalonia 12's drawn decorations (Semi styles them). The rail runs the full height on the left. -->
  <Grid ColumnDefinitions="60,*" RowDefinitions="40,*">
    <Border Grid.RowSpan="2" Background="{DynamicResource RsRail}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Brand symbol in the title-bar height -->
        <Border Height="40" chrome:WindowDecorationProperties.ElementRole="TitleBar" DockPanel.Dock="Top">
          <Viewbox Width="26" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="240" Height="180">
              <Path
                Data="M76 60 L17 55 Q10 54 10 61 V124 Q10 130 17 129 L74 124 M153 63 L222 55 Q230 54 230 62 V124 Q230 130 222 129 L166 123 M47 127 V140 M32 143 L64 138 M191 127 V140 M176 138 L207 144"
                Stroke="{DynamicResource RsText}"
                StrokeJoin="Round"
                StrokeLineCap="Round"
                StrokeThickness="12" />
              <Path Data="M141 9 L177 40 L141 71 V52 C109 49 83 60 76 88 C67 68 75 44 97 32 C110 25 124 24 141 25 Z M89 62 H137 V72 H82 Z M41 116 C77 92 97 83 116 83 L88 114 Z M124 83 C145 84 167 95 199 116 L151 114 Z M119 88 H123 L125 95 H117 Z M116 99 H126 L129 109 H113 Z M111 114 H131 L135 130 H107 Z M105 122 V139 C133 142 145 135 148 122 C160 149 139 162 105 160 V174 L77 148 Z" Fill="{DynamicResource RsText}" />
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel x:Name="BottomRail" DockPanel.Dock="Bottom" Margin="0,0,0,8" />
        <StackPanel x:Name="TopRail" Margin="0,8,0,0" />
      </DockPanel>
    </Border>

    <ContentControl
      x:Name="Host"
      Grid.RowSpan="2"
      Grid.Column="1"
      HorizontalContentAlignment="Stretch"
      VerticalContentAlignment="Stretch" />

    <!-- Drag strip over the page's top edge; pages keep this band free of controls. -->
    <Border
      Grid.Column="1"
      Height="40"
      VerticalAlignment="Top"
      Background="Transparent"
      chrome:WindowDecorationProperties.ElementRole="TitleBar" />
  </Grid>
</Window>

<UserControl
  x:Class="RigShift.Avalonia.Views.ProfileSheetView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:u="https://irihi.tech/ursa"
  xmlns:v="using:RigShift.Avalonia.Views"
  xmlns:vm="using:RigShift.App.ViewModels"
  x:DataType="vm:ProfilesViewModel">
  <UserControl.Resources>
    <!-- Section hues: content colour for the group tiles (24 % fill), the same in both themes. -->
    <SolidColorBrush x:Key="HueAudio" Color="#4EA7FC" />
    <SolidColorBrush x:Key="HueAudioSoft" Color="#3D4EA7FC" />
    <SolidColorBrush x:Key="HueApps" Color="#3FB8AF" />
    <SolidColorBrush x:Key="HueAppsSoft" Color="#3D3FB8AF" />
    <SolidColorBrush x:Key="HueTriggers" Color="#F2A83B" />
    <SolidColorBrush x:Key="HueTriggersSoft" Color="#3DF2A83B" />
    <SolidColorBrush x:Key="HueBehavior" Color="#8A8F98" />
    <SolidColorBrush x:Key="HueBehaviorSoft" Color="#3D8A8F98" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Profiles list: the selected row is the accent pill, like the rail. -->
    <Style Selector="ListBox.profiles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="ListBox.profiles ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="ListBox.profiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RsHover}" />
    </Style>
    <Style Selector="ListBox.profiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.profiles ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RsRailOn}" />
      <Setter Property="BoxShadow" Value="{DynamicResource RsRailOnShadow}" />
    </Style>

    <!-- The name as a 32 px heading that turns into a field on hover and focus. -->
    <Style Selector="TextBox.title">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.7" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="-7,0,0,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Groups: Ursa SettingsCard rows inside one card, a hairline between them. -->
    <Style Selector="u|SettingsCard.group">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="u|SettingsCard.group /template/ ContentPresenter#PART_Content">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="u|SettingsCard.group /template/ Border#PART_Separator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="u|SettingsCard.group /template/ Border#PART_DetailHost">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="u|SettingsCard.group /template/ ContentPresenter#PART_Description">
      <Setter Property="Foreground" Value="{DynamicResource RsText3}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="TextBlock.TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.tile > Path.icon">
      <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- A settings row inside a group or the inspector. -->
    <Style Selector="Grid.row > TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource RsText2}" />
    </Style>
    <!-- Inspector key/value rows -->
    <Style Selector="Grid.kv">
      <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Grid.kv > TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource RsText3}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.kv TextBlock.val">
      <Setter Property="Foreground" Value="{DynamicResource RsText}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Action bar buttons: flat until hovered, label + keycap. -->
    <Style Selector="Button.ab">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0,6,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource RsText}" />
    </Style>
    <Style Selector="Button.ab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RsHover}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,42">
    <Grid ColumnDefinitions="248,*">
      <!-- ===== Profiles column ===== -->
      <Border Background="{DynamicResource RsColumn}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border Height="44" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
            <Grid Margin="16,0,8,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Classes="strong" FontSize="13" Text="{v:Tr Nav_Profiles}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="caption num" Text="{Binding Items.Count}" />
              <Button
                Grid.Column="2"
                AutomationProperties.Name="{v:Tr List_NewFromCurrent}"
                Classes="ghost"
                Command="{Binding NewFromCurrentCommand}"
                ToolTip.Tip="{v:Tr List_NewProfileTip}">
                <Path Classes="icon small" Data="{x:Static v:Icons.Plus}" />
              </Button>
            </Grid>
          </Border>
          <!-- The active profile, pinned under the list. -->
          <Border x:Name="ActiveCard" IsVisible="False" Padding="10,10,10,12" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom" x:DataType="vm:ProfileItem">
            <StackPanel Spacing="6">
              <TextBlock Margin="6,0" Classes="caption" FontSize="11.5" Foreground="{DynamicResource RsText4}" Text="Active profile" />
              <Border Padding="8" Background="{DynamicResource RsRaised}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="1" CornerRadius="7">
                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                  <v:DisplayTopology Height="24" Displays="{Binding Topology}" Size="Tray" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="strong" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" FontSize="11.5" Text="{Binding HotkeyText}" />
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource RsSuccess}" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>
          <ListBox Classes="profiles" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileItem">
                <Grid AutomationProperties.Name="{Binding AccessibleName}" ColumnDefinitions="44,*,Auto" ColumnSpacing="10">
                  <v:DisplayTopology Width="44" Height="22" Displays="{Binding Topology}" Size="Tray" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="strong" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" FontSize="11.5" Text="{Binding HotkeyText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Ellipse Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource RsSuccess}" IsVisible="{Binding IsActive}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ===== Detail + inspector ===== -->
      <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
        <DockPanel>
          <!-- Top bar: breadcrumb, more, the one primary action -->
          <Border Height="44" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
            <Grid Margin="20,0,12,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="secondary" FontSize="13" Text="{v:Tr Nav_Profiles}" />
                <Path Classes="icon small" Width="12" Height="12" Stroke="{DynamicResource RsText4}" Data="M9 6 L15 12 L9 18" />
                <TextBlock Classes="label" FontSize="13" Text="{Binding SelectedItem.Name, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button
                Grid.Column="1"
                AutomationProperties.Name="{v:Tr Profile_More}"
                Classes="ghost"
                IsVisible="{Binding HasSelection}"
                ToolTip.Tip="{v:Tr Profile_More}">
                <Path Classes="icon dots" Data="{x:Static v:Icons.More}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Command="{Binding DuplicateCommand}" Header="{v:Tr Profile_Duplicate}" />
                    <MenuItem Command="{Binding ToggleDefaultCommand}" Header="{v:Tr Profile_SetDefault}" ToggleType="CheckBox" IsChecked="{Binding IsSelectedDefault, Mode=OneWay}" />
                    <MenuItem Command="{Binding CreateShortcutCommand}" Header="{v:Tr Profile_ShortcutMenu}" />
                    <MenuItem Command="{Binding RestoreDesktopIconsCommand}" Header="{v:Tr Profile_RestoreIconsMenu}" />
                    <Separator />
                    <MenuItem Command="{Binding DeleteCommand}" Foreground="{DynamicResource RsDanger}" Header="{v:Tr Profile_Delete}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button
                Grid.Column="2"
                AutomationProperties.Name="{Binding SwitchLabel}"
                Height="28"
                Padding="10,0"
                Classes.neutral="{Binding !SwitchIsPrimary}"
                Classes.primary="{Binding SwitchIsPrimary}"
                Command="{Binding SwitchCommand}"
                IsVisible="{Binding HasSelection}"
                ToolTip.Tip="{v:Tr Detail_SwitchTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon small" Stroke="{Binding $parent[Button].Foreground}" Data="M4 8 H20 M16 4 L20 8 L16 12 M20 16 H4 M8 12 L4 16 L8 20" />
                  <TextBlock Text="{Binding SwitchLabel}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="760" Margin="32,24,32,120" HorizontalAlignment="Stretch" Spacing="20">

                <Border Classes="notice" IsVisible="{Binding HasStatusMessage}">
                  <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                </Border>

                <!-- No profile yet -->
                <StackPanel Spacing="12" IsVisible="{Binding IsEmpty}">
                  <TextBlock Classes="h2" Text="{v:Tr Profiles_EmptyTitle}" />
                  <TextBlock Classes="secondary" Text="{v:Tr Profiles_EmptyInvite}" TextWrapping="Wrap" />
                  <Button HorizontalAlignment="Left" Classes="primary" Command="{Binding NewFromCurrentCommand}" Content="{v:Tr Profiles_EmptySave}" />
                </StackPanel>

                <StackPanel Spacing="20" IsVisible="{Binding HasSelection}">
                  <!-- Title: symbol, name, status -->
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Button
                      x:Name="IconButton"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="{v:Tr Editor_Icon}"
                      Classes="ghost"
                      Padding="6"
                      ToolTip.Tip="{v:Tr Editor_Icon}">
                      <Path x:Name="IconPath" Width="26" Height="26" Classes="symbol" />
                      <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                      </Button.Flyout>
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBox
                        x:Name="NameBox"
                        AutomationProperties.Name="{v:Tr Editor_Name}"
                        Classes="title"
                        Text="{Binding Editor.Name, FallbackValue=''}"
                        ToolTip.Tip="{v:Tr Editor_NameTip}" />
                      <TextBlock Classes="caption danger" IsVisible="{Binding Editor.HasNameProblem, FallbackValue=False}" Text="{Binding Editor.NameProblem}" />
                      <TextBlock Classes="caption" FontSize="13" Text="{Binding HeadStatusText}" />
                    </StackPanel>
                  </Grid>

                  <!-- Messages about this profile -->
                  <Border Classes="notice" IsVisible="{Binding HasBlockedMessage}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock VerticalAlignment="Center" Text="{Binding BlockedMessage}" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="neutral" Command="{Binding MarkMissingOptionalCommand}" Content="{v:Tr Detail_MarkOptional}" IsVisible="{Binding CanMarkOptional}" />
                    </Grid>
                  </Border>
                  <Border Classes="notice" IsVisible="{Binding HasDetailMessage}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock VerticalAlignment="Center" Text="{Binding DetailMessage}" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="neutral" Command="{Binding ReloadCommand}" Content="{v:Tr Detail_Reload}" IsVisible="{Binding IsStale}" />
                    </Grid>
                  </Border>
                  <Border Classes="notice" IsVisible="{Binding Editor.HasWarning, FallbackValue=False}">
                    <TextBlock Text="{Binding Editor.WarningText}" TextWrapping="Wrap" />
                  </Border>
                  <Border Classes="notice danger" IsVisible="{Binding Editor.HasError, FallbackValue=False}">
                    <TextBlock Text="{Binding Editor.ErrorMessage}" TextWrapping="Wrap" />
                  </Border>

                  <!-- Arrangement well: the picture picks a display, its settings open in the inspector. -->
                  <Border Background="{DynamicResource RsBay}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="1" CornerRadius="10">
                    <Grid RowDefinitions="40,230,32">
                      <Grid Margin="14,0,8,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock VerticalAlignment="Center" Classes="caption" FontSize="13" Text="{v:Tr Editor_Displays}" />
                        <Button Grid.Column="1" VerticalAlignment="Center" Classes="link" FontSize="12.5" Margin="0,0,12,0" Command="{Binding OpenDisplaySettingsCommand}" Content="{v:Tr Displays_OpenSettings}" />
                        <Button Grid.Column="2" Classes="ghost" Padding="8,5" Foreground="{DynamicResource RsText}" AutomationProperties.Name="{v:Tr Editor_TakeCurrent}" Command="{Binding Editor.TakeCurrentCommand}" ToolTip.Tip="{v:Tr Editor_DisplaysHint}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon small" Data="M4 8 V4 H8 M16 4 H20 V8 M20 16 V20 H16 M8 20 H4 V16 M8 12 H16" />
                            <TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{v:Tr Editor_TakeCurrent}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                      <v:DisplayTopology Grid.Row="1" Margin="32,8" Displays="{Binding Editor.TopologyDisplays}" SelectedKey="{Binding Editor.SelectedDisplayKey}" Size="Full" />
                      <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="caption" Text="{v:Tr Displays_ClickHint}" />
                    </Grid>
                  </Border>
                  <TextBlock Classes="danger" IsVisible="{Binding Editor.HasDisplaysProblem, FallbackValue=False}" Text="{Binding Editor.DisplaysProblem}" TextWrapping="Wrap" />
                  <TextBlock Classes="secondary" IsVisible="{Binding Editor.ArrangementNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" Text="{Binding Editor.ArrangementNote}" TextWrapping="Wrap" />

                  <!-- Groups: the summary is the header, the settings open in place. -->
                  <Border Padding="4" Background="{DynamicResource RsCard}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="1" BoxShadow="{DynamicResource RsCardShadow}" CornerRadius="10">
                    <StackPanel>
              <u:SettingsCard x:Name="AudioCard" Classes="group" Content="{v:Tr Tab_Audio}">
                <u:SettingsCard.Icon>
                  <Border Classes="tile" Background="{StaticResource HueAudioSoft}"><Path Classes="icon small" Stroke="{StaticResource HueAudio}" Data="{x:Static v:Icons.Audio}" /></Border>
                </u:SettingsCard.Icon>
                <u:SettingsCard.Detail>
                  <StackPanel Margin="36,0,4,16">
                    <ItemsControl ItemsSource="{Binding Editor.AudioSlots, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AudioSlot">
                          <StackPanel>
                            <Grid Classes="row" ColumnDefinitions="*,300">
                              <TextBlock Classes="label" Text="{Binding Label}" />
                              <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Label}"
                                ItemsSource="{Binding Choices}"
                                SelectedItem="{Binding Selected, Converter={x:Static v:Converters.KeepOnNull}}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:AudioChoice">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                            <Grid Classes="row" ColumnDefinitions="*,Auto,180,48" ColumnSpacing="12" IsVisible="{Binding SupportsVolume}">
                              <CheckBox Content="{v:Tr Audio_SetVolume}" IsChecked="{Binding SetVolume}" />
                              <Slider Grid.Column="2" AutomationProperties.Name="{v:Tr Audio_SetVolume}" VerticalAlignment="Center" IsEnabled="{Binding SetVolume}" Maximum="100" Minimum="0" Value="{Binding Volume}" />
                              <TextBlock Grid.Column="3" Classes="label num" Text="{Binding VolumeText}" />
                            </Grid>
                            <Border Classes="divider" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Text="{v:Tr Editor_DisableDucking}" ToolTip.Tip="{v:Tr Editor_DisableDuckingHint}" />
                      <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Editor_DisableDucking}" IsChecked="{Binding Editor.DisableCommunicationsDucking, FallbackValue=False}" OffContent="" OnContent="" />
                    </Grid>
                  </StackPanel>
                </u:SettingsCard.Detail>
              </u:SettingsCard>

              <u:SettingsCard x:Name="AppsCard" Classes="group" Content="{v:Tr Tab_Apps}">
                <u:SettingsCard.Icon>
                  <Border Classes="tile" Background="{StaticResource HueAppsSoft}"><Path Classes="icon small" Stroke="{StaticResource HueApps}" Data="{x:Static v:Icons.Apps}" /></Border>
                </u:SettingsCard.Icon>
                <u:SettingsCard.Detail>
                  <StackPanel Margin="36,0,4,16" Spacing="0">
                    <ItemsControl ItemsSource="{Binding Editor.AppList.Items, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppEditItem">
                          <StackPanel>
                            <Grid Margin="0,12" ColumnDefinitions="28,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                              <Panel Width="24" Height="24" VerticalAlignment="Center">
                                <Path Classes="icon" Data="{x:Static v:Icons.Window}" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}" />
                                <Image Source="{Binding Icon, Converter={x:Static v:Converters.IconImage}}" />
                              </Panel>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="strong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                <TextBlock Classes="caption warning" IsVisible="{Binding HasPathNote}" Text="{Binding PathNote}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <Button Margin="0,0,8,0" VerticalAlignment="Center" Classes="link" Click="OnBrowse" Content="{v:Tr App_Change}" Tag="{Binding}" />
                                <Button AutomationProperties.Name="{v:Tr App_MoveUp}" Classes="ghost" Click="OnMoveUp" Tag="{Binding}" ToolTip.Tip="{v:Tr App_MoveUp}">
                                  <Path Classes="icon small" Data="{x:Static v:Icons.Up}" />
                                </Button>
                                <Button AutomationProperties.Name="{v:Tr App_MoveDown}" Classes="ghost" Click="OnMoveDown" Tag="{Binding}" ToolTip.Tip="{v:Tr App_MoveDown}">
                                  <Path Classes="icon small" Data="{x:Static v:Icons.Down}" />
                                </Button>
                                <Button AutomationProperties.Name="{v:Tr App_Remove}" Classes="ghost" Click="OnRemoveApp" Tag="{Binding}" ToolTip.Tip="{v:Tr App_Remove}">
                                  <Path Classes="icon small" Data="{x:Static v:Icons.Trash}" />
                                </Button>
                              </StackPanel>
                              <!-- What, how long to wait, with which options -->
                              <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                <ComboBox MinWidth="104" AutomationProperties.Name="{v:Tr App_Action}" ItemsSource="{Binding KindChoices}" SelectedItem="{Binding SelectedKind, Converter={x:Static v:Converters.KeepOnNull}}" ToolTip.Tip="{v:Tr App_Action}" />
                                <ComboBox Grid.Column="1" MinWidth="140" AutomationProperties.Name="{v:Tr App_When}" IsVisible="{Binding ShowWhen}" ItemsSource="{Binding WhenChoices}" SelectedItem="{Binding SelectedWhen, Converter={x:Static v:Converters.KeepOnNull}}" ToolTip.Tip="{v:Tr App_When}" />
                                <NumericUpDown
                                  Grid.Column="2"
                                  Width="112"
                                  AutomationProperties.Name="{v:Tr App_Wait}"
                                  FormatString="0.#"
                                  IsVisible="{Binding IsStart}"
                                  Minimum="0"
                                  ToolTip.Tip="{v:Tr App_Wait}"
                                  Value="{Binding WaitSeconds, Converter={x:Static v:Converters.Seconds}}"
                                  PlaceholderText="{v:Tr App_WaitShort}" />
                                <TextBox Grid.Column="3" AutomationProperties.Name="{v:Tr App_Arguments}" IsVisible="{Binding IsStart}" Text="{Binding Arguments}" PlaceholderText="{v:Tr App_Arguments}" />
                              </Grid>
                            </Grid>
                            <Border Classes="divider" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" Classes="danger" IsVisible="{Binding Editor.AppList.HasProblem, FallbackValue=False}" Text="{Binding Editor.AppList.Problem}" TextWrapping="Wrap" />
                    <Grid Classes="row" ColumnDefinitions="*,300" ColumnSpacing="12">
                      <TextBlock Classes="label" Text="{v:Tr Editor_AppsWaitDevice}" ToolTip.Tip="{v:Tr Editor_AppsWaitHint}" />
                      <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{v:Tr Editor_AppsWaitDevice}" 
                        ItemsSource="{Binding Editor.AppList.WaitDevice.Choices, FallbackValue={x:Null}}"
                        SelectedItem="{Binding Editor.AppList.WaitDevice.Selected, Converter={x:Static v:Converters.KeepOnNull}}" />
                    </Grid>
                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Classes="neutral" AutomationProperties.Name="{Binding Editor.AppList.AddText, FallbackValue=''}" Command="{Binding Editor.AppList.AddPickedCommand, FallbackValue={x:Null}}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon small" Data="{x:Static v:Icons.Plus}" />
                        <TextBlock Text="{Binding Editor.AppList.AddText, FallbackValue=''}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </u:SettingsCard.Detail>
              </u:SettingsCard>

              <u:SettingsCard x:Name="TriggersCard" Classes="group" Content="{v:Tr Tab_Triggers}">
                <u:SettingsCard.Icon>
                  <Border Classes="tile" Background="{StaticResource HueTriggersSoft}"><Path Classes="icon small" Stroke="{StaticResource HueTriggers}" Data="{x:Static v:Icons.Triggers}" /></Border>
                </u:SettingsCard.Icon>
                <u:SettingsCard.Detail>
                  <StackPanel Margin="36,0,4,16">
                    <Border Margin="0,0,0,8" Classes="notice" IsVisible="{Binding Editor.ShowAutostartOff, FallbackValue=False}">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock VerticalAlignment="Center" Text="{v:Tr Trigger_AutostartOff}" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Classes="neutral" Command="{Binding Editor.TurnOnAutostartCommand, FallbackValue={x:Null}}" Content="{v:Tr Trigger_AutostartTurnOn}" />
                      </Grid>
                    </Border>
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Trigger_UsbTitle}" />
                        <TextBlock Classes="caption" Text="{v:Tr Trigger_UsbCaption}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" VerticalAlignment="Center" Classes="neutral" AutomationProperties.Name="{v:Tr Trigger_AddRule}" Command="{Binding Editor.Rules.AddRuleCommand, FallbackValue={x:Null}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Path Classes="icon small" Data="{x:Static v:Icons.Plus}" />
                          <TextBlock Text="{v:Tr Trigger_AddRule}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Editor.Rules.Rules, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleCard">
                          <StackPanel Margin="16,0,0,8">
                            <Border Classes="divider" />
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                              <TextBlock Classes="label" Text="{Binding DevicesText}" TextTrimming="CharacterEllipsis" />
                              <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Automation_Delete}" Classes="ghost" Click="OnRemoveRule" Tag="{Binding}" ToolTip.Tip="{v:Tr Automation_Delete}">
                                <Path Classes="icon small" Data="{x:Static v:Icons.Trash}" />
                              </Button>
                            </Grid>
                            <Grid Classes="row" ColumnDefinitions="*,220">
                              <TextBlock Classes="label" Text="{v:Tr Automation_DeviceGone}" TextWrapping="Wrap" />
                              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Automation_DeviceGone}" ItemsSource="{Binding Owner.ExitChoices}" SelectedItem="{Binding SelectedExit, Converter={x:Static v:Converters.KeepOnNull}}" />
                            </Grid>
                            <Grid Classes="row" ColumnDefinitions="*,112">
                              <TextBlock Classes="label" Text="{v:Tr Automation_ExitDelay}" ToolTip.Tip="{v:Tr Automation_ExitDelayHint}" />
                              <NumericUpDown Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Automation_ExitDelay}" FormatString="0.#" Minimum="0" Value="{Binding ExitDelaySeconds, Converter={x:Static v:Converters.Seconds}}" />
                            </Grid>
                            <Grid Classes="row" ColumnDefinitions="*,Auto">
                              <TextBlock Classes="label" Text="{v:Tr Automation_SkipConfirmation}" ToolTip.Tip="{v:Tr Automation_SkipConfirmationHint}" />
                              <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Automation_SkipConfirmation}" IsChecked="{Binding SkipConfirmation}" OffContent="" OnContent="" />
                            </Grid>
                            <TextBlock Classes="warning" IsVisible="{Binding HasDuplicateDevice}" Text="{v:Tr Automation_DuplicateDevice}" TextWrapping="Wrap" />
                            <Border Classes="notice" IsVisible="{Binding HasPowerWarning}">
                              <TextBlock Text="{v:Tr Automation_PowerSavingText}" TextWrapping="Wrap" />
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Editor_Hotkey}" />
                        <TextBlock Classes="caption" Text="{Binding Editor.HotkeyHint, FallbackValue=''}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <!-- shortcut: shows the hotkey; recording keys (the WinUI HotkeyBox) is not ported in the spike. -->
                        <TextBox Width="200" AutomationProperties.Name="{v:Tr Editor_Hotkey}" IsReadOnly="True" Text="{Binding Editor.HotkeyText, FallbackValue=''}" PlaceholderText="{v:Tr Editor_HotkeyPlaceholder}" />
                        <Button AutomationProperties.Name="{v:Tr Editor_HotkeyClear}" Classes="ghost" Command="{Binding Editor.ClearHotkeyCommand, FallbackValue={x:Null}}" IsVisible="{Binding Editor.HasHotkey, FallbackValue=False}" ToolTip.Tip="{v:Tr Editor_HotkeyClear}">
                          <Path Classes="icon small" Data="{x:Static v:Icons.Close}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                    <TextBlock Classes="danger" IsVisible="{Binding Editor.HasHotkeyProblem, FallbackValue=False}" Text="{Binding Editor.HotkeyProblem}" TextWrapping="Wrap" />
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Trigger_Shortcut}" />
                        <TextBlock Classes="caption" Text="{v:Tr Trigger_ShortcutHint}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" VerticalAlignment="Center" Classes="neutral" Command="{Binding CreateShortcutCommand}" Content="{v:Tr Trigger_ShortcutCreate}" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Trigger_Command}" />
                        <TextBlock Classes="caption" Text="{v:Tr Trigger_CommandHint}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <TextBox Width="240" AutomationProperties.Name="{v:Tr Trigger_Command}" IsReadOnly="True" Text="{Binding Editor.CommandText, FallbackValue=''}" />
                        <Button AutomationProperties.Name="{v:Tr Trigger_Copy}" Classes="ghost" Command="{Binding CopyCommandCommand}" ToolTip.Tip="{v:Tr Trigger_Copy}">
                          <Path Classes="icon small" Data="{x:Static v:Icons.Copy}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </u:SettingsCard.Detail>
              </u:SettingsCard>

              <u:SettingsCard x:Name="BehaviorCard" Classes="group" Content="{v:Tr Tab_Behavior}">
                <u:SettingsCard.Icon>
                  <Border Classes="tile" Background="{StaticResource HueBehaviorSoft}"><Path Classes="icon small" Stroke="{StaticResource HueBehavior}" Data="{x:Static v:Icons.Behavior}" /></Border>
                </u:SettingsCard.Icon>
                <u:SettingsCard.Detail>
                  <StackPanel Margin="36,0,4,16">
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Editor_SwitchWithoutAsking}" />
                        <TextBlock Classes="caption" Text="{v:Tr Editor_SwitchWithoutAskingHint}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Editor_SwitchWithoutAsking}" IsChecked="{Binding Editor.SwitchWithoutAsking, FallbackValue=False}" IsEnabled="{Binding Editor.ConfirmationEnabled, FallbackValue=False}" OffContent="" OnContent="" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Editor_KeepAwake}" />
                        <TextBlock Classes="caption" Text="{v:Tr Editor_KeepAwakeHint}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Editor_KeepAwake}" IsChecked="{Binding Editor.KeepAwake, FallbackValue=False}" OffContent="" OnContent="" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Editor_RememberWindows}" />
                        <TextBlock Classes="caption" Text="{v:Tr Editor_RememberWindowsHint}" TextWrapping="Wrap" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Editor_RememberWindows}" IsChecked="{Binding Editor.RememberWindows, FallbackValue=False}" OffContent="" OnContent="" />
                    </Grid>
                    <Border Classes="divider" />
                    <Grid Classes="row" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Classes="label" Text="{v:Tr Editor_DesktopIcons}" />
                        <TextBlock Classes="caption" Text="{Binding Editor.DesktopIconsText, FallbackValue=''}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
                        <Button Classes="link" Command="{Binding Editor.ClearDesktopIconsCommand, FallbackValue={x:Null}}" Content="{v:Tr Editor_DesktopIconsClear}" IsVisible="{Binding Editor.HasDesktopIcons, FallbackValue=False}" />
                        <Button Classes="neutral" Command="{Binding Editor.CaptureDesktopIconsCommand, FallbackValue={x:Null}}" Content="{v:Tr Editor_DesktopIconsCapture}" />
                      </StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding Editor.Surround.IsVisible, FallbackValue=False}">
                      <Border Classes="divider" />
                      <Grid Classes="row" ColumnDefinitions="*,200" ColumnSpacing="16">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Classes="label" Text="{v:Tr Editor_Surround}" />
                          <TextBlock Classes="caption" Text="{Binding Editor.Surround.Hint, FallbackValue=''}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Editor_Surround}" ItemsSource="{Binding Editor.Surround.Choices, FallbackValue={x:Null}}" SelectedItem="{Binding Editor.Surround.Selected, Converter={x:Static v:Converters.KeepOnNull}}" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </u:SettingsCard.Detail>
              </u:SettingsCard>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- Unsaved changes: one floating bar, Save as the main action. -->
            <Border
              Margin="0,0,0,16"
              Padding="14,6,6,6"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Background="{DynamicResource RsPop}"
              BorderBrush="{DynamicResource RsDivider}"
              BorderThickness="1"
              BoxShadow="{DynamicResource RsPopShadow}"
              CornerRadius="10"
              IsVisible="{Binding Editor.IsDirty, FallbackValue=False}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Classes="label" FontSize="13" Text="{v:Tr List_Unsaved}" />
                <Button Classes="neutral" Command="{Binding DiscardCommand}" Content="{v:Tr Common_Discard}" />
                <Button Classes="primary" Command="{Binding SaveCommand}" Content="{v:Tr Common_Save}" />
              </StackPanel>
            </Border>
          </Grid>
        </DockPanel>

        <!-- ===== Inspector: the profile at a glance, or the chosen display ===== -->
        <Border
          Grid.Column="1"
          Width="284"
          Margin="0,12,12,12"
          Background="{DynamicResource RsCard}"
          BorderBrush="{DynamicResource RsDivider}"
          BorderThickness="1"
          BoxShadow="{DynamicResource RsCardShadow}"
          ClipToBounds="True"
          CornerRadius="14"
          IsVisible="{Binding HasSelection}">
          <DockPanel>
            <Border Height="44" Padding="16,0" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
              <!-- shortcut: spike-only English labels (Profile, Status, Active profile, Actions); resx keys come with the real port. -->
              <Panel VerticalAlignment="Center">
                <TextBlock Classes="strong" FontSize="13" Text="Profile" IsVisible="{Binding !Editor.HasSelectedDisplay, FallbackValue=True}" />
                <TextBlock Classes="strong" FontSize="13" Text="Display" IsVisible="{Binding Editor.HasSelectedDisplay, FallbackValue=False}" />
              </Panel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16,10,16,24">
                <!-- No display chosen: the profile in key/value rows -->
                <StackPanel IsVisible="{Binding !Editor.HasSelectedDisplay, FallbackValue=True}">
                  <Grid Classes="kv" ColumnDefinitions="100,*">
                    <TextBlock Classes="k" Text="Status" />
                    <TextBlock Grid.Column="1" Classes="val" Text="{Binding HeadStatusText}" />
                  </Grid>
                  <Border Classes="divider" />
                  <Grid Classes="kv" ColumnDefinitions="100,*">
                    <TextBlock Classes="k" Text="{v:Tr Tab_Displays}" />
                    <ItemsControl Grid.Column="1" Margin="0,8" ItemsSource="{Binding SelectedItem.DisplayLines, FallbackValue={x:Null}}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="val" Text="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                  <Border Classes="divider" />
                  <Grid Classes="kv" ColumnDefinitions="100,*">
                    <TextBlock Classes="k" Text="{v:Tr Tab_Apps}" />
                    <TextBlock Grid.Column="1" Classes="val" Text="{Binding SelectedItem.AppsLine, FallbackValue='–', TargetNullValue='–'}" />
                  </Grid>
                  <Border Classes="divider" />
                  <Grid Classes="kv" ColumnDefinitions="100,*">
                    <TextBlock Classes="k" Text="{v:Tr Editor_Hotkey}" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" Classes="kbd" IsVisible="{Binding SelectedItem.HasHotkey, FallbackValue=False}">
                      <TextBlock Classes="num" Text="{Binding SelectedItem.HotkeyText, FallbackValue=''}" />
                    </Border>
                  </Grid>
                  <Panel Margin="0,14,0,0">
                    <Rectangle RadiusX="8" RadiusY="8" Stroke="{DynamicResource RsOutline}" StrokeDashArray="4,3" StrokeThickness="1" />
                    <TextBlock Margin="12,10" Classes="caption" Text="{v:Tr Displays_NoneSelected}" TextWrapping="Wrap" />
                  </Panel>
                </StackPanel>

              <StackPanel IsVisible="{Binding Editor.HasSelectedDisplay, FallbackValue=False}">
                <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Classes="strong" Text="{Binding Editor.SelectedDisplay.ModelName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption num" Text="{Binding Editor.SelectedDisplay.ResolutionText}" />
                  </StackPanel>
                  <Button
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{v:Tr Editor_Remove}"
                    Classes="ghost"
                    Click="OnRemoveDisplay"
                    ToolTip.Tip="{v:Tr Editor_Remove}">
                    <Path Classes="icon small" Data="{x:Static v:Icons.Trash}" />
                  </Button>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,150">
                  <TextBlock Classes="label" Text="{v:Tr Editor_CustomName}" />
                  <TextBox Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="{v:Tr Editor_CustomName}" Text="{Binding Editor.SelectedDisplay.CustomName, FallbackValue=''}" PlaceholderText="{v:Tr Editor_CustomNamePlaceholder}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,150">
                  <TextBlock Classes="label" Text="{v:Tr Editor_RefreshRate}" />
                  <ComboBox
                    x:Name="RefreshBox"
                    AutomationProperties.Name="{v:Tr Editor_RefreshRate}"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Editor.SelectedDisplay.RefreshChoices}"
                    SelectedItem="{Binding Editor.SelectedDisplay.SelectedRefresh, Converter={x:Static v:Converters.KeepOnNull}}"
                    ToolTip.Tip="{v:Tr Editor_RefreshRateHint}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:RefreshChoice">
                        <TextBlock Classes="num" Text="{Binding Text}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,150">
                  <TextBlock Classes="label" Text="HDR" />
                  <ComboBox
                    x:Name="HdrBox"
                    AutomationProperties.Name="HDR"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Editor.SelectedDisplay.HdrChoices}"
                    SelectedItem="{Binding Editor.SelectedDisplay.SelectedHdr, Converter={x:Static v:Converters.KeepOnNull}}"
                    ToolTip.Tip="{v:Tr Editor_HdrHint}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:HdrChoice">
                        <TextBlock Text="{Binding Text}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{v:Tr Editor_Primary}" />
                  <ToggleSwitch Grid.Column="1" AutomationProperties.Name="{v:Tr Editor_Primary}" IsChecked="{Binding Editor.SelectedDisplay.IsPrimary, FallbackValue=False}" OffContent="" OnContent="" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" Text="{v:Tr Editor_Optional}" />
                  <ToggleSwitch
                    Grid.Column="1"
                    AutomationProperties.Name="{v:Tr Editor_Optional}"
                    IsChecked="{Binding Editor.SelectedDisplay.IsOptional, FallbackValue=False}"
                    IsEnabled="{Binding Editor.SelectedDisplay.CanBeOptional, FallbackValue=False}"
                    OffContent=""
                    OnContent="" />
                </Grid>
                <TextBlock
                  Margin="0,8,0,0"
                  Classes="caption"
                  IsVisible="{Binding Editor.SelectedDisplay.RatesUnknown, FallbackValue=False}"
                  Text="{v:Tr Editor_RefreshRatesUnknown}"
                  TextWrapping="Wrap" />
              </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ===== Action bar: what is selected, its main action, the palette ===== -->
    <Border Grid.Row="1" Padding="12,0,6,0" Background="{DynamicResource RsColumn}" BorderBrush="{DynamicResource RsDivider}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelection}">
          <Border Classes="tile" Width="24" Height="24" Background="{DynamicResource RsAccentDuo}">
            <Path x:Name="BarIcon" Classes="icon small" Stroke="{DynamicResource RsAccentText}" />
          </Border>
          <TextBlock VerticalAlignment="Center" Classes="strong" FontSize="13" Text="{Binding SelectedItem.Name, FallbackValue=''}" />
          <TextBlock VerticalAlignment="Center" Classes="caption" FontSize="13" Text="{Binding SelectedItem.StatusText, FallbackValue=''}" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Classes="ab" AutomationProperties.Name="{Binding SwitchLabel}" Command="{Binding SwitchCommand}" IsVisible="{Binding HasSelection}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="{Binding SwitchLabel}" />
            <Border Classes="kbd"><TextBlock Text="↵" /></Border>
          </StackPanel>
        </Button>
        <Border Grid.Column="2" Width="1" Height="16" Background="{DynamicResource RsOutline}" />
        <Button Grid.Column="3" VerticalAlignment="Center" Classes="ab" AutomationProperties.Name="Actions (Ctrl+K)" Click="OnActions">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock VerticalAlignment="Center" FontWeight="Regular" Foreground="{DynamicResource RsText3}" Text="Actions" />
            <StackPanel Orientation="Horizontal" Spacing="3">
              <Border Classes="kbd"><TextBlock Text="Ctrl" /></Border>
              <Border Classes="kbd"><TextBlock Text="K" /></Border>
            </StackPanel>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike for #155: Avalonia 12 + Semi/Ursa on the shared view models. Not part of RigShift.slnx. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Published like the WPF and WinUI apps, so size and start compare. -->
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <RootNamespace>RigShift.Avalonia</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Irihi.Ursa" Version="2.3.0" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Program icons for the game rows, like the WinUI app. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RigShift.Core\RigShift.Core.csproj" />
    <ProjectReference Include="..\..\src\RigShift.Windows\RigShift.Windows.csproj" />
    <ProjectReference Include="..\..\src\RigShift.Presentation\RigShift.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="..\..\src\RigShift.App\Assets\Brand\rigshift-tray-dark.ico" Link="Assets\tray.ico" />
  </ItemGroup>

</Project>
